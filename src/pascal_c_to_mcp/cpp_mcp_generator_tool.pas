(*
  * =============================================================================
  * cpp_mcp_generator_tool - C++ MCP tool provider code & doc generator
  * =============================================================================
  *
  * Produces three files from one TPascal_Func_Model:
  *
  *   1. <unit>_tool_provider.hpp   -> GenerateHPPCode
  *   2. <unit>_tool_provider.cpp   -> GenerateCPPCode
  *   3. <unit>_tool_provider_cpp.md -> GenerateCPPReadme
  *
  * Filtering rules (shared by all three generators):
  *   1. Unsupported declarations are dropped (see IsDeclSupported).
  *   2. Duplicate tool names are dropped: MCP tool names must be unique,
  *      because both the LingoFuse beacon and the MCP protocol key on the
  *      tool name alone. Overloaded Pascal routines therefore collapse to
  *      the first declaration; the rest are skipped and logged.
  *
  * All comments and status output are in English.
  * =============================================================================
*)

unit cpp_mcp_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

{$IFDEF FPC}
  {$CODEPAGE UTF8}
{$ENDIF FPC}

interface

uses
  Z.Core,
  Z.PascalStrings, Z.UPascalStrings,
  Z.Status,
  Z.Json,
  Z.UnicodeMixedLib,
  Z.ListEngine,
  Z.Pascal_Func_Model,
  Z.Parsing;

{* Generate the C++ header (.hpp). Caller owns the returned list. *}
function GenerateHPPCode(Model: TPascal_Func_Model): TPascalStringList;

{* Generate the C++ implementation (.cpp). Caller owns the returned list. *}
function GenerateCPPCode(Model: TPascal_Func_Model): TPascalStringList;

{* Generate the English Markdown README (.md). Caller owns the returned list. *}
function GenerateCPPReadme(Model: TPascal_Func_Model): TPascalStringList;

var
  GenerateCode_LogEnabled: boolean = False;

implementation

// -----------------------------------------------------------------------------
// Constants
// -----------------------------------------------------------------------------

const
  DEFAULT_APP_DESC = 'Tool provider generated by cpp_mcp_generator_tool';
  DEFAULT_IPC_ENDPOINT = 'ipc:agent';
  DEFAULT_BEACON_APP = 'agent_main_app';
  DEFAULT_REGISTER_API = 'register_agent';
  DEFAULT_AGENT_LOG_API = 'agent_log';
  MAX_DESC_LEN = 200;

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------

type
  TValidFuncArray = array of TFunctionStructure;

// -----------------------------------------------------------------------------
// Logging
// -----------------------------------------------------------------------------

procedure Log(const Msg: TP_String);
begin
  if GenerateCode_LogEnabled then
    DoStatus('[cpp_mcp_generator_tool] ' + Msg);
end;

procedure LogFmt(const Fmt: TP_String; const Args: array of const);
begin
  if GenerateCode_LogEnabled then
    DoStatus('[cpp_mcp_generator_tool] ' + PFormat(Fmt, Args));
end;

// -----------------------------------------------------------------------------
// Type helpers
// -----------------------------------------------------------------------------

function IsSupportedType(const Typ: TP_String): boolean;
begin
  Result := Typ.Same('int64', 'double', 'string');
end;

function PascalTypeToCPPType(const Typ: TP_String; const AsReturn: boolean): TP_String;
begin
  if Typ.Same('int64') then
    Result := 'std::int64_t'
  else if Typ.Same('double') then
    Result := 'double'
  else if Typ.Same('string') then
  begin
    if AsReturn then
      Result := 'std::string'
    else
      Result := 'const std::string&';
  end
  else
    Result := 'void';
end;

function PascalTypeToDefaultValue(const Typ: TP_String): TP_String;
begin
  if Typ.Same('int64') then Result := '0'
  else if Typ.Same('double') then Result := '0.0'
  else if Typ.Same('string') then Result := 'std::string()'
  else Result := '0';
end;

function PascalTypeToJsonSchemaType(const Typ: TP_String): TP_String;
begin
  if Typ.Same('int64') then Result := 'integer'
  else if Typ.Same('double') then Result := 'number'
  else if Typ.Same('string') then Result := 'string'
  else Result := 'string';
end;

function PascalTypeToJsonLiteral(const Typ: TP_String): TP_String;
begin
  if Typ.Same('int64') then Result := '0'
  else if Typ.Same('double') then Result := '0.0'
  else if Typ.Same('string') then Result := '""'
  else Result := 'null';
end;

// -----------------------------------------------------------------------------
// Name helpers
// -----------------------------------------------------------------------------

function MakeApiName(const FuncName: TP_String): TP_String;
var
  i: integer;
  c: TP_Char;
begin
  Result := '';
  for i := 1 to FuncName.Len do
  begin
    c := FuncName[i];
    if ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z')) or
       ((c >= '0') and (c <= '9')) or (c = '_') then
      Result := Result + c
    else
      Result := Result + '_';
  end;
  if Result.Len = 0 then
    Result := 'unnamed';
end;

function MakeCallbackName(const ApiName: TP_String): TP_String;
begin
  Result := 'callback_' + MakeApiName(ApiName);
end;

function MakeInternalCallName(const ApiName: TP_String): TP_String;
begin
  Result := 'internal_call_' + MakeApiName(ApiName);
end;

function MakeIncludeGuardName(const UnitName: TP_String): TP_String;
var
  i: integer;
  c: TP_Char;
begin
  Result := '';
  for i := 1 to UnitName.Len do
  begin
    c := UnitName[i];
    if (c >= 'a') and (c <= 'z') then
      Result := Result + TP_Char(Chr(Ord(c) - 32))
    else if (c >= 'A') and (c <= 'Z') then
      Result := Result + c
    else if (c >= '0') and (c <= '9') then
      Result := Result + c
    else
      Result := Result + '_';
  end;
  if Result.Len = 0 then
    Result := 'TOOL_PROVIDER';
  Result := Result + '_HPP';
end;

function MakeSourceFileName(const UnitName: TP_String): TP_String;
begin
  Result := MakeApiName(UnitName).LowerText + '_tool_provider';
end;

function MakeAppNameFromUnit(const UnitName: TP_String): TP_String;
var
  tmp: TP_String;
begin
  tmp := UnitName;
  if umlMultipleMatch('*.pas', tmp) then
    tmp := umlChangeFileExt(tmp.Text, '').Text;
  Result := tmp.ReplaceChar('.', '_').ReplaceChar('-', '_');
end;

// -----------------------------------------------------------------------------
// String literal escaping for C++
// -----------------------------------------------------------------------------

function CPPStrLit(const S: TP_String): TP_String;
var
  i: integer;
  c: TP_Char;
begin
  Result := '"';
  for i := 1 to S.Len do
  begin
    c := S[i];
    if c = '"' then
      Result := Result + '\"'
    else if c = '\' then
      Result := Result + '\\'
    else if c = #10 then
      Result := Result + '\n'
    else if c = #13 then
      Result := Result + '\r'
    else if c = #9 then
      Result := Result + '\t'
    else
      Result := Result + c;
  end;
  Result := Result + '"';
end;

// -----------------------------------------------------------------------------
// Comment normalisation
// -----------------------------------------------------------------------------

function CleanComment_Local(const Cmt: TP_String): TP_String;
var
  Parser: TTextParsing;
  i: integer;
  Token: PTokenData;
  Parts: TP_ArrayString;
  Part: TP_String;
begin
  Result := '';
  if Cmt = '' then Exit;

  Parser := TTextParsing.Create(Cmt, tsPascal);
  try
    SetLength(Parts, 0);
    for i := 0 to Parser.TokenCount - 1 do
    begin
      Token := Parser.Tokens[i];
      if Token^.tokenType = ttComment then
      begin
        Part := TTextParsing.Translate_Pascal_Decl_Comment_To_Text(Token^.Text);
        Part := Part.TrimChar(#32#9#13#10);
        if Part <> '' then
        begin
          SetLength(Parts, Length(Parts) + 1);
          Parts[High(Parts)] := Part;
        end;
      end;
    end;

    Result := '';
    for i := 0 to High(Parts) do
    begin
      if i > 0 then Result := Result + #10;
      Result := Result + Parts[i];
    end;
  finally
    Parser.Free;
  end;
end;

function GetFullDescription(const Comment: TP_String): TP_String;
var
  Cleaned: TP_String;
  Lines: TPascalStringList;
  i: integer;
  S: TP_String;
begin
  Result := '';
  if Comment = '' then Exit;

  Cleaned := CleanComment_Local(Comment);
  if Cleaned = '' then Exit;

  Lines := TPascalStringList.Create;
  try
    umlSeparatorText(Cleaned, Lines, #10);
    for i := 0 to Lines.Count - 1 do
    begin
      S := TP_String(Lines[i]);
      while (S.Len > 0) and ((S.Last = #13) or (S.Last = #10)) do
        S.DeleteLast;
      S := S.TrimChar(#32#9);
      if S.Len = 0 then Continue;
      if S[1] = '@' then Continue;
      if Result.Len > 0 then
        Result := Result + ' ';
      Result := Result + S;
    end;
  finally
    Lines.Free;
  end;

  if Result.Len > MAX_DESC_LEN then
    Result := Result.GetString(1, MAX_DESC_LEN + 1);
end;

function GetTableCellText(const Comment: TP_String): TP_String;
begin
  Result := GetFullDescription(Comment);
  Result := Result.ReplaceChar('|', '/');
  Result := Result.ReplaceChar(#13#10, ' ');
  Result := Result.TrimChar(#32#9);
  if Result.Len = 0 then
    Result := '(no description)';
end;

// -----------------------------------------------------------------------------
// Filtering
// -----------------------------------------------------------------------------

function IsDeclSupported(const F: TFunctionStructure): boolean;
var
  j: integer;
begin
  Result := False;
  if F.Name.Len = 0 then Exit;
  for j := 0 to High(F.Params) do
  begin
    if F.Params[j].Name.Len = 0 then Exit;
    if not IsSupportedType(F.Params[j].PascalType) then Exit;
  end;
  if F.IsFunction then
    if not IsSupportedType(F.ReturnType) then Exit;
  Result := True;
end;

function CollectValidFunctions(Model: TPascal_Func_Model): TValidFuncArray;
var
  i, Idx: integer;
  F: TFunctionStructure;
  SeenNames: TPascalStringList;
begin
  SetLength(Result, 0);
  if (Model = nil) or (Model.FuncCount <= 0) then Exit;

  SetLength(Result, Model.FuncCount);
  Idx := 0;

  SeenNames := TPascalStringList.Create;
  try
    for i := 0 to Model.FuncCount - 1 do
    begin
      F := Model.Funcs[i];

      if not IsDeclSupported(F) then
      begin
        LogFmt('  Skipped "%s": unsupported declaration', [F.Name.Text]);
        Continue;
      end;

      if SeenNames.ExistsValue(F.Name.Text) >= 0 then
      begin
        LogFmt('  Skipped "%s": duplicate tool name (MCP requires unique names)',
          [F.Name.Text]);
        Continue;
      end;

      SeenNames.Add(F.Name.Text);
      Result[Idx] := F;
      Inc(Idx);
    end;
  finally
    SeenNames.Free;
  end;

  SetLength(Result, Idx);
end;

// =============================================================================
// SECTION 1 - HPP generator
// =============================================================================

function GenerateHPPCode(Model: TPascal_Func_Model): TPascalStringList;
var
  L: TPascalStringList;
  i, j: integer;
  F: TFunctionStructure;
  ValidFuncs: TValidFuncArray;
  guard: TP_String;
  params_str: TP_String;
  ret_type: TP_String;
  desc: TP_String;
  tmp: TP_String;
begin
  Result := TPascalStringList.Create;
  L := Result;

  guard := MakeIncludeGuardName(Model.UnitName);

  LogFmt('GenerateHPPCode: unit="%s" raw=%d',
    [Model.UnitName.Text, Model.FuncCount]);

  ValidFuncs := CollectValidFunctions(Model);
  LogFmt('GenerateHPPCode: %d valid functions after filtering',
    [Length(ValidFuncs)]);

  L.Add('// Auto-generated by cpp_mcp_generator_tool');
  L.Add('// Source unit: ' + Model.UnitName.Text);
  L.Add('// Do not edit this file manually.');
  L.Add('');
  L.Add('#ifndef ' + guard);
  L.Add('#define ' + guard);
  L.Add('');
  L.Add('#include "LingoFuse.h"');
  L.Add('');
  L.Add('#include <cstdint>');
  L.Add('#include <string>');
  L.Add('');
  L.Add('// ==================== Application metadata ====================');
  L.Add('');
  L.Add('extern const char* MY_APP_NAME;');
  L.Add('extern const char* MY_APP_DESC;');
  L.Add('extern const char* IPC_ENDPOINT;');
  L.Add('extern const char* BEACON_APP;');
  L.Add('extern const char* REGISTER_API;');
  L.Add('extern const char* AGENT_LOG_API;');
  L.Add('extern const bool  DEBUG_LOG;');
  L.Add('');
  L.Add('// ==================== Internal call declarations ====================');
  L.Add('// These functions must be implemented by the user.');
  L.Add('');

  for i := 0 to High(ValidFuncs) do
  begin
    F := ValidFuncs[i];

    desc := GetFullDescription(F.Comment);
    if desc.Len > 0 then
      L.Add('// ' + desc.Text);

    tmp := '';
    for j := 0 to High(F.Params) do
    begin
      if j > 0 then tmp := tmp + ', ';
      tmp := tmp + PascalTypeToCPPType(F.Params[j].PascalType, False) +
        ' ' + F.Params[j].Name.Text;
    end;
    params_str := tmp;

    if F.IsFunction then
      ret_type := PascalTypeToCPPType(F.ReturnType, True)
    else
      ret_type := 'void';

    L.Add(ret_type + ' ' + MakeInternalCallName(F.Name) + '(' + params_str + ');');
    L.Add('');
    LogFmt('  HPP: emitted "%s"', [F.Name.Text]);
  end;

  L.Add('// ==================== Registration entry points ====================');
  L.Add('');
  L.Add('TAppHnd RegisterAPIs();');
  L.Add('bool    RegisterTools();');
  L.Add('bool    Execute_And_Reg_all();');
  L.Add('');
  L.Add('#endif // ' + guard);

  LogFmt('GenerateHPPCode: done, %d lines', [L.Count]);
end;

// =============================================================================
// SECTION 2 - CPP generator
// =============================================================================

function BuildCPPParamDecl(const F: TFunctionStructure): TP_String;
var
  j: integer;
begin
  Result := '';
  for j := 0 to High(F.Params) do
  begin
    if j > 0 then Result := Result + ', ';
    Result := Result + PascalTypeToCPPType(F.Params[j].PascalType, False) +
      ' ' + F.Params[j].Name.Text;
  end;
end;

function BuildCPPArgList(const F: TFunctionStructure): TP_String;
var
  j: integer;
begin
  Result := '';
  for j := 0 to High(F.Params) do
  begin
    if j > 0 then Result := Result + ', ';
    Result := Result + F.Params[j].Name.Text;
  end;
end;

procedure EmitHelpers(L: TPascalStringList);
begin
  L.Add('// ==================== Helper functions ====================');
  L.Add('');
  L.Add('static std::string read_string(TDataHnd hnd)');
  L.Add('{');
  L.Add('    const std::int64_t pos  = LF_GetPos(hnd);');
  L.Add('    const std::int64_t size = LF_GetSize(hnd);');
  L.Add('    if (pos < 0 || pos >= size)');
  L.Add('        return std::string();');
  L.Add('    const auto* base =');
  L.Add('        static_cast<const std::uint8_t*>(LF_GetBuffer(hnd));');
  L.Add('    if (base == nullptr)');
  L.Add('        return std::string();');
  L.Add('    std::int64_t end = pos;');
  L.Add('    while (end < size && base[end] != 0)');
  L.Add('        ++end;');
  L.Add('    std::string result(');
  L.Add('        reinterpret_cast<const char*>(base + pos),');
  L.Add('        static_cast<std::size_t>(end - pos));');
  L.Add('    LF_SetPos(hnd, end + 1);');
  L.Add('    return result;');
  L.Add('}');
  L.Add('');
  L.Add('static void write_string(TDataHnd hnd, const std::string& s)');
  L.Add('{');
  L.Add('    if (!s.empty())');
  L.Add('        LF_WriteBuffer(hnd, s.data(),');
  L.Add('                       static_cast<std::int64_t>(s.size()));');
  L.Add('    const char nul = 0;');
  L.Add('    LF_WriteBuffer(hnd, &nul, 1);');
  L.Add('}');
  L.Add('');
  L.Add('static json read_json(TDataHnd hnd)');
  L.Add('{');
  L.Add('    const std::string s = read_string(hnd);');
  L.Add('    if (s.empty())');
  L.Add('        return json();');
  L.Add('    try');
  L.Add('    {');
  L.Add('        return json::parse(s);');
  L.Add('    }');
  L.Add('    catch (...)');
  L.Add('    {');
  L.Add('        return json();');
  L.Add('    }');
  L.Add('}');
  L.Add('');
  L.Add('static void write_json(TDataHnd hnd, const json& obj)');
  L.Add('{');
  L.Add('    write_string(hnd, obj.dump(-1, ' + #39 + ' ' + #39 + ', false,');
  L.Add('                             json::error_handler_t::replace));');
  L.Add('}');
  L.Add('');
  L.Add('static void send_log_async(const std::string& msg)');
  L.Add('{');
  L.Add('    if (!DEBUG_LOG)');
  L.Add('        return;');
  L.Add('    TDataHnd req = LF_CreateData(AGENT_LOG_API);');
  L.Add('    if (req == nullptr)');
  L.Add('        return;');
  L.Add('    try');
  L.Add('    {');
  L.Add('        json payload;');
  L.Add('        payload["message"] = msg;');
  L.Add('        write_json(req, payload);');
  L.Add('        TDataHnd resp = LF_Call(BEACON_APP, req, 5000);');
  L.Add('        if (resp != nullptr)');
  L.Add('            LF_FreeData(resp);');
  L.Add('    }');
  L.Add('    catch (...) {}');
  L.Add('    LF_FreeData(req);');
  L.Add('}');
  L.Add('');
end;

procedure EmitInternalCalls(L: TPascalStringList; const ValidFuncs: TValidFuncArray);
var
  i: integer;
  F: TFunctionStructure;
  params_decl: TP_String;
  ret_type: TP_String;
  default_val: TP_String;
begin
  L.Add('// ==================== Internal call implementations (TODO) ====================');
  L.Add('//');
  L.Add('// Replace each placeholder body with the actual implementation.');
  L.Add('// The generated callbacks below will invoke these functions.');
  L.Add('');

  for i := 0 to High(ValidFuncs) do
  begin
    F := ValidFuncs[i];

    params_decl := BuildCPPParamDecl(F);

    if F.IsFunction then
    begin
      ret_type := PascalTypeToCPPType(F.ReturnType, True);
      default_val := PascalTypeToDefaultValue(F.ReturnType);
    end
    else
    begin
      ret_type := 'void';
      default_val := '';
    end;

    L.Add(ret_type + ' ' + MakeInternalCallName(F.Name) + '(' + params_decl + ')');
    L.Add('{');
    L.Add('    // TODO: replace this placeholder with the actual implementation.');
    if F.IsFunction then
      L.Add('    return ' + default_val.Text + ';');
    L.Add('}');
    L.Add('');
  end;
end;

procedure EmitCallbacks(L: TPascalStringList; const ValidFuncs: TValidFuncArray);
var
  i, j: integer;
  F: TFunctionStructure;
  json_key: TP_String;
  args_str: TP_String;
begin
  L.Add('// ==================== Callbacks (cdecl) ====================');
  L.Add('');

  for i := 0 to High(ValidFuncs) do
  begin
    F := ValidFuncs[i];

    L.Add('static void LF_CDECL ' + MakeCallbackName(F.Name) + '(void* _Trigger, void* _In, void* _Out)');
    L.Add('{');
    L.Add('    (void)_Trigger;');
    L.Add('    TDataHnd in_hnd  = static_cast<TDataHnd>(_In);');
    L.Add('    TDataHnd out_hnd = static_cast<TDataHnd>(_Out);');
    L.Add('');
    L.Add('    try');
    L.Add('    {');
    L.Add('        json req = read_json(in_hnd);');
    L.Add('        if (!req.is_object())');
    L.Add('            req = json::object();');
    L.Add('');

    for j := 0 to High(F.Params) do
    begin
      json_key := F.Params[j].Name.Text;
      if F.Params[j].PascalType.Same('int64') then
        L.Add('        std::int64_t ' + F.Params[j].Name.Text + ' = req.value(' + CPPStrLit(json_key) + ', static_cast<std::int64_t>(0));')
      else if F.Params[j].PascalType.Same('double') then
        L.Add('        double ' + F.Params[j].Name.Text + ' = req.value(' + CPPStrLit(json_key) + ', 0.0);')
      else if F.Params[j].PascalType.Same('string') then
        L.Add('        std::string ' + F.Params[j].Name.Text + ' = req.value(' + CPPStrLit(json_key) + ', std::string());');
    end;

    args_str := BuildCPPArgList(F);

    L.Add('');
    if F.IsFunction then
    begin
      L.Add('        auto ret = ' + MakeInternalCallName(F.Name) + '(' + args_str + ');');
      L.Add('');
      L.Add('        json resp;');
      L.Add('        resp["result"] = ret;');
      L.Add('        write_json(out_hnd, resp);');
    end
    else
    begin
      L.Add('        ' + MakeInternalCallName(F.Name) + '(' + args_str + ');');
      L.Add('');
      L.Add('        json resp;');
      L.Add('        resp["status"] = "ok";');
      L.Add('        write_json(out_hnd, resp);');
    end;

    L.Add('    }');
    L.Add('    catch (const std::exception& e)');
    L.Add('    {');
    L.Add('        try');
    L.Add('        {');
    L.Add('            json err;');
    L.Add('            err["error"] = std::string(e.what());');
    L.Add('            write_json(out_hnd, err);');
    L.Add('        }');
    L.Add('        catch (...) {}');
    L.Add('    }');
    L.Add('    catch (...)');
    L.Add('    {');
    L.Add('        try');
    L.Add('        {');
    L.Add('            json err;');
    L.Add('            err["error"] = std::string("unknown exception");');
    L.Add('            write_json(out_hnd, err);');
    L.Add('        }');
    L.Add('        catch (...) {}');
    L.Add('    }');
    L.Add('}');
    L.Add('');
  end;
end;

procedure EmitRegistration(L: TPascalStringList; const ValidFuncs: TValidFuncArray);
var
  i, j: integer;
  F: TFunctionStructure;
  desc: TP_String;
  param_desc: TP_String;
  ValidCount: integer;
begin
  ValidCount := Length(ValidFuncs);

  L.Add('// ==================== Registration ====================');
  L.Add('');
  L.Add('TAppHnd RegisterAPIs()');
  L.Add('{');
  L.Add('    TAppHnd app = LF_CreateApp(MY_APP_NAME, MY_APP_DESC);');
  L.Add('    if (app == nullptr)');
  L.Add('    {');
  L.Add('        send_log_async("Failed to create App.");');
  L.Add('        return nullptr;');
  L.Add('    }');
  L.Add('');

  for i := 0 to High(ValidFuncs) do
  begin
    F := ValidFuncs[i];
    desc := GetFullDescription(F.Comment);

    L.Add('    if (LF_RegisterCall(app,');
    L.Add('                       ' + CPPStrLit(F.Name) + ',');
    L.Add('                       ' + CPPStrLit(desc) + ',');
    L.Add('                       nullptr,');
    L.Add('                       &' + MakeCallbackName(F.Name) + ') != 1)');
    L.Add('    {');
    L.Add('        send_log_async(std::string("Failed to register API: ") + ' + CPPStrLit(F.Name) + ');');
    L.Add('        LF_FreeApp(app);');
    L.Add('        return nullptr;');
    L.Add('    }');
    L.Add('');
  end;

  L.Add('    return app;');
  L.Add('}');
  L.Add('');

  L.Add('static bool RegisterOneTool(const char* name,');
  L.Add('                            const char* description,');
  L.Add('                            const json& parameters_schema)');
  L.Add('{');
  L.Add('    TDataHnd req = LF_CreateData(REGISTER_API);');
  L.Add('    if (req == nullptr)');
  L.Add('        return false;');
  L.Add('');
  L.Add('    bool ok = false;');
  L.Add('    try');
  L.Add('    {');
  L.Add('        json payload;');
  L.Add('        payload["name"]        = std::string(name);');
  L.Add('        payload["description"] = std::string(description);');
  L.Add('        payload["target_app"]  = std::string(MY_APP_NAME);');
  L.Add('        payload["target_api"]  = std::string(name);');
  L.Add('        payload["parameters"]  = parameters_schema;');
  L.Add('        write_json(req, payload);');
  L.Add('');
  L.Add('        TDataHnd resp = LF_Call(BEACON_APP, req, 5000);');
  L.Add('        if (resp != nullptr)');
  L.Add('        {');
  L.Add('            try');
  L.Add('            {');
  L.Add('                json r = read_json(resp);');
  L.Add('                ok = (r.value("status", std::string()) == "ok");');
  L.Add('            }');
  L.Add('            catch (...) { ok = false; }');
  L.Add('            LF_FreeData(resp);');
  L.Add('        }');
  L.Add('    }');
  L.Add('    catch (...) { ok = false; }');
  L.Add('    LF_FreeData(req);');
  L.Add('    return ok;');
  L.Add('}');
  L.Add('');

  L.Add('bool RegisterTools()');
  L.Add('{');
  L.Add('    int registered = 0;');
  L.Add('');

  for i := 0 to High(ValidFuncs) do
  begin
    F := ValidFuncs[i];
    desc := GetFullDescription(F.Comment);

    L.Add('    {');
    L.Add('        json parameters_schema;');
    L.Add('        parameters_schema["type"] = "object";');
    L.Add('        json props    = json::object();');
    L.Add('        json required = json::array();');
    L.Add('');

    for j := 0 to High(F.Params) do
    begin
      param_desc := GetFullDescription(F.Params[j].Description);
      L.Add('        {');
      L.Add('            json p;');
      L.Add('            p["type"] = ' + CPPStrLit(PascalTypeToJsonSchemaType(F.Params[j].PascalType)) + ';');
      if param_desc.Len > 0 then
        L.Add('            p["description"] = ' + CPPStrLit(param_desc) + ';');
      L.Add('            props[' + CPPStrLit(F.Params[j].Name) + '] = p;');
      L.Add('            required.push_back(' + CPPStrLit(F.Params[j].Name) + ');');
      L.Add('        }');
    end;

    L.Add('');
    L.Add('        parameters_schema["properties"] = props;');
    L.Add('        parameters_schema["required"]   = required;');
    L.Add('');
    L.Add('        if (RegisterOneTool(' + CPPStrLit(F.Name) + ',');
    L.Add('                           ' + CPPStrLit(desc) + ',');
    L.Add('                           parameters_schema))');
    L.Add('        {');
    L.Add('            ++registered;');
    L.Add('        }');
    L.Add('    }');
    L.Add('');
  end;

  L.Add('    if (DEBUG_LOG)');
  L.Add('    {');
  L.Add('        send_log_async("RegisterTools: " +');
  L.Add('                       std::to_string(registered) + "/' + umlIntToStr(ValidCount) + ' tools registered.");');
  L.Add('    }');
  L.Add('    return registered > 0;');
  L.Add('}');
  L.Add('');

  L.Add('bool Execute_And_Reg_all()');
  L.Add('{');
  L.Add('    TAppHnd app = RegisterAPIs();');
  L.Add('    if (app == nullptr)');
  L.Add('        return false;');
  L.Add('');
  L.Add('    LF_ResetPrepare();');
  L.Add('    if (LF_PrepareClient(IPC_ENDPOINT, app) == -1)');
  L.Add('    {');
  L.Add('        send_log_async("LF_PrepareClient failed.");');
  L.Add('        LF_FreeApp(app);');
  L.Add('        return false;');
  L.Add('    }');
  L.Add('');
  L.Add('    if (LF_PrepareDone() <= 0)');
  L.Add('    {');
  L.Add('        send_log_async("LF_PrepareDone failed.");');
  L.Add('        LF_FreeApp(app);');
  L.Add('        return false;');
  L.Add('    }');
  L.Add('');
  L.Add('    return RegisterTools();');
  L.Add('}');
  L.Add('');
end;

function GenerateCPPCode(Model: TPascal_Func_Model): TPascalStringList;
var
  L: TPascalStringList;
  ValidFuncs: TValidFuncArray;
  hpp_name: TP_String;
begin
  Result := TPascalStringList.Create;
  L := Result;

  hpp_name := MakeSourceFileName(Model.UnitName) + '.hpp';

  LogFmt('GenerateCPPCode: unit="%s" raw=%d hpp="%s"',
    [Model.UnitName.Text, Model.FuncCount, hpp_name.Text]);

  ValidFuncs := CollectValidFunctions(Model);
  LogFmt('GenerateCPPCode: %d valid functions after filtering',
    [Length(ValidFuncs)]);

  L.Add('// Auto-generated by cpp_mcp_generator_tool');
  L.Add('// Source unit: ' + Model.UnitName.Text);
  L.Add('');
  L.Add('#include "' + hpp_name + '"');
  L.Add('');
  L.Add('#include <cstdint>');
  L.Add('#include <string>');
  L.Add('#include <exception>');
  L.Add('');
  L.Add('#include "json.hpp"');
  L.Add('');
  L.Add('using json = nlohmann::json;');
  L.Add('');

  L.Add('// ==================== Application metadata ====================');
  L.Add('');
  L.Add('extern const char* MY_APP_NAME   = ' + CPPStrLit(Model.UnitName) + ';');
  L.Add('extern const char* MY_APP_DESC   = ' + CPPStrLit(DEFAULT_APP_DESC) + ';');
  L.Add('extern const char* IPC_ENDPOINT  = ' + CPPStrLit(DEFAULT_IPC_ENDPOINT) + ';');
  L.Add('extern const char* BEACON_APP    = ' + CPPStrLit(DEFAULT_BEACON_APP) + ';');
  L.Add('extern const char* REGISTER_API  = ' + CPPStrLit(DEFAULT_REGISTER_API) + ';');
  L.Add('extern const char* AGENT_LOG_API = ' + CPPStrLit(DEFAULT_AGENT_LOG_API) + ';');
  L.Add('extern const bool  DEBUG_LOG     = false;');
  L.Add('');

  EmitHelpers(L);
  EmitInternalCalls(L, ValidFuncs);
  EmitCallbacks(L, ValidFuncs);
  EmitRegistration(L, ValidFuncs);

  LogFmt('GenerateCPPCode: done, %d lines', [L.Count]);
end;

