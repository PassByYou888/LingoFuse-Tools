    L.Add('');
    L.Add('---');
    L.Add('');
  end;

  procedure EmitOverview;
  begin
    L.Add('## 1. Overview');
    L.Add('');
    L.Add('This README explains how to build, integrate, and test the');
    L.Add('auto-generated C++ tool provider: `' + hpp_name + '` plus');
    L.Add('`' + cpp_name + '`.');
    L.Add('');
    L.Add('The provider registers every top-level function of `' + UnitName + '`');
    L.Add('as a LingoFuse Call API and advertises each API as an MCP tool through');
    L.Add('the beacon. An LLM client discovers these tools through the beacon and');
