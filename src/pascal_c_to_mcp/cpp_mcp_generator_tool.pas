    L.Add('```bat');
    L.Add('cl /std:c++17 /EHsc /I. main.cpp ' + cpp_name + ' ^');
    L.Add('   /link /LIBPATH:. LingoFuse.lib /OUT:' + MakeApiName(AppName).LowerText + '_provider.exe');
    L.Add('```');
    L.Add('');
    L.Add('**Windows (MinGW-w64)**:');
    L.Add('');
    L.Add('```bat');
    L.Add('g++ -std=c++17 -O2 -I. main.cpp ' + cpp_name + ' ^');
    L.Add('    -L. -lLingoFuse -o ' + MakeApiName(AppName).LowerText + '_provider.exe');
    L.Add('```');
    L.Add('');
    L.Add('Both `main.cpp` and `' + cpp_name + '` must be compiled. The `.cpp`');
    L.Add('defines the external symbols and entry points declared in the `.hpp`.');
    L.Add('');

    L.Add('### Step 3 - Start the beacon');
    L.Add('');
    L.Add('Open a new terminal and run:');
    L.Add('');
    L.Add('```bash');
    L.Add('cd LingoFuse-pasAgent-v3/src');
    L.Add('./pascal_agent_service.exe');
    L.Add('```');
    L.Add('');
    L.Add('The beacon listens on `ipc:agent`. Leave this terminal running.');
    L.Add('');

    L.Add('### Step 4 - Start the provider');
    L.Add('');
    L.Add('Open a second terminal and run:');
    L.Add('');
    L.Add('```bash');
    L.Add('cd my_cpp_provider');
    L.Add('LD_LIBRARY_PATH=. ./' + MakeApiName(AppName).LowerText + '_provider     # Linux');
    L.Add('set PATH=%CD%;%PATH% && ' + MakeApiName(AppName).LowerText + '_provider.exe   :: Windows');
    L.Add('```');
    L.Add('');
    L.Add('Expected output:');
    L.Add('');
    L.Add('```');
    L.Add('=== ' + UnitName + ' Tool Provider ===');
    L.Add('Connecting to ipc:agent ...');
    L.Add('');
    L.Add('[OK] Provider is ready. All tools registered.');
    L.Add('Press Enter to shut down.');
    L.Add('```');
    L.Add('');

    L.Add('### Step 5 - Start mcp_api_tool and generate the client config');
    L.Add('');
    L.Add('Open a third terminal:');
    L.Add('');
    L.Add('```bash');
    L.Add('cd LingoFuse-pasAgent-v3/src');
    L.Add('python mcp_api_tool.py --generate-configs --output-dir ./mcp_configs');
    L.Add('```');
    L.Add('');
    L.Add('This produces per-client JSON config files for LM Studio, Claude');
    L.Add('Desktop, Continue.dev, Jan, DeepSeek, and a generic MCP client.');
    L.Add('');
    L.Add('Then start the MCP gateway:');
    L.Add('');
    L.Add('```bash');
    L.Add('python mcp_api_tool.py --transport stdio');
    L.Add('```');
    L.Add('');

    L.Add('### Step 6 - Start the agent (LLM client)');
    L.Add('');
    L.Add('- **LM Studio**: Settings -> MCP Servers -> paste the corresponding');
    L.Add('  `lmstudio_stdio.json` (or `lmstudio_http.json`). Restart.');
    L.Add('- **Claude Desktop**: edit `claude_desktop_config.json`, merge the');
    L.Add('  `mcpServers` section from `claude_stdio.json`, restart.');
    L.Add('- **Continue.dev / Jan / DeepSeek**: merge the corresponding JSON,');
    L.Add('  restart.');
    L.Add('');

    L.Add('### Step 7 - Test the API');
    L.Add('');
    L.Add('In the agent, ask it to call one of the registered tools. For example,');
    L.Add('if the source unit registered `add(a: Int64, b: Int64): Int64`:');
    L.Add('');
    L.Add('```');
    L.Add('Please call the "add" tool with a=5 and b=7.');
    L.Add('```');
    L.Add('');
    L.Add('The agent will:');
    L.Add('');
    L.Add('1. Discover the `add` tool through the beacon.');
    L.Add('2. Build the JSON arguments `{"a": 5, "b": 7}`.');
    L.Add('3. Call through `mcp_api_tool` to your provider.');
    L.Add('4. Receive `{"result": 12}` and present it.');
    L.Add('');
    L.Add('In the provider terminal, the `send_log_async` output (with');
    L.Add('`DEBUG_LOG = true`) shows the same information.');
    L.Add('');
  end;

  procedure EmitToolReference;
  var
    ii, jj: integer;
  begin
    L.Add('## 5. Tool Reference');
    L.Add('');
    L.Add('This section lists every API exposed by the generated provider. Each');
    L.Add('API corresponds to one top-level function of `' + UnitName + '`.');
    L.Add('');

    if Length(ValidFuncs) = 0 then
    begin
      L.Add('> **WARNING: this provider exposes no APIs.**');
      L.Add('>');
      L.Add('> Possible reasons:');
      L.Add('> 1. The source unit has no top-level functions');
      L.Add('>    (nested routines in `class` / `record` are skipped).');
      L.Add('> 2. Every function failed the type check.');
      L.Add('>');
      L.Add('> Supported types: `Int64`, `Double`, `string` only.');
      L.Add('');
      Exit;
    end;

    L.Add('Total APIs: **' + umlIntToStr(Length(ValidFuncs)).Text + '**.');
    L.Add('');
    L.Add('| # | API name | Kind | Params | Return | Description |');
    L.Add('|---|----------|------|--------|--------|-------------|');
    for ii := 0 to High(ValidFuncs) do
    begin
      f := ValidFuncs[ii];
      shortDesc := GetTableCellText(f.Comment);
      if shortDesc.Len > 60 then
        shortDesc := shortDesc.GetString(1, 61) + '...';
      if f.IsFunction then
        row := '| ' + umlIntToStr(ii + 1).Text + ' | `' + MakeApiName(f.Name) + '` | function | ' +
          umlIntToStr(Length(f.Params)).Text + ' | `' + f.ReturnType + '` | ' + shortDesc + ' |'
      else
        row := '| ' + umlIntToStr(ii + 1).Text + ' | `' + MakeApiName(f.Name) + '` | procedure | ' +
          umlIntToStr(Length(f.Params)).Text + ' | - | ' + shortDesc + ' |';
      L.Add(row);
    end;
    L.Add('');

    for ii := 0 to High(ValidFuncs) do
    begin
      f := ValidFuncs[ii];
      desc := GetFullDescription(f.Comment);

      L.Add('### 5.' + umlIntToStr(ii + 1).Text + ' `' + MakeApiName(f.Name) + '`');
      L.Add('');
      L.Add('- Original Pascal function: `' + f.Name + '`');
      L.Add('- Exposed API name: `' + MakeApiName(f.Name) + '`');
      if f.IsFunction then
        L.Add('- Kind: `function`, returns `' + f.ReturnType + '`')
      else
        L.Add('- Kind: `procedure`');
      if desc.Len > 0 then
        L.Add('- Description: ' + desc);
      L.Add('');

      if Length(f.Params) > 0 then
      begin
        L.Add('**Parameters**');
        L.Add('');
        L.Add('| Name | Pascal type | C++ type | JSON type | Description |');
        L.Add('|------|-------------|----------|-----------|-------------|');
        for jj := 0 to High(f.Params) do
        begin
          L.Add('| `' + f.Params[jj].Name + '` | `' + f.Params[jj].PascalType + '` | `' +
            PascalTypeToCPPType(f.Params[jj].PascalType, False) + '` | `' +
            PascalTypeToJsonSchemaType(f.Params[jj].PascalType) + '` | ' +
            GetTableCellText(f.Params[jj].Description) + ' |');
        end;
        L.Add('');
      end;

      L.Add('**Input JSON example**');
      L.Add('');
      L.Add('```json');
      if Length(f.Params) = 0 then
        L.Add('{}')
      else
      begin
        L.Add('{');
        for jj := 0 to High(f.Params) do
        begin
          row := '  "' + f.Params[jj].Name + '": ' + PascalTypeToJsonLiteral(f.Params[jj].PascalType);
          if jj < High(f.Params) then row := row + ',';
          L.Add(row);
        end;
        L.Add('}');
      end;
      L.Add('```');
      L.Add('');

      L.Add('**Output JSON example**');
      L.Add('');
      L.Add('```json');
      if f.IsFunction then
        L.Add('{ "result": ' + PascalTypeToJsonLiteral(f.ReturnType) + ' }')
      else
        L.Add('{ "status": "ok" }');
      L.Add('```');
      L.Add('');
    end;
  end;

  procedure EmitJsonSchemaSpec;
  begin
    L.Add('## 6. JSON Schema Specification');
    L.Add('');
    L.Add('For each tool the provider sends a JSON Schema to the beacon through');
    L.Add('the `register_agent` API. The type whitelist is fixed by the');
    L.Add('normalized `TPascal_Func_Model` output.');
    L.Add('');
    L.Add('| Pascal normalized type | JSON Schema type | C++ type | Example value |');
    L.Add('|------------------------|------------------|----------|---------------|');
    L.Add('| `int64` | `integer` | `std::int64_t` | `42` |');
    L.Add('| `double` | `number` | `double` | `3.14` |');
    L.Add('| `string` | `string` | `std::string` | `"hello"` |');
    L.Add('');
    L.Add('**Every other type** (for example `Boolean`, arrays, records, objects,');
    L.Add('enums, interfaces, function pointers) is **NOT supported**. Functions');
    L.Add('that use them are silently dropped. If you need to pass a complex');
    L.Add('value, serialize it into a `string` first.');
    L.Add('');
  end;

  procedure EmitTroubleshooting;
  begin
    L.Add('## 7. Debugging & Troubleshooting');
    L.Add('');
    L.Add('### 7.1 Global configuration variables');
    L.Add('');
    L.Add('The generated `' + cpp_name + '` defines the following external');
    L.Add('symbols. Edit them at the top of the `.cpp` file to adjust behaviour.');
    L.Add('');
    L.Add('| Name | Default | Purpose |');
    L.Add('|------|---------|---------|');
    L.Add('| `MY_APP_NAME` | `' + UnitName + '` | LingoFuse application name |');
    L.Add('| `MY_APP_DESC` | (auto) | Application description |');
    L.Add('| `IPC_ENDPOINT` | `ipc:agent` | IPC endpoint |');
    L.Add('| `BEACON_APP` | `agent_main_app` | Beacon application name |');
    L.Add('| `REGISTER_API` | `register_agent` | Tool-registration API name |');
    L.Add('| `AGENT_LOG_API` | `agent_log` | Log API name |');
    L.Add('| `DEBUG_LOG` | `false` | Verbose logging toggle |');
    L.Add('');
    L.Add('### 7.2 Common problems');
    L.Add('');
    L.Add('| Symptom | Likely cause | Fix |');
    L.Add('|---------|--------------|-----|');
    L.Add('| `fatal error: json.hpp: No such file or directory` | nlohmann/json not present | Download `json.hpp` from the official releases page |');
    L.Add('| `fatal error: LingoFuse.h: No such file or directory` | Header missing | Use the official header, or the fallback from section 3.1 |');
    L.Add('| `undefined reference to LF_*` | Shared library not linked | Add `-lLingoFuse` and the correct `-L<path>` |');
    L.Add('| Runtime `cannot open shared object file` | Library not on loader path | `export LD_LIBRARY_PATH=.` (Linux) or copy the DLL next to the exe (Windows) |');
    L.Add('| `Execute_And_Reg_all()` returns false | Beacon not running | Start `pascal_agent_service.exe` first |');
    L.Add('| `LF_PrepareDone` returns 0 | Main thread already active in this process | Reuse the runtime, or call `LF_Shutdown` first |');
    L.Add('| Beacon not available in log | `ipc:agent` unreachable | Confirm beacon is running; check firewall |');
    L.Add('| Tool rejected by beacon | Wrong schema, or duplicate name | Check `DEBUG_LOG` output |');
    L.Add('| Tool missing from agent list | Function filtered out | Check param/return types against section 6 whitelist |');
    L.Add('| C++ exception in callback | Exception in user code | All callbacks are wrapped in try/catch; check the log |');
    L.Add('| Linker error on `DEBUG_LOG` | `extern` keyword missing on `const bool` | The generated code already has `extern`; do not remove it |');
    L.Add('');
    L.Add('### 7.3 Enabling detailed logs');
    L.Add('');
    L.Add('Set `DEBUG_LOG` to `true` at the top of `' + cpp_name + '`. Every');
    L.Add('callback then sends its input JSON, its result, and any error to the');
    L.Add('beacon via `agent_log`.');
    L.Add('');
  end;

  procedure EmitCPPPortability;
  begin
    L.Add('## 8. C++ Portability Notes');
    L.Add('');
    L.Add('The generated code targets **C++17** and uses only the standard library');
    L.Add('plus two external dependencies (`json.hpp` and `LingoFuse.h`).');
    L.Add('');
    L.Add('### 8.1 Supported compilers');
    L.Add('');
    L.Add('| Compiler | Minimum version | Notes |');
    L.Add('|----------|-----------------|-------|');
    L.Add('| MSVC | Visual Studio 2019 (16.8) | `/std:c++17` required |');
    L.Add('| g++ | 7.0 | `-std=c++17` required |');
    L.Add('| clang++ | 5.0 | `-std=c++17` required |');
    L.Add('');
    L.Add('### 8.2 Windows specifics');
    L.Add('');
    L.Add('- The generated `.cpp` uses `LF_CDECL`, which expands to `__cdecl` on');
    L.Add('  Windows and to nothing elsewhere. This matches the calling convention');
    L.Add('  that LingoFuse exports.');
    L.Add('- When linking against `LingoFuse.lib` (import library), no additional');
    L.Add('  pragma is required. When using `LoadLibrary` + `GetProcAddress`, see');
    L.Add('  the `LingoFuse.h` header comments.');
    L.Add('');
    L.Add('### 8.3 Static vs dynamic linking');
    L.Add('');
    L.Add('The generated code assumes **dynamic linking** against the LingoFuse');
    L.Add('shared library. Static linking is possible but requires building the');
    L.Add('library from source with a static configuration; that workflow is not');
    L.Add('covered here.');
    L.Add('');
    L.Add('### 8.4 IDE integration');
    L.Add('');
    L.Add('Visual Studio / CLion / VS Code: add `main.cpp`, `' + cpp_name + '`');
    L.Add('and `json.hpp` to the project, then set the include directory to the');
    L.Add('folder containing `LingoFuse.h`, and the library directory to the');
    L.Add('folder containing the LingoFuse binary.');
    L.Add('');
    L.Add('A CMake `CMakeLists.txt` for future use (once `cppAgent` provides a');
    L.Add('config file) is expected to look like:');
    L.Add('');
    L.Add('```cmake');
    L.Add('cmake_minimum_required(VERSION 3.15)');
    L.Add('project(' + MakeApiName(AppName).LowerText + '_provider CXX)');
    L.Add('');
    L.Add('set(CMAKE_CXX_STANDARD 17)');
    L.Add('set(CMAKE_CXX_STANDARD_REQUIRED ON)');
    L.Add('');
    L.Add('find_package(LingoFuse REQUIRED)   # provided by cppAgent');
    L.Add('find_package(nlohmann_json REQUIRED)');
    L.Add('');
    L.Add('add_executable(' + MakeApiName(AppName).LowerText + '_provider');
    L.Add('    main.cpp');
    L.Add('    ' + cpp_name + ')');
    L.Add('');
    L.Add('target_link_libraries(' + MakeApiName(AppName).LowerText + '_provider');
    L.Add('    PRIVATE LingoFuse::LingoFuse nlohmann_json::nlohmann_json)');
    L.Add('```');
    L.Add('');
  end;

