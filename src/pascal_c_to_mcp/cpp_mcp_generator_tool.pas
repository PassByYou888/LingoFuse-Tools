    L.Add('|------|---------|');
    L.Add('| `' + hpp_name + '` | Public header: metadata externs, internal-call declarations, entry points |');
    L.Add('| `' + cpp_name + '` | Implementation: helpers, callbacks, registration, entry points |');
    L.Add('| `' + UnitName + '_tool_provider_cpp.md` | This README |');
    L.Add('');
  end;

  procedure EmitArchitecture;
  begin
    L.Add('## 2. Runtime Architecture');
    L.Add('');
    L.Add('```mermaid');
    L.Add('flowchart TD');
    L.Add('    subgraph Runtime["LingoFuse Runtime"]');
    L.Add('        BEACON["pascal_agent_service.exe<br/>(agent_main_app)"]');
    L.Add('        IPC["ipc:agent"]');
    L.Add('    end');
    L.Add('');
    L.Add('    subgraph Provider["Generated C++ Provider"]');
