        MouseSelActions = <>
        Lines.Strings = (
          'Welcome to the Pascal / C to MCP Tool Provider Code Generator'
          ''
          'This tool converts Pascal or C function declarations into a'
          'deployable LingoFuse Tool Provider, which can then be invoked'
          'by any MCP-compatible LLM client.'
          ''
          'Architecture: three-layer transparent transformation.'
          'Each layer can be viewed, edited and exported independently.'
          ''
          '  Layer 0 : Original source code (Pascal or C).'
          '            Converted into a unified form by the code decoration model.'
          '  Layer 1 : Pascal / C declaration text.'
          '            Bi-directional conversion is supported.'
          '  Layer 2 : Raw data model (LV0).'
          '            Built by Z.Pascal_Func_Tool (Pascal) or Fill_C (C).'
          '            Contains tfunc_decl records.'
          '            Can be exported to LV0 JSON for external editing.'
          '  Layer 3 : Intermediate data model (LV1).'
          '            Normalized by pascal_func_model:'
          '              - Type normalization (Integer to Int64, etc.)'
          '              - Parameter description extraction from comments'
          '              - Structured metadata (TFunctionStructure)'
          '            Can be exported to LV1 JSON for fine tuning.'
          '  Layer 4 : Target code generators.'
          '            Emit complete LingoFuse Tool Providers.'
          '            Currently supports Pascal, Python and C++.'
          ''
          'Transparency'
          '------------'
          'Every layer (LV0, LV1) has a JSON representation that you can'
          'edit directly. Edited JSON can be re-imported to drive the next'
          'stage. One model, multiple outputs.'
          ''
          'Workflow'
          '--------'
          '1. Paste your function declarations into the Source editor.'
          '2. Click Next to parse the source into LV0 JSON.'
          '3. (Optional) Adjust the LV1 model JSON in the editor.'
          '4. Click Generate Code to produce all output files.'
          '5. Compile and run the generated provider.'
          ''
          'Future extension'
          '----------------'
          'Write a code decoration for any new language to map it into'
          'Pascal declarations, then reuse the whole pipeline. Adjust the'
          'target generators to emit providers in new languages.'
          ''
          'Enjoy!'
        )
        Options = [eoAutoIndent, eoBracketHighlight, eoGroupUndo, eoScrollPastEol, eoSmartTabs, eoTabIndent, eoTabsToSpaces, eoTrimTrailingSpaces]
        VisibleSpecialChars = [vscSpace, vscTabAtLast]
        RightEdge = 160
        ScrollBars = ssAutoVertical
        SelectedColor.BackPriority = 50
        SelectedColor.ForePriority = 50
        SelectedColor.FramePriority = 50
        SelectedColor.BoldPriority = 50
        SelectedColor.ItalicPriority = 50
        SelectedColor.UnderlinePriority = 50
        SelectedColor.StrikeOutPriority = 50
        BracketHighlightStyle = sbhsBoth
        BracketMatchColor.Background = clNone
        BracketMatchColor.Foreground = clNone
        BracketMatchColor.Style = [fsBold]
        FoldedCodeColor.Background = clNone
        FoldedCodeColor.Foreground = clGray
        FoldedCodeColor.FrameColor = clGray
        MouseLinkColor.Background = clNone
        MouseLinkColor.Foreground = clBlue
        LineHighlightColor.Background = clNone
        LineHighlightColor.Foreground = clNone
