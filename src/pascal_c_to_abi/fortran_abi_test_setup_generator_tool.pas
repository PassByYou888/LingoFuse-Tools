unit fortran_abi_test_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core,
  Z.PascalStrings, Z.UPascalStrings,
  Z.Status, Z.Json, Z.UnicodeMixedLib,
  Z.ListEngine,
  Z.Pascal_Func_Model,
  Z.Parsing, code_decl_to_abi_registry;

function GenerateFortranTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[fortran_abi_test_setup_generator] %s', [Msg.Text]);
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[fortran_abi_test_setup_generator] %s', [PFormat(Fmt, Args)]);
end;

procedure EmitHeader(Lines: TPascalStringList);
begin
  Lines.Add('#Requires -Version 5.1');
  Lines.Add('');
  Lines.Add('# ============================================================================');
  Lines.Add('# setup_fortran_tests.ps1');
  Lines.Add('# AUTO-GENERATED by fortran_abi_test_setup_generator_tool.pas.');
  Lines.Add('# Do not edit by hand: the generator re-emits this file from scratch.');
  Lines.Add('#');
  Lines.Add('# One-shot Fortran test environment bootstrap for LingoFuse ABI code.');
  Lines.Add('#');
  Lines.Add('# The script:');
  Lines.Add('#   1. Validates the LingoFuse bridge sources and the generated .f90 files.');
  Lines.Add('#      The bridge source files (LingoFuse.h/.c + lf_fortran.h/.cpp +');
  Lines.Add('#      lf_fortran_mod.f90) may be in <LingoFuseDir> directly, or in');
  Lines.Add('#      <LingoFuseDir>\c_ext, or in <LingoFuseDir>\fortran\c_ext.');
  Lines.Add('#   2. Compiles the C wrapper (LingoFuse.c), C++ bridge (lf_fortran.cpp),');
  Lines.Add('#      the Fortran binding module (lf_fortran_mod.f90), and the generated');
  Lines.Add('#      <unit>_abi_service.f90 / <unit>_abi_call.f90 modules.');
  Lines.Add('#   3. Links two executables: <unit>_abi_service_test.exe and');
  Lines.Add('#      <unit>_abi_call_test.exe.');
  Lines.Add('#   4. Copies LingoFuse64.dll and z_ipc_64.dll next to the executables.');
  Lines.Add('#   5. Optionally runs the smoke test (-RunSmoke): service + call loopback.');
  Lines.Add('#');
  Lines.Add('# Required:');
  Lines.Add('#   -LingoFuseDir  Fortran binding root. Can be either the "fortran" root');
  Lines.Add('#                  (containing c_ext/), or the c_ext directory directly.');
  Lines.Add('#                  Required files (searched in the order listed above):');
  Lines.Add('#                    LingoFuse.h, LingoFuse.c,');
  Lines.Add('#                    lf_fortran.h, lf_fortran.cpp, lf_fortran_mod.f90');
  Lines.Add('#');
  Lines.Add('# Optional:');
  Lines.Add('#   -GenDir        directory containing the generated .f90 files');
  Lines.Add('#                  (default: this script directory)');
  Lines.Add('#   -UnitName      source unit name (default: auto-detect)');
  Lines.Add('#   -Force         recreate the build directory from scratch');
  Lines.Add('#   -RunSmoke      run service + call loopback after build');
  Lines.Add('#   -Clean         delete the build directory on success');
  Lines.Add('#   -Help          show this help and exit');
  Lines.Add('# ============================================================================');
  Lines.Add('');
  Lines.Add('[CmdletBinding()]');
  Lines.Add('param(');
  Lines.Add('    [string]$LingoFuseDir = "",');
  Lines.Add('    [string]$GenDir = "",');
  Lines.Add('    [string]$UnitName = "",');
  Lines.Add('    [switch]$Force,');
  Lines.Add('    [switch]$RunSmoke,');
  Lines.Add('    [switch]$Clean,');
  Lines.Add('    [switch]$Help');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$ErrorActionPreference = "Stop"');
  Lines.Add('');
  Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
  Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
  Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
  Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
  Lines.Add('');
  Lines.Add('function Write-TextFileNoBom {');
  Lines.Add('    param([string]$Path, [string]$Content)');
  Lines.Add('    $utf8NoBom = New-Object System.Text.UTF8Encoding $false');
  Lines.Add('    [IO.File]::WriteAllText($Path, $Content, $utf8NoBom)');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('function Find-LingoFuseDllDir {');
  Lines.Add('    param([string]$BaseDir)');
  Lines.Add('    $candidates = @(');
  Lines.Add('        (Join-Path $BaseDir "Binary"),');
  Lines.Add('        (Join-Path $BaseDir "..\Binary"),');
  Lines.Add('        (Join-Path $BaseDir "..\..\Binary"),');
  Lines.Add('        $BaseDir');
  Lines.Add('    )');
  Lines.Add('    foreach ($c in $candidates) {');
  Lines.Add('        if (-not (Test-Path -LiteralPath $c)) { continue }');
  Lines.Add('        $c = (Resolve-Path -LiteralPath $c).Path');
  Lines.Add('        $probe = Join-Path $c "LingoFuse64.dll"');
  Lines.Add('        if (Test-Path -LiteralPath $probe) { return $c }');
  Lines.Add('    }');
  Lines.Add('    return ""');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitHelp(Lines: TPascalStringList);
begin
  Lines.Add('if ($Help) {');
  Lines.Add('    Write-Host "Usage: setup_fortran_tests.ps1 -LingoFuseDir <path> [options]"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "One-shot Fortran test environment bootstrap for LingoFuse ABI code."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Required:"');
  Lines.Add('    Write-Host "  -LingoFuseDir <path>"');
  Lines.Add('    Write-Host "        Fortran binding root, e.g. D:\CoreLibrary\LingoFuse\fortran"');
  Lines.Add('    Write-Host "        (bridge sources will be auto-located under c_ext\), OR pass the"');
  Lines.Add('    Write-Host "        c_ext directory directly, e.g. D:\CoreLibrary\LingoFuse\fortran\c_ext."');
  Lines.Add('    Write-Host "        Required files: LingoFuse.h, LingoFuse.c, lf_fortran.h,"');
  Lines.Add('    Write-Host "                        lf_fortran.cpp, lf_fortran_mod.f90"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Optional:"');
  Lines.Add('    Write-Host "  -GenDir <path>   Generated .f90 project directory. Default: this script directory."');
  Lines.Add('    Write-Host "  -UnitName <name> Source unit name. Default: auto-detect from *_abi_service.f90."');
  Lines.Add('    Write-Host "  -Force           Recreate the build directory from scratch."');
  Lines.Add('    Write-Host "  -RunSmoke        Run service + call loopback after build."');
  Lines.Add('    Write-Host "  -Clean           Delete the build directory on success."');
  Lines.Add('    Write-Host "  -Help            Show this help and exit."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Exit codes:"');
  Lines.Add('    Write-Host "  0   success (or -Help was requested)"');
  Lines.Add('    Write-Host "  1   validation failed, missing tool, compile error, or smoke test failed"');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitValidation(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $LingoFuseDir) {');
  Lines.Add('    Write-Fail "-LingoFuseDir is required."');
  Lines.Add('    Write-Fail "        Pass the Fortran binding root (e.g. D:\CoreLibrary\LingoFuse\fortran), or"');
  Lines.Add('    Write-Fail "        the c_ext directory directly (e.g. ...\fortran\c_ext)."');
  Lines.Add('    Write-Fail "        Run setup_fortran_tests.ps1 -Help for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $LingoFuseDir)) {');
  Lines.Add('    Write-Fail "LingoFuseDir not found: $LingoFuseDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$LingoFuseDir = (Resolve-Path -LiteralPath $LingoFuseDir).Path');
  Lines.Add('');
  Lines.Add('$lfFiles = @("LingoFuse.h", "LingoFuse.c", "lf_fortran.h", "lf_fortran.cpp", "lf_fortran_mod.f90")');
  Lines.Add('');
  Lines.Add('$probeDirs = @(');
  Lines.Add('    $LingoFuseDir,');
  Lines.Add('    (Join-Path $LingoFuseDir "c_ext"),');
  Lines.Add('    (Join-Path $LingoFuseDir "fortran\c_ext")');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$resolvedBridgeDir = ""');
  Lines.Add('$triedDirs = @()');
  Lines.Add('foreach ($d in $probeDirs) {');
  Lines.Add('    if (-not (Test-Path -LiteralPath $d)) { continue }');
  Lines.Add('    $resolved = (Resolve-Path -LiteralPath $d).Path');
  Lines.Add('    if ($triedDirs -contains $resolved) { continue }');
  Lines.Add('    $triedDirs += $resolved');
  Lines.Add('    $allPresent = $true');
  Lines.Add('    foreach ($n in $lfFiles) {');
  Lines.Add('        if (-not (Test-Path -LiteralPath (Join-Path $resolved $n))) { $allPresent = $false; break }');
  Lines.Add('    }');
  Lines.Add('    if ($allPresent) { $resolvedBridgeDir = $resolved; break }');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not $resolvedBridgeDir) {');
  Lines.Add('    Write-Fail "Missing LingoFuse bridge source file(s)."');
  Lines.Add('    Write-Fail ("Required files: " + ($lfFiles -join ", "))');
  Lines.Add('    Write-Fail "Searched directories:"');
  Lines.Add('    foreach ($d in $triedDirs) { Write-Host "        $d" }');
  Lines.Add('    Write-Fail "Pass -LingoFuseDir pointing to the Fortran root (with c_ext\),"');
  Lines.Add('    Write-Fail "or to the c_ext directory itself."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if ($resolvedBridgeDir -ne $LingoFuseDir) {');
  Lines.Add('    Write-Info "LingoFuse bridge sources found at: $resolvedBridgeDir"');
  Lines.Add('}');
  Lines.Add('$LingoFuseDir = $resolvedBridgeDir');
  Lines.Add('Write-Ok "LingoFuse bridge sources verified."');
  Lines.Add('');
  Lines.Add('if (-not $GenDir) { $GenDir = $PSScriptRoot }');
  Lines.Add('if (-not (Test-Path -LiteralPath $GenDir)) {');
  Lines.Add('    Write-Fail "GenDir not found: $GenDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$GenDir = (Resolve-Path -LiteralPath $GenDir).Path');
  Lines.Add('');
  Lines.Add('Write-Info "LingoFuseDir : $LingoFuseDir"');
  Lines.Add('Write-Info "GenDir       : $GenDir"');
  Lines.Add('');
end;

procedure EmitToolCheck(Lines: TPascalStringList);
begin
  Lines.Add('$gfortranCmd = Get-Command gfortran -ErrorAction SilentlyContinue');
  Lines.Add('if ($null -eq $gfortranCmd) {');
  Lines.Add('    Write-Fail "gfortran is not on PATH."');
  Lines.Add('    Write-Fail "        Install MinGW-w64 with gfortran enabled, or use MSYS2."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$gfortranVer = (& gfortran --version 2>&1) -join ""');
  Lines.Add('Write-Ok "gfortran: $gfortranVer"');
  Lines.Add('');
  Lines.Add('$gccCmd = Get-Command gcc -ErrorAction SilentlyContinue');
  Lines.Add('if ($null -eq $gccCmd) {');
  Lines.Add('    Write-Fail "gcc is not on PATH."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$gccVer = (& gcc --version 2>&1) -join ""');
  Lines.Add('Write-Ok "gcc: $gccVer"');
  Lines.Add('');
  Lines.Add('$gppCmd = Get-Command g++ -ErrorAction SilentlyContinue');
  Lines.Add('if ($null -eq $gppCmd) {');
  Lines.Add('    Write-Fail "g++ is not on PATH."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$gppVer = (& g++ --version 2>&1) -join ""');
  Lines.Add('Write-Ok "g++: $gppVer"');
  Lines.Add('');
end;

procedure EmitUnitNameDetect(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $UnitName) {');
  Lines.Add('    $cand = Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue | Where-Object { $_.Name -like "*_abi_service.f90" } | Select-Object -First 1');
  Lines.Add('    if ($null -ne $cand) {');
  Lines.Add('        $UnitName = $cand.Name -replace "_abi_service\.f90$", ""');
  Lines.Add('    }');
  Lines.Add('    if (-not $UnitName) {');
  Lines.Add('        Write-Fail "Cannot auto-detect UnitName (no *_abi_service.f90 in GenDir)."');
  Lines.Add('        Write-Fail "        Pass -UnitName explicitly."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('Write-Info "UnitName    : $UnitName"');
  Lines.Add('');
end;

procedure EmitFileCheck(Lines: TPascalStringList);
begin
  Lines.Add('$abiServiceF90 = Join-Path $GenDir "${UnitName}_abi_service.f90"');
  Lines.Add('$abiCallF90    = Join-Path $GenDir "${UnitName}_abi_call.f90"');
  Lines.Add('$abiSvcTestF90 = Join-Path $GenDir "${UnitName}_abi_service_test.f90"');
  Lines.Add('$abiCallTestF90= Join-Path $GenDir "${UnitName}_abi_call_test.f90"');
  Lines.Add('');
  Lines.Add('$requiredGen = @(');
  Lines.Add('    @{ Path = $abiServiceF90;   Role = "service module" },');
  Lines.Add('    @{ Path = $abiCallF90;      Role = "call module" },');
  Lines.Add('    @{ Path = $abiSvcTestF90;   Role = "service test program" },');
  Lines.Add('    @{ Path = $abiCallTestF90;  Role = "call test program" }');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$missingGen = @()');
  Lines.Add('foreach ($g in $requiredGen) {');
  Lines.Add('    if (-not (Test-Path -LiteralPath $g.Path)) { $missingGen += $g.Path }');
  Lines.Add('}');
  Lines.Add('if ($missingGen.Count -gt 0) {');
  Lines.Add('    Write-Fail "Missing generated .f90 file(s):"');
  Lines.Add('    foreach ($m in $missingGen) { Write-Host "        $m" }');
  Lines.Add('    Write-Fail "Run code_decl_to_abi --lang fortran <input> <output> first."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "Generated .f90 files verified."');
  Lines.Add('');
end;

procedure EmitBuildDir(Lines: TPascalStringList);
begin
  Lines.Add('$buildDir = Join-Path $GenDir ".fortran_build"');
  Lines.Add('');
  Lines.Add('if ($Force -and (Test-Path -LiteralPath $buildDir)) {');
  Lines.Add('    Write-Info "Force: removing existing build directory."');
  Lines.Add('    Remove-Item -LiteralPath $buildDir -Recurse -Force');
  Lines.Add('}');
  Lines.Add('if (-not (Test-Path -LiteralPath $buildDir)) {');
  Lines.Add('    New-Item -ItemType Directory -Path $buildDir -Force | Out-Null');
  Lines.Add('    Write-Ok "Created build directory: $buildDir"');
  Lines.Add('} else {');
  Lines.Add('    Write-Info "Reusing build directory: $buildDir"');
  Lines.Add('    Get-ChildItem -LiteralPath $buildDir -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$buildDir = (Resolve-Path -LiteralPath $buildDir).Path');
  Lines.Add('');
end;

procedure EmitCompile(Lines: TPascalStringList);
begin
  Lines.Add('$lingofuseC   = Join-Path $LingoFuseDir "LingoFuse.c"');
  Lines.Add('$lfFortranCpp = Join-Path $LingoFuseDir "lf_fortran.cpp"');
  Lines.Add('$lfFortranMod = Join-Path $LingoFuseDir "lf_fortran_mod.f90"');
  Lines.Add('');
  Lines.Add('Push-Location $buildDir');
  Lines.Add('try {');
  Lines.Add('');
  Lines.Add('    Write-Info "Compiling LingoFuse.c ..."');
  Lines.Add('    & gcc -c -std=c99 -O2 -I"$LingoFuseDir" "$lingofuseC" -o "LingoFuse.o"');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { Write-Fail "gcc LingoFuse.c failed (exit $LASTEXITCODE)."; exit 1 }');
  Lines.Add('    Write-Ok "LingoFuse.o built."');
  Lines.Add('');
  Lines.Add('    Write-Info "Compiling lf_fortran.cpp ..."');
  Lines.Add('    & g++ -c -std=c++11 -O2 -I"$LingoFuseDir" "$lfFortranCpp" -o "lf_fortran.o"');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { Write-Fail "g++ lf_fortran.cpp failed (exit $LASTEXITCODE)."; exit 1 }');
  Lines.Add('    Write-Ok "lf_fortran.o built."');
  Lines.Add('');
  Lines.Add('    Write-Info "Compiling lf_fortran_mod.f90 ..."');
  Lines.Add('    & gfortran -c -O2 -J"$buildDir" -I"$buildDir" "$lfFortranMod" -o "lf_fortran_mod.o"');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { Write-Fail "gfortran lf_fortran_mod.f90 failed (exit $LASTEXITCODE)."; exit 1 }');
  Lines.Add('    Write-Ok "lf_fortran_mod.o + lf_fortran_mod.mod built."');
  Lines.Add('');
  Lines.Add('    Write-Info "Compiling ${UnitName}_abi_service.f90 ..."');
  Lines.Add('    & gfortran -c -O2 -fbacktrace -J"$buildDir" -I"$buildDir" -I"$LingoFuseDir" "$abiServiceF90" -o "abi_service.o"');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { Write-Fail "gfortran ${UnitName}_abi_service.f90 failed (exit $LASTEXITCODE)."; exit 1 }');
  Lines.Add('    Write-Ok "abi_service.o + ${UnitName}_abi_service.mod built."');
  Lines.Add('');
  Lines.Add('    Write-Info "Compiling ${UnitName}_abi_call.f90 ..."');
  Lines.Add('    & gfortran -c -O2 -fbacktrace -J"$buildDir" -I"$buildDir" -I"$LingoFuseDir" "$abiCallF90" -o "abi_call.o"');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { Write-Fail "gfortran ${UnitName}_abi_call.f90 failed (exit $LASTEXITCODE)."; exit 1 }');
  Lines.Add('    Write-Ok "abi_call.o + ${UnitName}_abi_call.mod built."');
  Lines.Add('');
  Lines.Add('    Write-Info "Compiling ${UnitName}_abi_service_test.f90 ..."');
  Lines.Add('    & gfortran -c -O2 -fbacktrace -J"$buildDir" -I"$buildDir" -I"$LingoFuseDir" "$abiSvcTestF90" -o "service_test.o"');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { Write-Fail "gfortran ${UnitName}_abi_service_test.f90 failed (exit $LASTEXITCODE)."; exit 1 }');
  Lines.Add('    Write-Ok "service_test.o built."');
  Lines.Add('');
  Lines.Add('    Write-Info "Compiling ${UnitName}_abi_call_test.f90 ..."');
  Lines.Add('    & gfortran -c -O2 -fbacktrace -J"$buildDir" -I"$buildDir" -I"$LingoFuseDir" "$abiCallTestF90" -o "call_test.o"');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { Write-Fail "gfortran ${UnitName}_abi_call_test.f90 failed (exit $LASTEXITCODE)."; exit 1 }');
  Lines.Add('    Write-Ok "call_test.o built."');
  Lines.Add('');
  Lines.Add('} finally {');
  Lines.Add('    Pop-Location');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitLink(Lines: TPascalStringList);
begin
  Lines.Add('$serviceTestExe = Join-Path $buildDir "${UnitName}_abi_service_test.exe"');
  Lines.Add('$callTestExe    = Join-Path $buildDir "${UnitName}_abi_call_test.exe"');
  Lines.Add('');
  Lines.Add('Push-Location $buildDir');
  Lines.Add('try {');
  Lines.Add('');
  Lines.Add('    Write-Info "Linking ${UnitName}_abi_service_test.exe ..."');
  Lines.Add('    & gfortran -O2 -o "$serviceTestExe" `');
  Lines.Add('        "service_test.o" "abi_service.o" "lf_fortran_mod.o" "lf_fortran.o" "LingoFuse.o" `');
  Lines.Add('        -lstdc++ -static-libgcc -static-libstdc++');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { Write-Fail "link service_test failed (exit $LASTEXITCODE)."; exit 1 }');
  Lines.Add('    Write-Ok "service_test.exe built."');
  Lines.Add('');
  Lines.Add('    Write-Info "Linking ${UnitName}_abi_call_test.exe ..."');
  Lines.Add('    & gfortran -O2 -o "$callTestExe" `');
  Lines.Add('        "call_test.o" "abi_call.o" "lf_fortran_mod.o" "lf_fortran.o" "LingoFuse.o" `');
  Lines.Add('        -lstdc++ -static-libgcc -static-libstdc++');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { Write-Fail "link call_test failed (exit $LASTEXITCODE)."; exit 1 }');
  Lines.Add('    Write-Ok "call_test.exe built."');
  Lines.Add('');
  Lines.Add('} finally {');
  Lines.Add('    Pop-Location');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitCopyDll(Lines: TPascalStringList);
begin
  Lines.Add('$dllDir = Find-LingoFuseDllDir -BaseDir $LingoFuseDir');
  Lines.Add('if (-not $dllDir) {');
  Lines.Add('    Write-Warn "LingoFuse64.dll not found near LingoFuseDir."');
  Lines.Add('    Write-Warn "         Place LingoFuse64.dll + z_ipc_64.dll next to the test executables,"');
  Lines.Add('    Write-Warn "         or on the system loader search path before running the tests."');
  Lines.Add('} else {');
  Lines.Add('    Write-Info "Copying runtime DLLs from $dllDir ..."');
  Lines.Add('    $dlls = @("LingoFuse64.dll", "z_ipc_64.dll", "mimalloc64.dll")');
  Lines.Add('    foreach ($d in $dlls) {');
  Lines.Add('        $src = Join-Path $dllDir $d');
  Lines.Add('        if (Test-Path -LiteralPath $src) {');
  Lines.Add('            Copy-Item -LiteralPath $src -Destination $buildDir -Force');
  Lines.Add('            Write-Info "    $d"');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('    if (-not (Test-Path -LiteralPath (Join-Path $buildDir "LingoFuse64.dll"))) {');
  Lines.Add('        Write-Warn "LingoFuse64.dll was not copied - tests will fail to load the runtime."');
  Lines.Add('    }');
  Lines.Add('    if (-not (Test-Path -LiteralPath (Join-Path $buildDir "z_ipc_64.dll"))) {');
  Lines.Add('        Write-Warn "z_ipc_64.dll was not copied - LingoFuse64.dll may fail to load."');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitSmoke(Lines: TPascalStringList);
begin
  Lines.Add('if ($RunSmoke) {');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Info "Running smoke test (service + call loopback) ..."');
  Lines.Add('');
  Lines.Add('    $svcLog = Join-Path $buildDir "service_test.log"');
  Lines.Add('    $svcErr = Join-Path $buildDir "service_test.err"');
  Lines.Add('    $callLog = Join-Path $buildDir "call_test.log"');
  Lines.Add('    $callErr = Join-Path $buildDir "call_test.err"');
  Lines.Add('');
  Lines.Add('    foreach ($f in @($svcLog, $svcErr, $callLog, $callErr)) {');
  Lines.Add('        if (Test-Path -LiteralPath $f) { Remove-Item -LiteralPath $f -Force -ErrorAction SilentlyContinue }');
  Lines.Add('    }');
  Lines.Add('');
  Lines.Add('    $svcProc = Start-Process -FilePath $serviceTestExe -WorkingDirectory $buildDir `');
  Lines.Add('        -NoNewWindow -PassThru `');
  Lines.Add('        -RedirectStandardOutput $svcLog -RedirectStandardError $svcErr');
  Lines.Add('');
  Lines.Add('    Write-Info "Waiting for service [READY] ..."');
  Lines.Add('    $ready = $false');
  Lines.Add('    $t0 = Get-Date');
  Lines.Add('    while (((Get-Date) - $t0).TotalSeconds -lt 15) {');
  Lines.Add('        if (Test-Path -LiteralPath $svcLog) {');
  Lines.Add('            $c = Get-Content -LiteralPath $svcLog -Raw -ErrorAction SilentlyContinue');
  Lines.Add('            if ($c -and ($c.Contains("[READY]") -or $c.Contains("[FATAL]"))) { $ready = $true; break }');
  Lines.Add('        }');
  Lines.Add('        Start-Sleep -Milliseconds 200');
  Lines.Add('    }');
  Lines.Add('    if (-not $ready) {');
  Lines.Add('        Write-Fail "service_test did not reach [READY] within 15s."');
  Lines.Add('        try { Stop-Process -Id $svcProc.Id -Force -ErrorAction SilentlyContinue } catch {}');
  Lines.Add('        if (Test-Path -LiteralPath $svcLog) { Write-Host "--- service log ---"; Get-Content -LiteralPath $svcLog }');
  Lines.Add('        if (Test-Path -LiteralPath $svcErr) { Write-Host "--- service err ---"; Get-Content -LiteralPath $svcErr }');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    Write-Ok "service_test is ready."');
  Lines.Add('');
  Lines.Add('    Write-Info "Running call_test ..."');
  Lines.Add('    $callProc = Start-Process -FilePath $callTestExe -WorkingDirectory $buildDir `');
  Lines.Add('        -NoNewWindow -PassThru -Wait `');
  Lines.Add('        -RedirectStandardOutput $callLog -RedirectStandardError $callErr');
  Lines.Add('    $callExit = $callProc.ExitCode');
  Lines.Add('');
  Lines.Add('    try { Stop-Process -Id $svcProc.Id -Force -ErrorAction SilentlyContinue } catch {}');
  Lines.Add('');
  Lines.Add('    if (Test-Path -LiteralPath $callLog) { Write-Host "--- call log ---"; Get-Content -LiteralPath $callLog }');
  Lines.Add('    if (Test-Path -LiteralPath $callErr) {');
  Lines.Add('        $callErrContent = Get-Content -LiteralPath $callErr -Raw -ErrorAction SilentlyContinue');
  Lines.Add('        if ($callErrContent) { Write-Host "--- call err ---"; Write-Host $callErrContent }');
  Lines.Add('    }');
  Lines.Add('');
  Lines.Add('    if ($callExit -eq 0) {');
  Lines.Add('        Write-Ok "Smoke test passed (call_test exit code 0)."');
  Lines.Add('    } else {');
  Lines.Add('        Write-Fail "Smoke test failed (call_test exit code $callExit)."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('');
  Lines.Add('    if (Test-Path -LiteralPath $svcLog) {');
  Lines.Add('        Write-Host "--- service log (post-run) ---"');
  Lines.Add('        Get-Content -LiteralPath $svcLog');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitNextSteps(Lines: TPascalStringList);
begin
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Environment is ready." -ForegroundColor Green');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Build directory: $buildDir" -ForegroundColor Cyan');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Two executables:" -ForegroundColor Cyan');
  Lines.Add('Write-Host "  ${UnitName}_abi_service_test.exe"');
  Lines.Add('Write-Host "  ${UnitName}_abi_call_test.exe"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Run the tests in two terminals:" -ForegroundColor Cyan');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Terminal 1 (service):" -ForegroundColor Yellow');
  Lines.Add('Write-Host "      cd `"$buildDir`""');
  Lines.Add('Write-Host "      .\${UnitName}_abi_service_test.exe"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Terminal 2 (call):" -ForegroundColor Yellow');
  Lines.Add('Write-Host "      cd `"$buildDir`""');
  Lines.Add('Write-Host "      .\${UnitName}_abi_call_test.exe"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "The service waits for a sentinel or 30s; the call test exits 0 when all pass, 2 otherwise." -ForegroundColor DarkGray');
  Lines.Add('Write-Host ""');
  Lines.Add('if ($Clean) {');
  Lines.Add('    if (Test-Path -LiteralPath $buildDir) {');
  Lines.Add('        Remove-Item -LiteralPath $buildDir -Recurse -Force');
  Lines.Add('        Write-Info "Cleaned up: $buildDir"');
  Lines.Add('    }');
  Lines.Add('} else {');
  Lines.Add('    Write-Host "Use -Clean next time to delete the build directory." -ForegroundColor DarkGray');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('exit 0');
  Lines.Add('');
end;

function GenerateFortranTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
begin
  Result := nil;
  if Model = nil then
  begin
    Log('Model is nil');
    Exit;
  end;

  Lines := TPascalStringList.Create;
  try
    EmitHeader(Lines);
    EmitHelp(Lines);
    EmitValidation(Lines);
    EmitToolCheck(Lines);
    EmitUnitNameDetect(Lines);
    EmitFileCheck(Lines);
    EmitBuildDir(Lines);
    EmitCompile(Lines);
    EmitLink(Lines);
    EmitCopyDll(Lines);
    EmitSmoke(Lines);
    EmitNextSteps(Lines);
    Result := Lines;
    Log(PFormat('Generated setup_fortran_tests.ps1 with %d lines', [Lines.Count]));
  finally
    if Result <> Lines then
      Lines.Free;
  end;
end;

initialization

  RegisterGenerator(
    'fortran',
    'setup_fortran_tests.ps1',
    gkPs1,
    'Fortran ABI test environment setup script',
    @GenerateFortranTestSetupScript);

end.
