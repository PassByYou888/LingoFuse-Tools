      object Memo_Welcome: TMemo
        Left = 0
        Height = 416
        Top = 25
        Width = 992
        Align = alClient
        Font.CharSet = ANSI_CHARSET
        Font.Height = -19
        Font.Name = 'Consolas'
        Font.Pitch = fpFixed
        Font.Quality = fqDraft
        Lines.Strings = (
          'Welcome to the LF-ABI Interface Code Generator'
          '================================================'
          ''
          'This tool turns Pascal or C declarations into cross-language'
          'LingoFuse ABI bindings. From a single source unit it produces'
          'production-grade Service and Call code for three target'
          'languages:'
          ''
          '    Pascal   (Free Pascal and Delphi)'
          '    Python   (Python 3.8+ via ctypes)'
          '    C++      (C++17)'
          ''
          'Each generator also emits a matching README that documents the'
          'wire protocol, the type mapping, deployment, testing, and every'
          'exposed API.'
          ''
          '------------------------------------------------------------'
          'Pipeline overview'
          '------------------------------------------------------------'
          ''
          '  Source (Pascal or C)'
          '        |'
          '        v'
          '  LV0 JSON   - raw parse result (tfunc_decl records)'
          '        |'
          '        v'
          '  LV1 JSON   - normalised model; type widths and signedness'
          '               preserved; parameter descriptions extracted'
          '               from comments'
          '        |'
          '        v'
          '  Six code generators + six README generators'
          '        |'
          '        v'
          '  12 output artefacts, all sharing one wire protocol'
          ''
          '------------------------------------------------------------'
          'Wire protocol (byte-identical across all languages)'
          '------------------------------------------------------------'
          ''
          '  request  = [field1][field2]...[fieldN]'
          '  response = [status:uint8_t][payload]'
          ''
          '    status = 0x00  -> success; payload is the serialised result'
          '    status = 0xFF  -> error; payload is a UTF-8 message,'
          '                      terminated by a single NUL'
          ''
          '  Integers : little-endian'
          '  Strings  : UTF-8 followed by a single NUL terminator'
          '  Floats   : 4-byte or 8-byte IEEE 754'
          ''
          '------------------------------------------------------------'
          'Workflow'
          '------------------------------------------------------------'
          ''
          '  1. Paste Pascal or C declarations into the "2 - Source"'
          '     editor.'
          '  2. Pick the source language (or click the label to'
          '     auto-detect it).'
          '  3. Click "Next: Source -> JSON" to build the LV0 JSON.'
          '  4. Click "Next: JSON -> Model" to build the LV1 model.'
          '     Optionally edit the LV1 JSON, then click'
          '     "Back: Model -> JSON" to propagate your changes.'
          '  5. Click "Next: Generate All Artefacts" to produce the'
          '     twelve output files (six code files + six README files).'
          '  6. Compile and run each generated file following the'
          '     instructions in its README.'
          ''
          '------------------------------------------------------------'
          'Deployment example (Pascal service, Python/C++ clients)'
          '------------------------------------------------------------'
          ''
          '  Terminal 1 - Pascal service:'
          ''
          '      LF_ResetPrepare;'
          '      LF_PrepareService(''ipc:my_unit_abi'', ''ipc:my_unit_abi'');'
          '      App := CreateAndRegisterABIApp;'
          '      LF_PrepareClient(''ipc:my_unit_abi'', App);'
          '      if LF_PrepareDone <> 1 then Halt(1);'
          '      ReadLn;'
          '      LF_ExitMainThread;'
          '      LF_FreeApp(App);'
          '      LF_Shutdown;'
          ''
          '  Terminal 2 - Python client:'
          ''
          '      from lingofuse._lf_native import ('
          '          LF_ResetPrepare, LF_PrepareClient, LF_PrepareDone,'
          '          LF_ExitMainThread, LF_Shutdown)'
          '      from lingofuse.lf_io import cstr'
          '      import my_unit_abi_call'
          ''
          '      LF_ResetPrepare()'
          '      LF_PrepareClient(cstr(''ipc:my_unit_abi''), None)'
          '      if LF_PrepareDone() != 1:'
          '          raise SystemExit(1)'
          '      try:'
          '          print(my_unit_abi_call.Add(3, 4))'
          '      finally:'
          '          LF_ExitMainThread()'
          '          LF_Shutdown()'
          ''
          '  Terminal 3 - C++ client:'
          ''
          '      #include "LingoFuse.hpp"'
          '      #include "my_unit_abi_call.hpp"'
          ''
          '      int main() {'
          '          LF_ResetPrepare();'
          '          LF_PrepareClient("ipc:my_unit_abi", nullptr);'
          '          if (LF_PrepareDone() != 1) return 1;'
          '          std::cout << my_unit_abi::Add(3, 4) << "\n";'
          '          LF_ExitMainThread();'
          '          LF_Shutdown();'
          '          return 0;'
          '      }'
          ''
          '------------------------------------------------------------'
          'Extending the tool'
          '------------------------------------------------------------'
          ''
          '  - Add a new source language by implementing a "modifier"'
          '    that normalises its declarations into Pascal syntax,'
          '    then register it in the language selector.'
          ''
          '  - Add a new target language by implementing a service'
          '    generator and a call generator that consume the same LV1'
          '    model. The LV0 / LV1 JSON schemas are stable, so existing'
          '    generators keep working.'
          ''
          '------------------------------------------------------------'
          'Quick start'
          '------------------------------------------------------------'
          ''
          '  "2 - Source" panel : paste Pascal or C declarations.'
          '  Language combo box : pick a language, or click the label'
          '                       to auto-detect.'
          '  "Empty Skeleton"   : load a minimal template for the'
          '                       current language.'
          '  "Load Sample"      : load a comprehensive example that'
          '                       covers many declaration styles.'
          '  "Next: Generate"   : produce all artefacts on the final'
          '                       tab; they are also saved to disk next'
          '                       to the executable.'
          ''
          'For details, see the project documentation and the README'
          'files shipped with each generated artefact.'
          ''
          'Happy generating!'
        )
        ParentFont = False
        ScrollBars = ssAutoVertical
        TabOrder = 1
        WordWrap = False
      end
    end
