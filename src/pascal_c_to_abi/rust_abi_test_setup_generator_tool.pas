unit rust_abi_test_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core,
  Z.PascalStrings, Z.UPascalStrings,
  Z.Status, Z.UnicodeMixedLib, Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_abi_registry;

function GenerateRustTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

const
  CH_SQ: string = #39;

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[rust_abi_test_setup_generator] %s', [Msg.Text]);
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[rust_abi_test_setup_generator] %s', [PFormat(Fmt, Args)]);
end;

procedure EmitHeader(Lines: TPascalStringList);
begin
  Lines.Add('#Requires -Version 5.1');
  Lines.Add('# ============================================================================');
  Lines.Add('# setup_rust_tests.ps1');
  Lines.Add('# AUTO-GENERATED by rust_abi_test_setup_generator_tool.pas.');
  Lines.Add('# Do not edit by hand: the generator re-emits this file from scratch.');
  Lines.Add('#');
  Lines.Add('# One-shot Rust test environment bootstrap.');
  Lines.Add('#');
  Lines.Add('# The script:');
  Lines.Add('#   1. Validates the lingofuse crate and the generated Rust project.');
  Lines.Add('#   2. Copies the generated .rs files into src/ and examples/');
  Lines.Add('#      (overwrites stale copies when the generated file is newer).');
  Lines.Add('#   3. Creates Cargo.toml and src/lib.rs if missing.');
  Lines.Add('#   4. Patches Cargo.toml: lingofuse = { path = "<LingofuseDir>" }.');
  Lines.Add('#   5. Removes a stale ./lingofuse copy or junction if present.');
  Lines.Add('#   6. Sanity-checks the .rs files for stale Pascal type names.');
  Lines.Add('#   7. Runs cargo build (and cargo build --examples if -RunSmoke).');
  Lines.Add('#');
  Lines.Add('# Required:');
  Lines.Add('#   -LingofuseDir  path to the lingofuse crate source directory');
  Lines.Add('#                  (must contain Cargo.toml and src/lib.rs)');
  Lines.Add('#');
  Lines.Add('# Optional:');
  Lines.Add('#   -GenDir        directory containing the generated Rust project');
  Lines.Add('#                  (default: this script directory)');
  Lines.Add('#   -UnitName      source unit name (default: auto-detect)');
  Lines.Add('#   -Force         force-copy generated files even if older,');
  Lines.Add('#                  and overwrite an existing Cargo.toml');
  Lines.Add('#   -RunSmoke      also run cargo build --examples');
  Lines.Add('#   -Help          show this help and exit');
  Lines.Add('#');
  Lines.Add('# Usage:');
  Lines.Add('#   .\setup_rust_tests.ps1 -LingofuseDir D:\CoreLibrary\LingoFuse\rust');
  Lines.Add('#   .\setup_rust_tests.ps1 -LingofuseDir D:\CoreLibrary\LingoFuse\rust -RunSmoke');
  Lines.Add('# ============================================================================');
  Lines.Add('');
  Lines.Add('[CmdletBinding()]');
  Lines.Add('param(');
  Lines.Add('    [string]$LingofuseDir = "",');
  Lines.Add('    [string]$GenDir = "",');
  Lines.Add('    [string]$UnitName = "",');
  Lines.Add('    [switch]$Force,');
  Lines.Add('    [switch]$RunSmoke,');
  Lines.Add('    [switch]$Help');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$ErrorActionPreference = "Stop"');
  Lines.Add('');
  Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
  Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
  Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
  Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
  Lines.Add('');
  Lines.Add('function Write-TextFileNoBom {');
  Lines.Add('    param([string]$Path, [string]$Content)');
  Lines.Add('    $utf8NoBom = New-Object System.Text.UTF8Encoding $false');
  Lines.Add('    [IO.File]::WriteAllText($Path, $Content, $utf8NoBom)');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitHelp(Lines: TPascalStringList);
begin
  Lines.Add('if ($Help) {');
  Lines.Add('    Write-Host "Usage: setup_rust_tests.ps1 -LingofuseDir <path> [options]"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "One-shot Rust test environment bootstrap."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Required:"');
  Lines.Add('    Write-Host "  -LingofuseDir <path>"');
  Lines.Add('    Write-Host "        Path to the lingofuse crate source directory."');
  Lines.Add('    Write-Host "        Must contain Cargo.toml and src/lib.rs."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Optional:"');
  Lines.Add('    Write-Host "  -GenDir <path>     Directory containing the generated Rust project."');
  Lines.Add('    Write-Host "                     Default: this script directory."');
  Lines.Add('    Write-Host "  -UnitName <name>   Source unit name (default: auto-detect)."');
  Lines.Add('    Write-Host "  -Force             Force-copy generated files even if older."');
  Lines.Add('    Write-Host "  -RunSmoke          Also run cargo build --examples."');
  Lines.Add('    Write-Host "  -Help              Show this help."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Exit codes:"');
  Lines.Add('    Write-Host "  0   success (or -Help was requested)"');
  Lines.Add('    Write-Host "  1   validation failed, missing tool, stale .rs, or build failed"');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitValidation(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $LingofuseDir) {');
  Lines.Add('    Write-Fail "-LingofuseDir is required."');
  Lines.Add('    Write-Host "        Run setup_rust_tests.ps1 -Help for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $LingofuseDir)) {');
  Lines.Add('    Write-Fail "LingofuseDir not found: $LingofuseDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$LingofuseDir = (Resolve-Path -LiteralPath $LingofuseDir).Path');
  Lines.Add('');
  Lines.Add('$lingofuseToml = Join-Path $LingofuseDir "Cargo.toml"');
  Lines.Add('if (-not (Test-Path -LiteralPath $lingofuseToml)) {');
  Lines.Add('    Write-Fail "Missing Cargo.toml in LingofuseDir:"');
  Lines.Add('    Write-Fail "            $lingofuseToml"');
  Lines.Add('    Write-Fail "            -LingofuseDir must point at the lingofuse crate source."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$lingofuseLib = Join-Path $LingofuseDir "src/lib.rs"');
  Lines.Add('if (-not (Test-Path -LiteralPath $lingofuseLib)) {');
  Lines.Add('    Write-Fail "Missing src/lib.rs in LingofuseDir:"');
  Lines.Add('    Write-Fail "            $lingofuseLib"');
  Lines.Add('    Write-Fail "            -LingofuseDir does not look like the lingofuse crate source."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not $GenDir) { $GenDir = $PSScriptRoot }');
  Lines.Add('$GenDir = (Resolve-Path -LiteralPath $GenDir).Path');
  Lines.Add('');
  Lines.Add('$normalizedLingofuse = $LingofuseDir.Replace([string][char]92, [string][char]47)');
  Lines.Add('');
  Lines.Add('Write-Info "LingofuseDir : $LingofuseDir"');
  Lines.Add('Write-Info "GenDir       : $GenDir"');
  Lines.Add('Write-Info "Cargo path   : $normalizedLingofuse"');
  Lines.Add('');
end;

procedure EmitToolCheck(Lines: TPascalStringList);
begin
  Lines.Add('$cargoCmd = Get-Command cargo -ErrorAction SilentlyContinue');
  Lines.Add('if ($null -eq $cargoCmd) {');
  Lines.Add('    Write-Fail "cargo is not on PATH."');
  Lines.Add('    Write-Fail "            Install Rust via rustup: https://rustup.rs/"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$cargoVer = (& cargo --version 2>&1) -join ""');
  Lines.Add('Write-Ok "cargo $cargoVer"');
  Lines.Add('');
  Lines.Add('$rustcCmd = Get-Command rustc -ErrorAction SilentlyContinue');
  Lines.Add('if ($null -eq $rustcCmd) {');
  Lines.Add('    Write-Fail "rustc is not on PATH."');
  Lines.Add('    Write-Fail "            Install Rust via rustup: https://rustup.rs/"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$rustcVer = (& rustc --version 2>&1) -join ""');
  Lines.Add('Write-Ok "rustc $rustcVer"');
  Lines.Add('');
end;

procedure EmitUnitNameDetect(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $UnitName) {');
  Lines.Add('    $cargoToml = Join-Path $GenDir "Cargo.toml"');
  Lines.Add('    if (Test-Path -LiteralPath $cargoToml) {');
  Lines.Add('        $content = Get-Content -LiteralPath $cargoToml -Raw');
  Lines.Add('        if ($content -match ''(?s)\[package\].*?name\s*=\s*"([^"]+)"'') {');
  Lines.Add('            $candidate = $matches[1]');
  Lines.Add('            if ($candidate -match ''^(.+)_abi$'') {');
  Lines.Add('                $UnitName = $matches[1]');
  Lines.Add('            } else {');
  Lines.Add('                $UnitName = $candidate');
  Lines.Add('            }');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('    if (-not $UnitName) {');
  Lines.Add('        $cand = Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue | Where-Object { $_.DirectoryName -eq $GenDir -and $_.Name -like "*_abi_service.rs" -and $_.Name -notlike "*_test.rs" } | Select-Object -First 1');
  Lines.Add('        if ($null -ne $cand) {');
  Lines.Add('            $base = $cand.Name -replace ''_abi_service\.rs$'', ''''');
  Lines.Add('            if ($base -match ''^(.+)_abi$'') {');
  Lines.Add('                $UnitName = $matches[1]');
  Lines.Add('            } else {');
  Lines.Add('                $UnitName = $base');
  Lines.Add('            }');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('    if (-not $UnitName) {');
  Lines.Add('        Write-Fail "Cannot auto-detect UnitName (no Cargo.toml and no *_abi_service.rs)."');
  Lines.Add('        Write-Fail "            Pass -UnitName explicitly."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('Write-Info "UnitName     : $UnitName"');
  Lines.Add('');
end;

procedure EmitLayout(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Copying generated .rs files into the project layout ..."');
  Lines.Add('');
  Lines.Add('$srcDir = Join-Path $GenDir "src"');
  Lines.Add('$examplesDir = Join-Path $GenDir "examples"');
  Lines.Add('if (-not (Test-Path -LiteralPath $srcDir)) {');
  Lines.Add('    New-Item -ItemType Directory -Path $srcDir | Out-Null');
  Lines.Add('}');
  Lines.Add('if (-not (Test-Path -LiteralPath $examplesDir)) {');
  Lines.Add('    New-Item -ItemType Directory -Path $examplesDir | Out-Null');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$migrations = @(');
  Lines.Add('    @{ Pattern = "*_abi_service_test.rs"; Target = "examples/service_test.rs" },');
  Lines.Add('    @{ Pattern = "*_abi_call_test.rs";    Target = "examples/call_test.rs"    },');
  Lines.Add('    @{ Pattern = "*_abi_service.rs";      Target = "src/service.rs"          },');
  Lines.Add('    @{ Pattern = "*_abi_call.rs";         Target = "src/call.rs"             }');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('foreach ($m in $migrations) {');
  Lines.Add('    $candidates = @(Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue | Where-Object { $_.DirectoryName -eq $GenDir -and $_.Name -like $m.Pattern })');
  Lines.Add('    if ($candidates.Count -eq 0) {');
  Lines.Add('        Write-Info ("  no source candidate for " + $m.Target)');
  Lines.Add('        continue');
  Lines.Add('    }');
  Lines.Add('    $srcItem = $candidates[0]');
  Lines.Add('    $dst = Join-Path $GenDir $m.Target');
  Lines.Add('    $doCopy = $true');
  Lines.Add('    if (Test-Path -LiteralPath $dst) {');
  Lines.Add('        $srcMtime = $srcItem.LastWriteTime');
  Lines.Add('        $dstMtime = (Get-Item -LiteralPath $dst).LastWriteTime');
  Lines.Add('        if ($srcMtime -le $dstMtime -and -not $Force) {');
  Lines.Add('            Write-Info ("  " + $m.Target + " is up-to-date with " + $srcItem.Name + " (skip)")');
  Lines.Add('            $doCopy = $false');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('    if ($doCopy) {');
  Lines.Add('        Copy-Item -LiteralPath $srcItem.FullName -Destination $dst -Force');
  Lines.Add('        Write-Info ("  " + $srcItem.Name + " -> " + $m.Target)');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitScaffold(Lines: TPascalStringList);
begin
  Lines.Add('$libRs = Join-Path $GenDir "src/lib.rs"');
  Lines.Add('if (-not (Test-Path -LiteralPath $libRs)) {');
  Lines.Add('    $libContent = "pub mod service;" + [Environment]::NewLine + "pub mod call;" + [Environment]::NewLine');
  Lines.Add('    Write-TextFileNoBom -Path $libRs -Content $libContent');
  Lines.Add('    Write-Info "  Created src/lib.rs"');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$cargoToml = Join-Path $GenDir "Cargo.toml"');
  Lines.Add('$needCargo = (-not (Test-Path -LiteralPath $cargoToml)) -or $Force');
  Lines.Add('if ($needCargo) {');
  Lines.Add('    $cargoContent = @"');
  Lines.Add('[package]');
  Lines.Add('name = "${UnitName}_abi"');
  Lines.Add('version = "0.1.0"');
  Lines.Add('edition = "2021"');
  Lines.Add('');
  Lines.Add('[[example]]');
  Lines.Add('name = "service_test"');
  Lines.Add('path = "examples/service_test.rs"');
  Lines.Add('');
  Lines.Add('[[example]]');
  Lines.Add('name = "call_test"');
  Lines.Add('path = "examples/call_test.rs"');
  Lines.Add('');
  Lines.Add('[dependencies]');
  Lines.Add('lingofuse = { path = "$normalizedLingofuse" }');
  Lines.Add('"@');
  Lines.Add('    Write-TextFileNoBom -Path $cargoToml -Content $cargoContent');
  Lines.Add('    Write-Info "  Created Cargo.toml"');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitPatchCargo(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Patching Cargo.toml to point at the real lingofuse crate ..."');
  Lines.Add('');
  Lines.Add('$cargoToml = Join-Path $GenDir "Cargo.toml"');
  Lines.Add('$cargoContent = Get-Content -LiteralPath $cargoToml -Raw');
  Lines.Add('$oldContent = $cargoContent');
  Lines.Add('$replacement = ''lingofuse = { path = "'' + $normalizedLingofuse + ''" }''');
  Lines.Add('$safeReplacement = $replacement.Replace(''$'', ''$$'')');
  Lines.Add('');
  Lines.Add('if ($cargoContent -match ''lingofuse\s*=\s*\{[^}]*\}'') {');
  Lines.Add('    $cargoContent = $cargoContent -replace ''lingofuse\s*=\s*\{[^}]*\}'', $safeReplacement');
  Lines.Add('    if ($cargoContent -ne $oldContent) {');
  Lines.Add('        Write-TextFileNoBom -Path $cargoToml -Content $cargoContent');
  Lines.Add('        Write-Ok ("  Patched: lingofuse -> " + $normalizedLingofuse)');
  Lines.Add('    } else {');
  Lines.Add('        Write-Ok ("  Already up-to-date: lingofuse -> " + $normalizedLingofuse)');
  Lines.Add('    }');
  Lines.Add('} else {');
  Lines.Add('    if ($cargoContent -notmatch ''(?s)\[dependencies\]'') {');
  Lines.Add('        $cargoContent = $cargoContent.TrimEnd() + [Environment]::NewLine + [Environment]::NewLine + "[dependencies]"');
  Lines.Add('    }');
  Lines.Add('    $cargoContent = $cargoContent.TrimEnd() + [Environment]::NewLine + $replacement + [Environment]::NewLine');
  Lines.Add('    Write-TextFileNoBom -Path $cargoToml -Content $cargoContent');
  Lines.Add('    Write-Ok ("  Appended: lingofuse -> " + $normalizedLingofuse)');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitStaleCleanup(Lines: TPascalStringList);
begin
  Lines.Add('$staleLingofuse = Join-Path $GenDir "lingofuse"');
  Lines.Add('if (Test-Path -LiteralPath $staleLingofuse) {');
  Lines.Add('    $item = Get-Item -LiteralPath $staleLingofuse -Force');
  Lines.Add('    $isReparse = ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0');
  Lines.Add('    if ($isReparse) {');
  Lines.Add('        Write-Info "  Removing stale lingofuse junction at $staleLingofuse"');
  Lines.Add('        Remove-Item -LiteralPath $staleLingofuse -Force -Recurse');
  Lines.Add('    } else {');
  Lines.Add('        Write-Info "  Removing stale lingofuse copy at $staleLingofuse"');
  Lines.Add('        Remove-Item -LiteralPath $staleLingofuse -Recurse -Force');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitSanityCheck(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Sanity-checking generated .rs files for stale Pascal type names ..."');
  Lines.Add('');
  Lines.Add('$rsFiles = @(');
  Lines.Add('    "src/service.rs",');
  Lines.Add('    "src/call.rs",');
  Lines.Add('    "examples/service_test.rs",');
  Lines.Add('    "examples/call_test.rs"');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$stalePattern = ''(?m)^\s*let\s+\w+\s*:\s*(integer|double|single|extended|real|smallint|cardinal|uint64|word|byte|longint)\s*=''');
  Lines.Add('');
  Lines.Add('$staleFiles = @()');
  Lines.Add('foreach ($rel in $rsFiles) {');
  Lines.Add('    $p = Join-Path $GenDir $rel');
  Lines.Add('    if (-not (Test-Path -LiteralPath $p)) { continue }');
  Lines.Add('    $c = Get-Content -LiteralPath $p -Raw');
  Lines.Add('    if ($c -match $stalePattern) {');
  Lines.Add('        $staleFiles += $rel');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if ($staleFiles.Count -gt 0) {');
  Lines.Add('    Write-Fail "Stale Rust files detected (Pascal type names in let bindings):"');
  Lines.Add('    foreach ($s in $staleFiles) { Write-Host "        $s" }');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Fail "These .rs files were produced by an OLD Rust generator."');
  Lines.Add('    Write-Fail "setup_rust_tests.ps1 only copies/patches files; it never re-generates."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Fail "You must run these steps IN ORDER:"');
  Lines.Add('    Write-Fail "  1. fpc code_decl_to_abi.lpr      (rebuild the generator)"');
  Lines.Add('    Write-Fail "  2. run code_decl_to_abi          (re-emit the .rs files)"');
  Lines.Add('    Write-Fail "  3. .\setup_rust_tests.ps1 ...    (this script, again)"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "Sanity check passed: no Pascal type names in let bindings."');
  Lines.Add('');
end;

procedure EmitFileCheck(Lines: TPascalStringList);
begin
  Lines.Add('$requiredFiles = @(');
  Lines.Add('    "Cargo.toml",');
  Lines.Add('    "src/lib.rs",');
  Lines.Add('    "src/service.rs",');
  Lines.Add('    "src/call.rs",');
  Lines.Add('    "examples/service_test.rs",');
  Lines.Add('    "examples/call_test.rs"');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$missing = @()');
  Lines.Add('foreach ($rel in $requiredFiles) {');
  Lines.Add('    $p = Join-Path $GenDir $rel');
  Lines.Add('    if (-not (Test-Path -LiteralPath $p)) { $missing += $p }');
  Lines.Add('}');
  Lines.Add('if ($missing.Count -gt 0) {');
  Lines.Add('    Write-Fail "Missing required files after layout normalization:"');
  Lines.Add('    foreach ($m in $missing) { Write-Host "        $m" }');
  Lines.Add('    Write-Fail "The Rust generator likely failed. Check the generator output first."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "All required files present."');
  Lines.Add('');
end;

procedure EmitBuild(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Running cargo build ..."');
  Lines.Add('Push-Location $GenDir');
  Lines.Add('try {');
  Lines.Add('    & cargo build');
  Lines.Add('    $rc = $LASTEXITCODE');
  Lines.Add('} finally {');
  Lines.Add('    Pop-Location');
  Lines.Add('}');
  Lines.Add('if ($rc -ne 0) {');
  Lines.Add('    Write-Fail "cargo build failed (exit $rc)."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "cargo build passed."');
  Lines.Add('');
end;

procedure EmitSmoke(Lines: TPascalStringList);
begin
  Lines.Add('if ($RunSmoke) {');
  Lines.Add('    Write-Info "Running cargo build --examples ..."');
  Lines.Add('    Push-Location $GenDir');
  Lines.Add('    try {');
  Lines.Add('        & cargo build --examples');
  Lines.Add('        $rc = $LASTEXITCODE');
  Lines.Add('    } finally {');
  Lines.Add('        Pop-Location');
  Lines.Add('    }');
  Lines.Add('    if ($rc -ne 0) {');
  Lines.Add('        Write-Fail "cargo build --examples failed (exit $rc)."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    Write-Ok "cargo build --examples passed."');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitNextSteps(Lines: TPascalStringList);
begin
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Environment is ready." -ForegroundColor Green');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Terminal 1 (service):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      cd `"$GenDir`""');
  Lines.Add('Write-Host "      cargo run --example service_test"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Terminal 2 (call):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      cd `"$GenDir`""');
  Lines.Add('Write-Host "      cargo run --example call_test"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  The call test prints [PASS] / [FAIL] / [SKIP] lines and exits"');
  Lines.Add('Write-Host "  with code 0 on success or 2 on failure."');
  Lines.Add('Write-Host ""');
  Lines.Add('');
  Lines.Add('exit 0');
end;

function GenerateRustTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
begin
  Result := nil;
  if Model = nil then
  begin
    Log('Model is nil');
    Exit;
  end;

  Lines := TPascalStringList.Create;
  try
    EmitHeader(Lines);
    EmitHelp(Lines);
    EmitValidation(Lines);
    EmitToolCheck(Lines);
    EmitUnitNameDetect(Lines);
    EmitLayout(Lines);
    EmitScaffold(Lines);
    EmitPatchCargo(Lines);
    EmitStaleCleanup(Lines);
    EmitSanityCheck(Lines);
    EmitFileCheck(Lines);
    EmitBuild(Lines);
    EmitSmoke(Lines);
    EmitNextSteps(Lines);
    Result := Lines;
    Log('Generated setup_rust_tests.ps1');
  finally
    if Result <> Lines then
      Lines.Free;
  end;
end;

initialization

  RegisterGenerator(
    'rust',
    'setup_rust_tests.ps1',
    gkPs1,
