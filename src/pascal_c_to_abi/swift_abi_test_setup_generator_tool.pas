unit swift_abi_test_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core,
  Z.PascalStrings, Z.UPascalStrings,
  Z.Status, Z.UnicodeMixedLib, Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_abi_registry;

function GenerateSwiftTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[swift_abi_test_setup_generator] %s', [Msg.Text]);
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[swift_abi_test_setup_generator] %s', [PFormat(Fmt, Args)]);
end;

procedure EmitHeader(Lines: TPascalStringList);
begin
  Lines.Add('#Requires -Version 5.1');
  Lines.Add('# setup_swift_tests.ps1');
  Lines.Add('# AUTO-GENERATED by swift_abi_test_setup_generator_tool.pas');
  Lines.Add('#');
  Lines.Add('# One-shot Swift test environment bootstrap for the LingoFuse ABI generator.');
  Lines.Add('#');
  Lines.Add('# Required:');
  Lines.Add('#   -LingofuseDir   Path to the lingofuse Swift package source directory.');
  Lines.Add('#                   Must contain Package.swift and Sources/LingoFuse/.');
  Lines.Add('#');
  Lines.Add('# Optional:');
  Lines.Add('#   -GenDir         Directory containing the generated Swift project.');
  Lines.Add('#                   Default: this script directory.');
  Lines.Add('#   -UnitName       Source unit name. Default: auto-detect from *_abi_service.swift.');
  Lines.Add('#   -Force          Force-copy generated files even if older.');
  Lines.Add('#   -RunSmoke       Also run swift build --product ServiceTest --product CallTest.');
  Lines.Add('#   -Help           Show this help and exit.');
  Lines.Add('');
  Lines.Add('[CmdletBinding()]');
  Lines.Add('param(');
  Lines.Add('    [string]$LingofuseDir = "",');
  Lines.Add('    [string]$GenDir = "",');
  Lines.Add('    [string]$UnitName = "",');
  Lines.Add('    [switch]$Force,');
  Lines.Add('    [switch]$RunSmoke,');
  Lines.Add('    [switch]$Help');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$ErrorActionPreference = "Stop"');
  Lines.Add('');
  Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
  Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
  Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
  Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
  Lines.Add('');
  Lines.Add('function Write-TextFileNoBom {');
  Lines.Add('    param([string]$Path, [string]$Content)');
  Lines.Add('    $utf8NoBom = New-Object System.Text.UTF8Encoding $false');
  Lines.Add('    [IO.File]::WriteAllText($Path, $Content, $utf8NoBom)');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitHelp(Lines: TPascalStringList);
begin
  Lines.Add('if ($Help) {');
  Lines.Add('    Write-Host "Usage: setup_swift_tests.ps1 -LingofuseDir <path> [options]"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "One-shot Swift test environment bootstrap for the LingoFuse ABI generator."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Required:"');
  Lines.Add('    Write-Host "  -LingofuseDir <path>"');
  Lines.Add('    Write-Host "        Path to the lingofuse Swift package source directory."');
  Lines.Add('    Write-Host "        Must contain Package.swift and Sources/LingoFuse/."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Optional:"');
  Lines.Add('    Write-Host "  -GenDir <path>     Directory containing the generated Swift project."');
  Lines.Add('    Write-Host "                     Default: this script directory."');
  Lines.Add('    Write-Host "  -UnitName <name>   Source unit name. Default: auto-detect from *_abi_service.swift."');
  Lines.Add('    Write-Host "  -Force             Force-copy generated files even if older."');
  Lines.Add('    Write-Host "  -RunSmoke          Also run swift build --product ServiceTest --product CallTest."');
  Lines.Add('    Write-Host "  -Help              Show this help."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Exit codes:"');
  Lines.Add('    Write-Host "  0   success (or -Help was requested)"');
  Lines.Add('    Write-Host "  1   validation failed, missing tool, stale .swift, or build failed"');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitValidation(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $LingofuseDir) {');
  Lines.Add('    Write-Fail "-LingofuseDir is required."');
  Lines.Add('    Write-Host "        Run setup_swift_tests.ps1 -Help for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $LingofuseDir)) {');
  Lines.Add('    Write-Fail "LingofuseDir not found: $LingofuseDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$LingofuseDir = (Resolve-Path -LiteralPath $LingofuseDir).Path');
  Lines.Add('');
  Lines.Add('$lingofusePackageSwift = Join-Path $LingofuseDir "Package.swift"');
  Lines.Add('if (-not (Test-Path -LiteralPath $lingofusePackageSwift)) {');
  Lines.Add('    Write-Fail "Missing Package.swift in LingofuseDir:"');
  Lines.Add('    Write-Fail "            $lingofusePackageSwift"');
  Lines.Add('    Write-Fail "            -LingofuseDir must point at the lingofuse Swift package source."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$lingofuseSourcesDir = Join-Path $LingofuseDir "Sources/LingoFuse"');
  Lines.Add('if (-not (Test-Path -LiteralPath $lingofuseSourcesDir)) {');
  Lines.Add('    Write-Fail "Missing Sources/LingoFuse in LingofuseDir:"');
  Lines.Add('    Write-Fail "            $lingofuseSourcesDir"');
  Lines.Add('    Write-Fail "            -LingofuseDir does not look like the lingofuse Swift package source."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not $GenDir) { $GenDir = $PSScriptRoot }');
  Lines.Add('$GenDir = (Resolve-Path -LiteralPath $GenDir).Path');
  Lines.Add('');
  Lines.Add('$normalizedLingofuse = $LingofuseDir.Replace([string][char]92, [string][char]47)');
  Lines.Add('$packageIdentity = (Split-Path -Leaf $normalizedLingofuse).ToLower()');
  Lines.Add('if (-not $packageIdentity) {');
  Lines.Add('    Write-Fail "Cannot determine package identity from path: $normalizedLingofuse"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('Write-Info "LingofuseDir : $LingofuseDir"');
  Lines.Add('Write-Info "GenDir       : $GenDir"');
  Lines.Add('Write-Info "Package path : $normalizedLingofuse"');
  Lines.Add('Write-Info "Package id   : $packageIdentity"');
  Lines.Add('');
end;

procedure EmitToolCheck(Lines: TPascalStringList);
begin
  Lines.Add('$swiftCmd = Get-Command swift -ErrorAction SilentlyContinue');
  Lines.Add('if ($null -eq $swiftCmd) {');
  Lines.Add('    Write-Fail "swift is not on PATH."');
  Lines.Add('    Write-Fail "            Install Swift from https://www.swift.org/download/"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$swiftVer = (& swift --version 2>&1) -join " "');
  Lines.Add('Write-Ok "swift $swiftVer"');
  Lines.Add('');
end;

procedure EmitUnitNameDetect(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $UnitName) {');
  Lines.Add('    $candidates = @(Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue | Where-Object { $_.Name -like "*_abi_service.swift" -and $_.Name -notlike "*_test.swift" })');
  Lines.Add('    if ($candidates.Count -gt 0) {');
  Lines.Add('        $base = $candidates[0].Name -replace ''_abi_service\.swift$'', ''''');
  Lines.Add('        $UnitName = $base');
  Lines.Add('    }');
  Lines.Add('    if (-not $UnitName) {');
  Lines.Add('        Write-Fail "Cannot auto-detect UnitName (no *_abi_service.swift in GenDir)."');
  Lines.Add('        Write-Fail "            Pass -UnitName explicitly."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('Write-Info "UnitName     : $UnitName"');
  Lines.Add('');
end;

procedure EmitLayout(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Normalizing directory layout ..."');
  Lines.Add('');
  Lines.Add('$srcServiceDir = Join-Path $GenDir "Sources/${UnitName}_abi_service"');
  Lines.Add('$srcCallDir    = Join-Path $GenDir "Sources/${UnitName}_abi_call"');
  Lines.Add('$serviceTestDir = Join-Path $GenDir "Sources/ServiceTest"');
  Lines.Add('$callTestDir    = Join-Path $GenDir "Sources/CallTest"');
  Lines.Add('');
  Lines.Add('foreach ($d in @($srcServiceDir, $srcCallDir, $serviceTestDir, $callTestDir)) {');
  Lines.Add('    if (-not (Test-Path -LiteralPath $d)) {');
  Lines.Add('        New-Item -ItemType Directory -Path $d -Force | Out-Null');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$migrations = @(');
  Lines.Add('    @{ Pattern = "*_abi_service_test.swift"; Target = "Sources/ServiceTest/main.swift" },');
  Lines.Add('    @{ Pattern = "*_abi_call_test.swift";    Target = "Sources/CallTest/main.swift" },');
  Lines.Add('    @{ Pattern = "*_abi_service.swift";      Target = "Sources/${UnitName}_abi_service/${UnitName}_abi_service.swift" },');
  Lines.Add('    @{ Pattern = "*_abi_call.swift";         Target = "Sources/${UnitName}_abi_call/${UnitName}_abi_call.swift" }');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('foreach ($m in $migrations) {');
  Lines.Add('    $candidates = @(Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue | Where-Object { $_.Name -like $m.Pattern })');
  Lines.Add('    if ($candidates.Count -eq 0) {');
  Lines.Add('        Write-Info ("  no source candidate for " + $m.Target)');
  Lines.Add('        continue');
  Lines.Add('    }');
  Lines.Add('    $srcItem = $candidates[0]');
  Lines.Add('    $dst = Join-Path $GenDir $m.Target');
  Lines.Add('    $doCopy = $true');
  Lines.Add('    if (Test-Path -LiteralPath $dst) {');
  Lines.Add('        $srcMtime = $srcItem.LastWriteTime');
  Lines.Add('        $dstMtime = (Get-Item -LiteralPath $dst).LastWriteTime');
  Lines.Add('        if ($srcMtime -le $dstMtime -and -not $Force) {');
  Lines.Add('            Write-Info ("  " + $m.Target + " is up-to-date with " + $srcItem.Name + " (skip)")');
  Lines.Add('            $doCopy = $false');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('    if ($doCopy) {');
  Lines.Add('        Copy-Item -LiteralPath $srcItem.FullName -Destination $dst -Force');
  Lines.Add('        Write-Info ("  " + $srcItem.Name + " -> " + $m.Target)');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitSanityCheck(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Sanity-checking generated .swift files for stale Pascal type names ..."');
  Lines.Add('');
  Lines.Add('$swiftFiles = @(');
  Lines.Add('    "Sources/${UnitName}_abi_service/${UnitName}_abi_service.swift",');
  Lines.Add('    "Sources/${UnitName}_abi_call/${UnitName}_abi_call.swift",');
  Lines.Add('    "Sources/ServiceTest/main.swift",');
  Lines.Add('    "Sources/CallTest/main.swift"');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$stalePattern = ''(?m):\s*(Integer|LongInt|Cardinal|DWord|LongWord|Word|SmallInt|Byte|Single|Extended|Real|AnsiString|UnicodeString|TPascalString|TUPascalString|PChar|PAnsiChar|PWideChar)\b''');
  Lines.Add('');
  Lines.Add('$staleFiles = @()');
  Lines.Add('foreach ($rel in $swiftFiles) {');
  Lines.Add('    $p = Join-Path $GenDir $rel');
  Lines.Add('    if (-not (Test-Path -LiteralPath $p)) { continue }');
  Lines.Add('    $c = Get-Content -LiteralPath $p -Raw');
  Lines.Add('    if ($c -match $stalePattern) {');
  Lines.Add('        $staleFiles += $rel');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if ($staleFiles.Count -gt 0) {');
  Lines.Add('    Write-Fail "Stale Swift files detected (Pascal type names in type annotations):"');
  Lines.Add('    foreach ($s in $staleFiles) { Write-Host "        $s" }');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Fail "These .swift files were produced by an OLD Swift generator."');
  Lines.Add('    Write-Fail "setup_swift_tests.ps1 only copies/patches files; it never re-generates."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Fail "You must run these steps IN ORDER:"');
  Lines.Add('    Write-Fail "  1. rebuild the code_decl_to_abi generator"');
  Lines.Add('    Write-Fail "  2. run code_decl_to_abi --lang swift <source> <out_dir>"');
  Lines.Add('    Write-Fail "  3. .\setup_swift_tests.ps1 ... (this script, again)"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "Sanity check passed: no Pascal type names in type annotations."');
  Lines.Add('');
end;

procedure EmitFileCheck(Lines: TPascalStringList);
begin
  Lines.Add('$requiredFiles = @(');
  Lines.Add('    "Package.swift",');
  Lines.Add('    "Sources/${UnitName}_abi_service/${UnitName}_abi_service.swift",');
  Lines.Add('    "Sources/${UnitName}_abi_call/${UnitName}_abi_call.swift",');
  Lines.Add('    "Sources/ServiceTest/main.swift",');
  Lines.Add('    "Sources/CallTest/main.swift"');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$missing = @()');
  Lines.Add('foreach ($rel in $requiredFiles) {');
  Lines.Add('    $p = Join-Path $GenDir $rel');
  Lines.Add('    if (-not (Test-Path -LiteralPath $p)) { $missing += $p }');
  Lines.Add('}');
  Lines.Add('if ($missing.Count -gt 0) {');
  Lines.Add('    Write-Fail "Missing required files after layout normalization:"');
  Lines.Add('    foreach ($m in $missing) { Write-Host "        $m" }');
  Lines.Add('    Write-Fail "The Swift generator likely failed. Check the generator output first."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "All required files present."');
  Lines.Add('');
end;

procedure EmitPackageSwift(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Generating Package.swift ..."');
  Lines.Add('$packageSwiftPath = Join-Path $GenDir "Package.swift"');
  Lines.Add('$packageContent = @"');
  Lines.Add('// swift-tools-version: 5.9');
  Lines.Add('import PackageDescription');
  Lines.Add('');
  Lines.Add('let package = Package(');
  Lines.Add('    name: "${UnitName}_abi",');
  Lines.Add('    platforms: [.macOS(.v12)],');
  Lines.Add('    products: [');
  Lines.Add('        .library(name: "${UnitName}_abi_service", targets: ["${UnitName}_abi_service"]),');
  Lines.Add('        .library(name: "${UnitName}_abi_call",    targets: ["${UnitName}_abi_call"]),');
  Lines.Add('        .executable(name: "ServiceTest",    targets: ["ServiceTest"]),');
  Lines.Add('        .executable(name: "CallTest",       targets: ["CallTest"]),');
  Lines.Add('    ],');
  Lines.Add('    dependencies: [');
  Lines.Add('        .package(path: "$normalizedLingofuse"),');
  Lines.Add('    ],');
  Lines.Add('    targets: [');
  Lines.Add('        .target(');
  Lines.Add('            name: "${UnitName}_abi_service",');
  Lines.Add('            dependencies: [.product(name: "LingoFuse", package: "$packageIdentity")],');
  Lines.Add('            path: "Sources/${UnitName}_abi_service"');
  Lines.Add('        ),');
  Lines.Add('        .target(');
  Lines.Add('            name: "${UnitName}_abi_call",');
  Lines.Add('            dependencies: [.product(name: "LingoFuse", package: "$packageIdentity")],');
  Lines.Add('            path: "Sources/${UnitName}_abi_call"');
  Lines.Add('        ),');
  Lines.Add('        .executableTarget(');
  Lines.Add('            name: "ServiceTest",');
  Lines.Add('            dependencies: ["${UnitName}_abi_service"],');
  Lines.Add('            path: "Sources/ServiceTest"');
  Lines.Add('        ),');
  Lines.Add('        .executableTarget(');
  Lines.Add('            name: "CallTest",');
  Lines.Add('            dependencies: ["${UnitName}_abi_call"],');
  Lines.Add('            path: "Sources/CallTest"');
  Lines.Add('        ),');
  Lines.Add('    ]');
  Lines.Add(')');
  Lines.Add('"@');
  Lines.Add('Write-TextFileNoBom -Path $packageSwiftPath -Content $packageContent');
  Lines.Add('Write-Ok "  Package.swift written (identity: $packageIdentity)"');
  Lines.Add('');
end;

procedure EmitBuild(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Running swift build ..."');
  Lines.Add('Push-Location $GenDir');
  Lines.Add('try {');
  Lines.Add('    & swift build');
  Lines.Add('    $rc = $LASTEXITCODE');
  Lines.Add('} finally {');
  Lines.Add('    Pop-Location');
  Lines.Add('}');
  Lines.Add('if ($rc -ne 0) {');
  Lines.Add('    Write-Fail "swift build failed (exit $rc)."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "swift build passed."');
  Lines.Add('');
end;

procedure EmitSmoke(Lines: TPascalStringList);
begin
  Lines.Add('if ($RunSmoke) {');
  Lines.Add('    Write-Info "Running swift build --product ServiceTest --product CallTest ..."');
  Lines.Add('    Push-Location $GenDir');
  Lines.Add('    try {');
  Lines.Add('        & swift build --product ServiceTest');
  Lines.Add('        $rc1 = $LASTEXITCODE');
  Lines.Add('        & swift build --product CallTest');
  Lines.Add('        $rc2 = $LASTEXITCODE');
  Lines.Add('    } finally {');
  Lines.Add('        Pop-Location');
  Lines.Add('    }');
  Lines.Add('    if ($rc1 -ne 0 -or $rc2 -ne 0) {');
  Lines.Add('        Write-Fail "swift build --product failed."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    Write-Ok "swift build --product passed."');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitNextSteps(Lines: TPascalStringList);
begin
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Environment is ready." -ForegroundColor Green');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Terminal 1 (service):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      cd `"$GenDir`""');
  Lines.Add('Write-Host "      swift run ServiceTest"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Terminal 2 (call):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      cd `"$GenDir`""');
  Lines.Add('Write-Host "      swift run CallTest"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  The call test prints [PASS] / [FAIL] / [SKIP] lines and exits"');
  Lines.Add('Write-Host "  with code 0 on success or 2 on failure."');
  Lines.Add('Write-Host ""');
  Lines.Add('');
  Lines.Add('exit 0');
end;

function GenerateSwiftTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
begin
  Result := nil;
  if Model = nil then
  begin
    Log('Model is nil');
    Exit;
  end;

  Lines := TPascalStringList.Create;
  try
    EmitHeader(Lines);
    EmitHelp(Lines);
    EmitValidation(Lines);
    EmitToolCheck(Lines);
    EmitUnitNameDetect(Lines);
    EmitLayout(Lines);
    EmitPackageSwift(Lines);
    EmitSanityCheck(Lines);
    EmitFileCheck(Lines);
    EmitBuild(Lines);
    EmitSmoke(Lines);
    EmitNextSteps(Lines);
    Result := Lines;
    Log('Generated setup_swift_tests.ps1');
  finally
    if Result <> Lines then
      Lines.Free;
  end;
end;

initialization

  RegisterGenerator(
    'swift',
    'setup_swift_tests.ps1',
    gkPs1,
    'Swift ABI test environment setup script',
    @GenerateSwiftTestSetupScript);

end.
