unit ts_abi_test_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core,
  Z.PascalStrings, Z.UPascalStrings,
  Z.Status, Z.UnicodeMixedLib,
  Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_abi_registry;

function GenerateTsTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

uses
  SysUtils;

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[http_ts_abi_test_setup_generator] %s', [Msg.Text]);
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[http_ts_abi_test_setup_generator] %s', [PFormat(Fmt, Args)]);
end;

function GenerateTsTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
begin
  Result := nil;
  if Model = nil then
  begin
    Log('Model is nil');
    Exit;
  end;
  if Model.UnitName.Len = 0 then
  begin
    Log('UnitName is empty');
    Exit;
  end;

  Log(PFormat('Generating setup_ts_tests.ps1 for unit "%s"', [Model.UnitName.Text]));

  Lines := TPascalStringList.Create;
  try
    Lines.Add('#Requires -Version 5.1');
    Lines.Add('');
    Lines.Add('[CmdletBinding()]');
    Lines.Add('param(');
    Lines.Add('    [string]$LingoFuseTs = "",');
    Lines.Add('    [string]$GenDir = "",');
    Lines.Add('    [string]$UnitName = "",');
    Lines.Add('    [switch]$Force,');
    Lines.Add('    [switch]$RunSmoke,');
    Lines.Add('    [switch]$Compiled,');
    Lines.Add('    [switch]$SkipInstall,');
    Lines.Add('    [switch]$SkipAutoLink,');
    Lines.Add('    [switch]$Help');
    Lines.Add(')');
    Lines.Add('');
    Lines.Add('$ErrorActionPreference = "Stop"');
    Lines.Add('');
    Lines.Add('if ($args -contains "--help") { $Help = $true }');
    Lines.Add('if ($LingoFuseTs -eq "--help") { $Help = $true; $LingoFuseTs = "" }');
    Lines.Add('if ($GenDir -eq "--help") { $Help = $true; $GenDir = "" }');
    Lines.Add('if ($UnitName -eq "--help") { $Help = $true; $UnitName = "" }');
    Lines.Add('');
    Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
    Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
    Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
    Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
    Lines.Add('');
    Lines.Add('function Write-TextFileNoBom {');
    Lines.Add('    param([string]$Path, [string]$Content)');
    Lines.Add('    $utf8NoBom = New-Object System.Text.UTF8Encoding $false');
    Lines.Add('    [IO.File]::WriteAllText($Path, $Content, $utf8NoBom)');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('function Test-IsLink {');
    Lines.Add('    param([string]$Path)');
    Lines.Add('    $item = Get-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue');
    Lines.Add('    if ($null -eq $item) { return $false }');
    Lines.Add('    return ($item.LinkType -eq "Junction") -or ($item.LinkType -eq "SymbolicLink")');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('function Get-LinkTargetPath {');
    Lines.Add('    param([string]$Path)');
    Lines.Add('    $item = Get-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue');
    Lines.Add('    if ($null -eq $item -or $null -eq $item.Target) { return $null }');
    Lines.Add('    $t = $item.Target');
    Lines.Add('    if ($t -is [array]) { $t = $t[0] }');
    Lines.Add('    return [System.IO.Path]::GetFullPath($t)');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('function New-JunctionByMkLink {');
    Lines.Add('    param([string]$LinkPath, [string]$TargetPath)');
    Lines.Add('    $psi = New-Object System.Diagnostics.ProcessStartInfo');
    Lines.Add('    $psi.FileName = "cmd.exe"');
    Lines.Add('    $psi.Arguments = "/d /c mklink /J ""$LinkPath"" ""$TargetPath"""');
    Lines.Add('    $psi.UseShellExecute = $false');
    Lines.Add('    $psi.CreateNoWindow = $true');
    Lines.Add('    $psi.RedirectStandardOutput = $true');
    Lines.Add('    $psi.RedirectStandardError = $true');
    Lines.Add('    $proc = [System.Diagnostics.Process]::Start($psi)');
    Lines.Add('    $null = $proc.StandardOutput.ReadToEnd()');
    Lines.Add('    $null = $proc.StandardError.ReadToEnd()');
    Lines.Add('    $proc.WaitForExit()');
    Lines.Add('    return (Test-Path -LiteralPath $LinkPath)');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('function Ensure-LingofuseTsLinked {');
    Lines.Add('    param([string]$LingoFuseTs, [string]$GenDir)');
    Lines.Add('    $nmDir = Join-Path $GenDir "node_modules"');
    Lines.Add('    $linkPath = Join-Path $nmDir "lingofuse-ts"');
    Lines.Add('');
    Lines.Add('    if (Test-Path -LiteralPath $linkPath) {');
    Lines.Add('        $isLink = Test-IsLink $linkPath');
    Lines.Add('        if ($isLink) {');
    Lines.Add('            $existing = Get-LinkTargetPath $linkPath');
    Lines.Add('            $expected = [System.IO.Path]::GetFullPath($LingoFuseTs)');
    Lines.Add('            if ($null -ne $existing -and $existing.TrimEnd("\", "/") -ieq $expected.TrimEnd("\", "/")) {');
    Lines.Add('                Write-Ok "lingofuse-ts already linked: $linkPath"');
    Lines.Add('                return $true');
    Lines.Add('            }');
    Lines.Add('            Write-Warn "lingofuse-ts link points elsewhere; recreating."');
    Lines.Add('            Remove-Item -LiteralPath $linkPath -Force -ErrorAction SilentlyContinue');
    Lines.Add('        } else {');
    Lines.Add('            Write-Warn "lingofuse-ts exists but is not a link; leaving it alone."');
    Lines.Add('            return (Test-Path -LiteralPath (Join-Path $linkPath "dist/index.js"))');
    Lines.Add('        }');
    Lines.Add('    }');
    Lines.Add('');
    Lines.Add('    if (-not (Test-Path -LiteralPath $nmDir)) {');
    Lines.Add('        [void][System.IO.Directory]::CreateDirectory($nmDir)');
    Lines.Add('    }');
    Lines.Add('');
    Lines.Add('    Write-Info "Creating lingofuse-ts junction ..."');
    Lines.Add('    $ok = New-JunctionByMkLink -LinkPath $linkPath -TargetPath $LingoFuseTs');
    Lines.Add('    if ($ok) {');
    Lines.Add('        Write-Ok "lingofuse-ts linked: $linkPath -> $LingoFuseTs"');
    Lines.Add('        return $true');
    Lines.Add('    }');
    Lines.Add('');
    Lines.Add('    try {');
    Lines.Add('        [void][System.IO.Directory]::CreateSymbolicLink($linkPath, $LingoFuseTs)');
    Lines.Add('        if (Test-Path -LiteralPath $linkPath) {');
    Lines.Add('            Write-Ok "lingofuse-ts linked (symlink): $linkPath -> $LingoFuseTs"');
    Lines.Add('            return $true');
    Lines.Add('        }');
    Lines.Add('    } catch {');
    Lines.Add('        Write-Warn "CreateSymbolicLink failed: $($_.Exception.Message)"');
    Lines.Add('    }');
    Lines.Add('');
    Lines.Add('    Write-Fail "Auto-link failed. Run manually:"');
    Lines.Add('    Write-Fail "    cd $LingoFuseTs"');
    Lines.Add('    Write-Fail "    .\install.ps1 -ProjectDir $GenDir"');
    Lines.Add('    return $false');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('function Invoke-TsFile {');
    Lines.Add('    param([string]$RelPath)');
    Lines.Add('    if ($Compiled) {');
    Lines.Add('        $baseName = [IO.Path]::GetFileNameWithoutExtension($RelPath)');
    Lines.Add('        $jsRel = "dist\$baseName.js"');
    Lines.Add('        & $nodeExe $jsRel | Out-Host');
    Lines.Add('    } else {');
    Lines.Add('        & $nodeExe $tsxCli $RelPath | Out-Host');
    Lines.Add('    }');
    Lines.Add('    $rc = $LASTEXITCODE');
    Lines.Add('    if ($null -eq $rc) { $rc = 0 }');
    Lines.Add('    return [int]$rc');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('if ($Help) {');
    Lines.Add('    Write-Host "Usage: setup_ts_tests.ps1 -LingoFuseTs <path> [options]"');
    Lines.Add('    Write-Host ""');
    Lines.Add('    Write-Host "One-shot TypeScript test environment bootstrap for LingoFuse ABI generated code."');
    Lines.Add('    Write-Host ""');
    Lines.Add('    Write-Host "Required:"');
    Lines.Add('    Write-Host "  -LingoFuseTs <path>  Path to the lingofuse-ts source directory."');
    Lines.Add('    Write-Host ""');
    Lines.Add('    Write-Host "Optional:"');
    Lines.Add('    Write-Host "  -GenDir <path>       Generated project directory. Default: script directory."');
    Lines.Add('    Write-Host "  -UnitName <name>     Source unit name. Default: auto-detect."');
    Lines.Add('    Write-Host "  -RunSmoke            Run service + call smoke test after setup."');
    Lines.Add('    Write-Host "  -Compiled            Compile with tsc and run dist/*.js instead of tsx."');
    Lines.Add('    Write-Host "  -SkipInstall         Do not run npm install; fail if deps are missing."');
    Lines.Add('    Write-Host "  -SkipAutoLink        Do not auto-link lingofuse-ts; assume it is already installed."');
    Lines.Add('    Write-Host "  -Force               Overwrite existing tsconfig.json and package.json."');
    Lines.Add('    Write-Host "  -Help                Show this help."');
    Lines.Add('    exit 0');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('if (-not $LingoFuseTs) {');
    Lines.Add('    Write-Fail "-LingoFuseTs is required."');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('if (-not (Test-Path -LiteralPath $LingoFuseTs)) {');
    Lines.Add('    Write-Fail "LingoFuseTs not found: $LingoFuseTs"');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('$LingoFuseTs = (Resolve-Path -LiteralPath $LingoFuseTs).Path');
    Lines.Add('');
    Lines.Add('$tsPkg = Join-Path $LingoFuseTs "package.json"');
    Lines.Add('if (-not (Test-Path -LiteralPath $tsPkg)) {');
    Lines.Add('    Write-Fail "Missing package.json in LingoFuseTs: $tsPkg"');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('$tsDist = Join-Path $LingoFuseTs "dist/index.js"');
    Lines.Add('if (-not (Test-Path -LiteralPath $tsDist)) {');
    Lines.Add('    Write-Fail "lingofuse-ts is not built. Run build.ps1 inside $LingoFuseTs first."');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('if (-not $GenDir) { $GenDir = $PSScriptRoot }');
    Lines.Add('if (-not (Test-Path -LiteralPath $GenDir)) {');
    Lines.Add('    Write-Fail "GenDir not found: $GenDir"');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('$GenDir = (Resolve-Path -LiteralPath $GenDir).Path');
    Lines.Add('');
    Lines.Add('Write-Info "LingoFuseTs : $LingoFuseTs"');
    Lines.Add('Write-Info "GenDir      : $GenDir"');
    Lines.Add('');
    Lines.Add('$nodeCmd = Get-Command node -ErrorAction SilentlyContinue');
    Lines.Add('if ($null -eq $nodeCmd) {');
    Lines.Add('    Write-Fail "node is not on PATH. Install Node.js 18+."');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('$nodeExe = $nodeCmd.Source');
    Lines.Add('$nodeVer = (& node --version 2>&1) -join ""');
    Lines.Add('Write-Ok "node $nodeVer"');
    Lines.Add('');
    Lines.Add('$npmCmd = Get-Command npm -ErrorAction SilentlyContinue');
    Lines.Add('if ($null -eq $npmCmd) {');
    Lines.Add('    Write-Fail "npm is not on PATH."');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('$npmVer = (& npm --version 2>&1) -join ""');
    Lines.Add('Write-Ok "npm $npmVer"');
    Lines.Add('');
    Lines.Add('$abiExt = ""');
    Lines.Add('');
    Lines.Add('if (-not $UnitName) {');
    Lines.Add('    $cand = Get-ChildItem -LiteralPath $GenDir -File -Filter "*_abi_service.ts" -ErrorAction SilentlyContinue | Select-Object -First 1');
    Lines.Add('    if ($null -ne $cand) {');
    Lines.Add('        $UnitName = $cand.Name -replace ' + #39 + '_abi_service\.ts$' + #39 + ', ' + #39 + #39);
    Lines.Add('        $abiExt = ".ts"');
    Lines.Add('    }');
    Lines.Add('}');
    Lines.Add('if (-not $UnitName) {');
    Lines.Add('    Write-Fail "Cannot auto-detect UnitName. Pass -UnitName explicitly."');
    Lines.Add('    Write-Fail ""');
    Lines.Add('    Write-Fail "Files in $GenDir matching *_abi_service*:"');
    Lines.Add('    $cands = @(Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue | Where-Object { $_.Name -like "*_abi_service*" })');
    Lines.Add('    if ($cands.Count -eq 0) {');
    Lines.Add('        Write-Fail "  (none)"');
    Lines.Add('        Write-Fail "Run code_decl_to_abi --lang http_ts <source> $GenDir first."');
    Lines.Add('    } else {');
    Lines.Add('        foreach ($c in $cands) { Write-Fail "  $($c.Name)" }');
    Lines.Add('    }');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('if (-not $abiExt) { $abiExt = ".ts" }');
    Lines.Add('Write-Ok "UnitName $UnitName (ext $abiExt)"');
    Lines.Add('');
    Lines.Add('$required = @(');
    Lines.Add('    "${UnitName}_abi_service$abiExt",');
    Lines.Add('    "${UnitName}_abi_call$abiExt",');
    Lines.Add('    "${UnitName}_abi_service_test$abiExt",');
    Lines.Add('    "${UnitName}_abi_call_test$abiExt"');
    Lines.Add(')');
    Lines.Add('$missingFiles = @()');
    Lines.Add('foreach ($f in $required) {');
    Lines.Add('    $p = Join-Path $GenDir $f');
    Lines.Add('    if (-not (Test-Path -LiteralPath $p)) { $missingFiles += $f }');
    Lines.Add('}');
    Lines.Add('if ($missingFiles.Count -gt 0) {');
    Lines.Add('    Write-Fail "Missing generated files in $GenDir :"');
    Lines.Add('    foreach ($m in $missingFiles) { Write-Host "        $m" }');
    Lines.Add('    Write-Fail "Run code_decl_to_abi --lang http_ts first."');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('Write-Ok "Generated files present"');
    Lines.Add('');
    Lines.Add('$tsconfigPath = Join-Path $GenDir "tsconfig.json"');
    Lines.Add('$tsconfigOverwritten = $false');
    Lines.Add('if ((Test-Path -LiteralPath $tsconfigPath) -and (-not $Force)) {');
    Lines.Add('    Write-Warn "tsconfig.json already exists; keeping it (use -Force to overwrite)."');
    Lines.Add('    try {');
    Lines.Add('        $tsjson = Get-Content -LiteralPath $tsconfigPath -Raw -Encoding UTF8 | ConvertFrom-Json');
    Lines.Add('        if ($tsjson.compilerOptions) {');
    Lines.Add('            if ($tsjson.compilerOptions.noEmit -eq $true -and $Compiled) {');
    Lines.Add('                Write-Warn "tsconfig.json has noEmit=true but -Compiled was requested."');
    Lines.Add('                Write-Warn "The tsc compile step will fail. Re-run with -Force to regenerate."');
    Lines.Add('            }');
    Lines.Add('            if ($tsjson.compilerOptions.module -and $tsjson.compilerOptions.module -ne "commonjs") {');
    Lines.Add('                Write-Warn "tsconfig.json sets module=$($tsjson.compilerOptions.module); lingofuse-ts is CommonJS."');
    Lines.Add('                Write-Warn "Consider module=commonjs or esModuleInterop=true."');
    Lines.Add('            }');
    Lines.Add('            if ($tsjson.compilerOptions.strict -ne $true) {');
    Lines.Add('                Write-Warn "tsconfig.json does not enable strict mode; generated code assumes it."');
    Lines.Add('            }');
    Lines.Add('        }');
    Lines.Add('    } catch {');
    Lines.Add('        Write-Warn "Could not parse existing tsconfig.json: $($_.Exception.Message)"');
    Lines.Add('    }');
    Lines.Add('} else {');
    Lines.Add('    $tsconfigContent = @' + #39);
    Lines.Add('{');
    Lines.Add('  "compilerOptions": {');
    Lines.Add('    "target": "ES2022",');
    Lines.Add('    "module": "commonjs",');
    Lines.Add('    "moduleResolution": "node",');
    Lines.Add('    "strict": true,');
    Lines.Add('    "esModuleInterop": true,');
    Lines.Add('    "skipLibCheck": true,');
    Lines.Add('    "forceConsistentCasingInFileNames": true,');
    Lines.Add('    "resolveJsonModule": true,');
    Lines.Add('    "declaration": false,');
    Lines.Add('    "sourceMap": false,');
    Lines.Add('    "outDir": "dist",');
    Lines.Add('    "rootDir": "."');
    Lines.Add('  },');
    Lines.Add('  "include": ["*.ts"],');
    Lines.Add('  "exclude": ["node_modules", "dist"]');
    Lines.Add('}');
    Lines.Add(#39 + '@');
    Lines.Add('    Write-TextFileNoBom -Path $tsconfigPath -Content $tsconfigContent');
    Lines.Add('    $tsconfigOverwritten = $true');
    Lines.Add('    Write-Ok "tsconfig.json written"');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('$pkgPath = Join-Path $GenDir "package.json"');
    Lines.Add('$lfNormalized = $LingoFuseTs.Replace("\", "/")');
    Lines.Add('$pkgName = "${UnitName}_abi".ToLower() -replace ' + #39 + '[^a-z0-9._~_-]' + #39 + ', ' + #39 + '-' + #39);
    Lines.Add('if ((Test-Path -LiteralPath $pkgPath) -and (-not $Force)) {');
    Lines.Add('    Write-Warn "package.json already exists; keeping it (use -Force to overwrite)."');
    Lines.Add('    try {');
    Lines.Add('        $pj = Get-Content -LiteralPath $pkgPath -Raw -Encoding UTF8 | ConvertFrom-Json');
    Lines.Add('        if ($pj.type -and $pj.type -ne "commonjs") {');
    Lines.Add('            Write-Warn "package.json sets type=$($pj.type); lingofuse-ts is CommonJS."');
    Lines.Add('        }');
    Lines.Add('    } catch {');
    Lines.Add('        Write-Warn "Could not parse existing package.json: $($_.Exception.Message)"');
    Lines.Add('    }');
    Lines.Add('} else {');
    Lines.Add('    $pkgContent = @"');
    Lines.Add('{');
    Lines.Add('  "name": "$pkgName",');
    Lines.Add('  "version": "0.1.0",');
    Lines.Add('  "type": "commonjs",');
    Lines.Add('  "dependencies": {');
    Lines.Add('    "lingofuse-ts": "file:$lfNormalized"');
    Lines.Add('  },');
    Lines.Add('  "devDependencies": {');
    Lines.Add('    "@types/node": "^22.0.0",');
    Lines.Add('    "koffi": "^3.3.2",');
    Lines.Add('    "tsx": "^4.0.0",');
    Lines.Add('    "typescript": "^5.6.0"');
    Lines.Add('  }');
    Lines.Add('}');
    Lines.Add('"@');
    Lines.Add('    Write-TextFileNoBom -Path $pkgPath -Content $pkgContent');
    Lines.Add('    Write-Ok "package.json written (lingofuse-ts -> $lfNormalized)"');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('if (-not $SkipAutoLink) {');
    Lines.Add('    $linked = Ensure-LingofuseTsLinked -LingoFuseTs $LingoFuseTs -GenDir $GenDir');
    Lines.Add('    if (-not $linked) {');
    Lines.Add('        Write-Fail "lingofuse-ts link could not be established; tsc will fail."');
    Lines.Add('        exit 1');
    Lines.Add('    }');
    Lines.Add('} else {');
    Lines.Add('    Write-Info "Skipping auto-link (-SkipAutoLink)."');
    Lines.Add('    $linkPath = Join-Path (Join-Path $GenDir "node_modules") "lingofuse-ts"');
    Lines.Add('    if (-not (Test-Path -LiteralPath $linkPath)) {');
    Lines.Add('        Write-Fail "lingofuse-ts is not present at $linkPath and -SkipAutoLink was set."');
    Lines.Add('        exit 1');
    Lines.Add('    }');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('$nmDir = Join-Path $GenDir "node_modules"');
    Lines.Add('$needInstall = $false');
    Lines.Add('if (-not (Test-Path -LiteralPath $nmDir)) { $needInstall = $true }');
    Lines.Add('if ($tsconfigOverwritten -or -not (Test-Path -LiteralPath (Join-Path $nmDir "lingofuse-ts"))) { $needInstall = $true }');
    Lines.Add('');
    Lines.Add('if (-not $SkipInstall) {');
    Lines.Add('    if ($needInstall) {');
    Lines.Add('        Write-Info "Running npm install in $GenDir ..."');
    Lines.Add('        Push-Location $GenDir');
    Lines.Add('        try {');
    Lines.Add('            $out = & npm install 2>&1');
    Lines.Add('            if ($LASTEXITCODE -ne 0) {');
    Lines.Add('                Write-Fail "npm install failed:"');
    Lines.Add('                $out | ForEach-Object { Write-Host "    $_" }');
    Lines.Add('                exit 1');
    Lines.Add('            }');
    Lines.Add('        } finally {');
    Lines.Add('            Pop-Location');
    Lines.Add('        }');
    Lines.Add('        Write-Ok "npm install done"');
    Lines.Add('    } else {');
    Lines.Add('        Write-Info "Skipping npm install (node_modules and package.json look current)."');
    Lines.Add('    }');
    Lines.Add('} else {');
    Lines.Add('    Write-Info "Skipping npm install (-SkipInstall)."');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('$requiredDevDeps = [ordered]@{');
    Lines.Add('    "typescript"    = "^5.6.0";');
    Lines.Add('    "tsx"           = "^4.0.0";');
    Lines.Add('    "@types/node"   = "^22.0.0";');
    Lines.Add('    "koffi"         = "^3.3.2"');
    Lines.Add('}');
    Lines.Add('$missingDevDeps = @()');
    Lines.Add('foreach ($kv in $requiredDevDeps.GetEnumerator()) {');
    Lines.Add('    $p = Join-Path $nmDir $kv.Key');
    Lines.Add('    if (-not (Test-Path -LiteralPath $p)) {');
    Lines.Add('        $missingDevDeps += "$($kv.Key)@$($kv.Value)"');
    Lines.Add('    }');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('if ($missingDevDeps.Count -gt 0) {');
    Lines.Add('    if ($SkipInstall) {');
    Lines.Add('        Write-Fail "Missing required devDependencies:"');
    Lines.Add('        foreach ($m in $missingDevDeps) { Write-Host "    $m" }');
    Lines.Add('        Write-Fail ""');
    Lines.Add('        Write-Fail "Install them manually:"');
    Lines.Add('        Write-Fail "    cd $GenDir"');
    Lines.Add('        Write-Fail "    npm install --save-dev $($missingDevDeps -join ' + #39 + ' ' + #39 + ')"');
    Lines.Add('        exit 1');
    Lines.Add('    }');
    Lines.Add('    Write-Info "Installing missing devDependencies (no-save): $($missingDevDeps -join ' + #39 + ', ' + #39 + ')"');
    Lines.Add('    Push-Location $GenDir');
    Lines.Add('    try {');
    Lines.Add('        $out = & npm install --no-save $missingDevDeps 2>&1');
    Lines.Add('        if ($LASTEXITCODE -ne 0) {');
    Lines.Add('            Write-Fail "npm install --no-save failed:"');
    Lines.Add('            $out | ForEach-Object { Write-Host "    $_" }');
    Lines.Add('            exit 1');
    Lines.Add('        }');
    Lines.Add('    } finally {');
    Lines.Add('        Pop-Location');
    Lines.Add('    }');
    Lines.Add('    Write-Ok "devDependencies installed"');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('$linkPath = Join-Path $nmDir "lingofuse-ts"');
    Lines.Add('if (-not (Test-Path -LiteralPath $linkPath)) {');
    Lines.Add('    Write-Fail "lingofuse-ts is still missing at $linkPath after auto-link."');
    Lines.Add('    Write-Fail "Run manually:"');
    Lines.Add('    Write-Fail "    cd $LingoFuseTs"');
    Lines.Add('    Write-Fail "    .\install.ps1 -ProjectDir $GenDir"');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('$tsIndexJs = Join-Path $linkPath "dist/index.js"');
    Lines.Add('if (-not (Test-Path -LiteralPath $tsIndexJs)) {');
    Lines.Add('    Write-Fail "lingofuse-ts is linked but dist/index.js is missing."');
    Lines.Add('    Write-Fail "Run build.ps1 inside $LingoFuseTs first."');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('Write-Ok "lingofuse-ts linked and built"');
    Lines.Add('');
    Lines.Add('$tscCli = Join-Path $nmDir "typescript\bin\tsc"');
    Lines.Add('if (-not (Test-Path -LiteralPath $tscCli)) {');
    Lines.Add('    Write-Fail "typescript CLI not found: $tscCli"');
    Lines.Add('    exit 1');
    Lines.Add('}');
    Lines.Add('$tsxCli = Join-Path $nmDir "tsx\dist\cli.mjs"');
    Lines.Add('if (-not $Compiled) {');
    Lines.Add('    if (-not (Test-Path -LiteralPath $tsxCli)) {');
    Lines.Add('        Write-Fail "tsx CLI not found: $tsxCli"');
    Lines.Add('        exit 1');
    Lines.Add('    }');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('Write-Info "Running tsc --noEmit ..."');
    Lines.Add('Push-Location $GenDir');
    Lines.Add('try {');
    Lines.Add('    $tscOut = & $nodeExe $tscCli --noEmit 2>&1');
    Lines.Add('    if ($LASTEXITCODE -ne 0) {');
    Lines.Add('        Write-Fail "tsc --noEmit failed:"');
    Lines.Add('        $tscOut | ForEach-Object { Write-Host "    $_" }');
    Lines.Add('        exit 1');
    Lines.Add('    }');
    Lines.Add('    Write-Ok "tsc --noEmit passed"');
    Lines.Add('} finally {');
    Lines.Add('    Pop-Location');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('if ($Compiled) {');
    Lines.Add('    Write-Info "Running tsc (full compile) ..."');
    Lines.Add('    Push-Location $GenDir');
    Lines.Add('    try {');
    Lines.Add('        $tscOut2 = & $nodeExe $tscCli 2>&1');
    Lines.Add('        if ($LASTEXITCODE -ne 0) {');
    Lines.Add('            Write-Fail "tsc compile failed:"');
    Lines.Add('            $tscOut2 | ForEach-Object { Write-Host "    $_" }');
    Lines.Add('            exit 1');
    Lines.Add('        }');
    Lines.Add('        Write-Ok "tsc compile passed"');
    Lines.Add('    } finally {');
    Lines.Add('        Pop-Location');
    Lines.Add('    }');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('if ($RunSmoke) {');
    Lines.Add('    $svcFile = "${UnitName}_abi_service_test$abiExt"');
    Lines.Add('    $callFile = "${UnitName}_abi_call_test$abiExt"');
    Lines.Add('    Write-Info "Starting $svcFile in the background ..."');
    Lines.Add('    $svcLog = Join-Path $GenDir "smoke_service.out.log"');
    Lines.Add('    $svcErr = Join-Path $GenDir "smoke_service.err.log"');
    Lines.Add('    if ($Compiled) {');
    Lines.Add('        $svcBase = [IO.Path]::GetFileNameWithoutExtension($svcFile)');
    Lines.Add('        $svcLaunch = "dist\$svcBase.js"');
    Lines.Add('        $svcProc = Start-Process -FilePath $nodeExe -ArgumentList @($svcLaunch) -WorkingDirectory $GenDir -PassThru -NoNewWindow -RedirectStandardOutput $svcLog -RedirectStandardError $svcErr');
    Lines.Add('    } else {');
    Lines.Add('        $svcProc = Start-Process -FilePath $nodeExe -ArgumentList @($tsxCli, $svcFile) -WorkingDirectory $GenDir -PassThru -NoNewWindow -RedirectStandardOutput $svcLog -RedirectStandardError $svcErr');
    Lines.Add('    }');
    Lines.Add('    Start-Sleep -Seconds 5');
    Lines.Add('    Push-Location $GenDir');
    Lines.Add('    try {');
    Lines.Add('        Write-Info "Running $callFile ..."');
    Lines.Add('        $rc = Invoke-TsFile $callFile');
    Lines.Add('    } finally {');
    Lines.Add('        Pop-Location');
    Lines.Add('    }');
    Lines.Add('    $rcType = if ($null -eq $rc) { "null" } else { $rc.GetType().Name }');
    Lines.Add('    $rcValue = if ($null -eq $rc) { "null" } else { "$rc" }');
    Lines.Add('    Write-Info "call test exit code: $rcValue (type: $rcType)"');
    Lines.Add('    Start-Sleep -Milliseconds 500');
    Lines.Add('    if ($null -ne $svcProc -and -not $svcProc.HasExited) {');
    Lines.Add('        Stop-Process -Id $svcProc.Id -Force -ErrorAction SilentlyContinue');
    Lines.Add('    }');
    Lines.Add('    $rcInt = 0');
    Lines.Add('    try { $rcInt = [int]$rc } catch { $rcInt = -1 }');
    Lines.Add('    if ($rcInt -ne 0) {');
    Lines.Add('        Write-Fail "call_test failed (exit $rcInt)."');
    Lines.Add('        Write-Fail "        service log: $svcLog"');
    Lines.Add('        Write-Fail "        service err: $svcErr"');
    Lines.Add('        if (Test-Path -LiteralPath $svcLog) {');
    Lines.Add('            Write-Host "----- service.out.log -----" -ForegroundColor DarkGray');
    Lines.Add('            Get-Content -LiteralPath $svcLog | Select-Object -Last 60 | ForEach-Object { Write-Host $_ -ForegroundColor DarkGray }');
    Lines.Add('        }');
    Lines.Add('        if (Test-Path -LiteralPath $svcErr) {');
    Lines.Add('            Write-Host "----- service.err.log -----" -ForegroundColor DarkGray');
    Lines.Add('            Get-Content -LiteralPath $svcErr | Select-Object -Last 60 | ForEach-Object { Write-Host $_ -ForegroundColor DarkGray }');
    Lines.Add('        }');
    Lines.Add('        exit 1');
    Lines.Add('    }');
    Lines.Add('    Write-Ok "smoke test passed"');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('Write-Host ""');
    Lines.Add('Write-Host "Environment is ready." -ForegroundColor Green');
    Lines.Add('Write-Host ""');
    Lines.Add('Write-Host "  Terminal 1 (service):" -ForegroundColor Cyan');
    Lines.Add('Write-Host "      cd `"$GenDir`""');
    Lines.Add('    if ($Compiled) {');
    Lines.Add('        Write-Host "      node dist\${UnitName}_abi_service_test.js"');
    Lines.Add('    } else {');
    Lines.Add('        Write-Host "      node `"$tsxCli`" ${UnitName}_abi_service_test$abiExt"');
    Lines.Add('    }');
    Lines.Add('Write-Host ""');
    Lines.Add('Write-Host "  Terminal 2 (call):" -ForegroundColor Cyan');
    Lines.Add('Write-Host "      cd `"$GenDir`""');
    Lines.Add('    if ($Compiled) {');
    Lines.Add('        Write-Host "      node dist\${UnitName}_abi_call_test.js"');
    Lines.Add('    } else {');
    Lines.Add('        Write-Host "      node `"$tsxCli`" ${UnitName}_abi_call_test$abiExt"');
    Lines.Add('    }');
    Lines.Add('Write-Host ""');
    Lines.Add('Write-Host "The call test exits with code 0 when all tests pass, 2 otherwise." -ForegroundColor DarkGray');
    Lines.Add('Write-Host ""');
    Lines.Add('exit 0');

    Result := Lines;
    Log(PFormat('Generated %d lines for setup_ts_tests.ps1', [Lines.Count]));
  finally
  end;
end;

initialization

  RegisterGenerator(
    'http_ts',
    'setup_ts_tests.ps1',
    gkPs1,
    'TypeScript ABI test environment setup script',
    @GenerateTsTestSetupScript);

end.
