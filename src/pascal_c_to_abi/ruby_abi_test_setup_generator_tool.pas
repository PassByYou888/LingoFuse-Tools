unit ruby_abi_test_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core,
  Z.PascalStrings, Z.UPascalStrings,
  Z.Status, Z.UnicodeMixedLib, Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_abi_registry;

function GenerateRubyTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[ruby_abi_test_setup_generator] %s', [Msg.Text]);
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[ruby_abi_test_setup_generator] %s', [PFormat(Fmt, Args)]);
end;

procedure EmitHeader(Lines: TPascalStringList);
begin
  Lines.Add('#Requires -Version 5.1');
  Lines.Add('# ============================================================================');
  Lines.Add('# setup_ruby_tests.ps1');
  Lines.Add('# AUTO-GENERATED by ruby_abi_test_setup_generator_tool.pas.');
  Lines.Add('# Do not edit by hand: the generator re-emits this file from scratch.');
  Lines.Add('#');
  Lines.Add('# The script:');
  Lines.Add('#   1. Validates ruby, the lingofuse Ruby binding, and the C extension.');
  Lines.Add('#   2. Checks all generated .rb files are present.');
  Lines.Add('#   3. Runs ruby -c syntax checks.');
  Lines.Add('#   4. Scans the .rb files for stale Pascal type names.');
  Lines.Add('#   5. Smoke-loads the service and call modules.');
  Lines.Add('#   6. Prints next-step instructions.');
  Lines.Add('#');
  Lines.Add('# Required:');
  Lines.Add('#   -RubyLibDir    directory that contains lingofuse.rb (the lib/ folder');
  Lines.Add('#                  of the Ruby binding, NOT the binding root).');
  Lines.Add('#');
  Lines.Add('# Optional:');
  Lines.Add('#   -GenDir        directory containing the generated Ruby project');
  Lines.Add('#                  (default: this script directory)');
  Lines.Add('#   -UnitName      source unit name (default: auto-detect)');
  Lines.Add('#   -Help          show this help and exit');
  Lines.Add('#');
  Lines.Add('# Usage:');
  Lines.Add('#   .\setup_ruby_tests.ps1 -RubyLibDir D:\CoreLibrary\LingoFuse\ruby\lib');
  Lines.Add('# ============================================================================');
  Lines.Add('');
  Lines.Add('[CmdletBinding()]');
  Lines.Add('param(');
  Lines.Add('    [string]$RubyLibDir = "",');
  Lines.Add('    [string]$GenDir = "",');
  Lines.Add('    [string]$UnitName = "",');
  Lines.Add('    [switch]$Help');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$ErrorActionPreference = "Stop"');
  Lines.Add('');
  Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
  Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
  Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
  Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
  Lines.Add('');
end;

procedure EmitHelp(Lines: TPascalStringList);
begin
  Lines.Add('if ($Help) {');
  Lines.Add('    Write-Host "Usage: setup_ruby_tests.ps1 -RubyLibDir <path> [options]"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Required:"');
  Lines.Add('    Write-Host "  -RubyLibDir <path>"');
  Lines.Add('    Write-Host "        Directory that resolves lingofuse.rb on LOAD_PATH."');
  Lines.Add('    Write-Host "        This is the lib/ folder of the Ruby binding, NOT the binding root."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Optional:"');
  Lines.Add('    Write-Host "  -GenDir <path>     Directory containing the generated Ruby project."');
  Lines.Add('    Write-Host "  -UnitName <name>   Source unit name (default: auto-detect)."');
  Lines.Add('    Write-Host "  -Help              Show this help."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Exit codes:"');
  Lines.Add('    Write-Host "  0   success (or -Help was requested)"');
  Lines.Add('    Write-Host "  1   validation failed, missing tool, stale .rb, or smoke load failed"');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitValidation(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $RubyLibDir) {');
  Lines.Add('    Write-Fail "-RubyLibDir is required."');
  Lines.Add('    Write-Host "        Run setup_ruby_tests.ps1 -Help for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $RubyLibDir)) {');
  Lines.Add('    Write-Fail "RubyLibDir not found: $RubyLibDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$RubyLibDir = (Resolve-Path -LiteralPath $RubyLibDir).Path');
  Lines.Add('');
  Lines.Add('$lingofuseRb = Join-Path $RubyLibDir "lingofuse.rb"');
  Lines.Add('if (-not (Test-Path -LiteralPath $lingofuseRb)) {');
  Lines.Add('    Write-Fail "lingofuse.rb not found under RubyLibDir:"');
  Lines.Add('    Write-Fail "            $lingofuseRb"');
  Lines.Add('    $altLib = Join-Path $RubyLibDir "lib"');
  Lines.Add('    $altRb = Join-Path $altLib "lingofuse.rb"');
  Lines.Add('    if (Test-Path -LiteralPath $altRb) {');
  Lines.Add('        Write-Host ""');
  Lines.Add('        Write-Warn "Hint: a nested lib/ folder does contain lingofuse.rb:"');
  Lines.Add('        Write-Warn "            $altRb"');
  Lines.Add('        Write-Warn "      -RubyLibDir must point at the lib/ folder, not the binding root."');
  Lines.Add('        Write-Warn "      Retry with:"');
  Lines.Add('        Write-Warn "          setup_ruby_tests.ps1 -RubyLibDir $altLib"');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    Write-Fail "            -RubyLibDir must point at the lib/ folder of the Ruby binding."');
  Lines.Add('    Write-Fail "            Example: -RubyLibDir <repo>/ruby/lib"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not $GenDir) { $GenDir = $PSScriptRoot }');
  Lines.Add('$GenDir = (Resolve-Path -LiteralPath $GenDir).Path');
  Lines.Add('');
  Lines.Add('Write-Info "RubyLibDir   : $RubyLibDir"');
  Lines.Add('Write-Info "GenDir       : $GenDir"');
  Lines.Add('');
end;

procedure EmitToolCheck(Lines: TPascalStringList);
begin
  Lines.Add('$rubyCmd = Get-Command ruby -ErrorAction SilentlyContinue');
  Lines.Add('if ($null -eq $rubyCmd) {');
  Lines.Add('    Write-Fail "ruby is not on PATH."');
  Lines.Add('    Write-Fail "            Install RubyInstaller (x64-mingw-ucrt) with DevKit: https://rubyinstaller.org/"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$rubyVer = (& ruby -v 2>&1) -join ""');
  Lines.Add('Write-Ok "ruby $rubyVer"');
  Lines.Add('');
  Lines.Add('$rubyMajor = (& ruby -e "print RUBY_VERSION.split(' + #39 + '.' + #39 + ')[0]" 2>&1) -join ""');
  Lines.Add('if ([int]$rubyMajor -lt 3) {');
  Lines.Add('    Write-Fail "Ruby $rubyMajor is too old; Ruby 3.0 or newer is required."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "Ruby major version: $rubyMajor"');
  Lines.Add('');
  Lines.Add('$bundleDir = Join-Path $RubyLibDir "lingofuse"');
  Lines.Add('if (-not (Test-Path -LiteralPath $bundleDir)) {');
  Lines.Add('    Write-Fail "lingofuse/ subdirectory not found under RubyLibDir:"');
  Lines.Add('    Write-Fail "            $bundleDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "lingofuse/ subdirectory present."');
  Lines.Add('');
  Lines.Add('$extCandidates = @(');
  Lines.Add('    (Join-Path $RubyLibDir "lingofuse_ext.so"),');
  Lines.Add('    (Join-Path $RubyLibDir "lingofuse_ext.dll"),');
  Lines.Add('    (Join-Path $RubyLibDir "lingofuse_ext.bundle")');
  Lines.Add(')');
  Lines.Add('$extFound = $false');
  Lines.Add('foreach ($p in $extCandidates) {');
  Lines.Add('    if (Test-Path -LiteralPath $p) {');
  Lines.Add('        $extFound = $true');
  Lines.Add('        Write-Ok "lingofuse_ext present: $(Split-Path -Leaf $p)"');
  Lines.Add('        break');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('if (-not $extFound) {');
  Lines.Add('    Write-Fail "lingofuse_ext shared library is not installed under RubyLibDir."');
  Lines.Add('    Write-Fail "            Build it with:"');
  Lines.Add('    Write-Fail "                cd <binding>/ruby"');
  Lines.Add('    Write-Fail "                .\setup_build_env.ps1"');
  Lines.Add('    Write-Fail "            This script compiles ext/lingofuse_ext and copies the produced"');
  Lines.Add('    Write-Fail "            lingofuse_ext.so into lib/."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitLoadCheck(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Probing lingofuse binding ..."');
  Lines.Add('');
  Lines.Add('$probe = "begin; require ' + #39 + 'lingofuse' + #39 + '; " +');
  Lines.Add('         "abort(' + #39 + 'lingofuse_ext not loaded' + #39 + ') unless LingoFuse::NativeBridge.available?; " +');
  Lines.Add('         "abort(' + #39 + 'native library not loaded' + #39 + ') unless LingoFuse.loaded?; " +');
  Lines.Add('         "puts(' + #39 + 'LOADED:' + #39 + ' + LingoFuse.library_name); " +');
  Lines.Add('         "rescue LoadError => e; abort(' + #39 + 'LoadError: ' + #39 + ' + e.message); " +');
  Lines.Add('         "end"');
  Lines.Add('$probeOut = (& ruby -I $RubyLibDir -e $probe 2>&1) -join "`n"');
  Lines.Add('if ($LASTEXITCODE -ne 0) {');
  Lines.Add('    Write-Fail "lingofuse load probe failed:"');
  Lines.Add('    foreach ($line in ($probeOut -split "`n")) { Write-Host "        $line" }');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('foreach ($line in ($probeOut -split "`n")) {');
  Lines.Add('    if ($line.Trim()) { Write-Info $line }');
  Lines.Add('}');
  Lines.Add('Write-Ok "lingofuse binding and native library are ready."');
  Lines.Add('');
end;

procedure EmitUnitNameDetect(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $UnitName) {');
  Lines.Add('    $cand = Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue |');
  Lines.Add('        Where-Object { $_.DirectoryName -eq $GenDir -and $_.Name -like "*_abi_service.rb" } |');
  Lines.Add('        Select-Object -First 1');
  Lines.Add('    if ($null -ne $cand) {');
  Lines.Add('        $base = $cand.Name -replace ' + #39 + '_abi_service\.rb$' + #39 + ', ' + #39 + #39);
  Lines.Add('        if ($base -match ' + #39 + '^(.+)_abi$' + #39 + ') {');
  Lines.Add('            $UnitName = $matches[1]');
  Lines.Add('        } else {');
  Lines.Add('            $UnitName = $base');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('    if (-not $UnitName) {');
  Lines.Add('        Write-Fail "Cannot auto-detect UnitName (no *_abi_service.rb under GenDir)."');
  Lines.Add('        Write-Fail "            Pass -UnitName explicitly."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('Write-Info "UnitName     : $UnitName"');
  Lines.Add('');
end;

procedure EmitLayout(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Checking generated Ruby sources ..."');
  Lines.Add('');
  Lines.Add('$requiredPatterns = @(');
  Lines.Add('    "*_abi_service.rb",');
  Lines.Add('    "*_abi_call.rb",');
  Lines.Add('    "*_abi_service_test.rb",');
  Lines.Add('    "*_abi_call_test.rb"');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$missing = @()');
  Lines.Add('foreach ($pattern in $requiredPatterns) {');
  Lines.Add('    $found = @(Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue |');
  Lines.Add('        Where-Object { $_.DirectoryName -eq $GenDir -and $_.Name -like $pattern })');
  Lines.Add('    if ($found.Count -eq 0) {');
  Lines.Add('        $missing += $pattern');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('if ($missing.Count -gt 0) {');
  Lines.Add('    Write-Fail "Missing generated Ruby source files under GenDir:"');
  Lines.Add('    foreach ($m in $missing) { Write-Host "        $m" }');
  Lines.Add('    Write-Fail "Re-run the generator to produce the missing .rb files."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "All generated Ruby source files present."');
  Lines.Add('');
end;

procedure EmitSyntaxCheck(Lines: TPascalStringList);
begin
  Lines.Add('$syntaxTargets = @(');
  Lines.Add('    "*_abi_service.rb",');
  Lines.Add('    "*_abi_call.rb",');
  Lines.Add('    "*_abi_service_test.rb",');
  Lines.Add('    "*_abi_call_test.rb"');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$syntaxFailures = @()');
  Lines.Add('foreach ($pattern in $syntaxTargets) {');
  Lines.Add('    $files = @(Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue |');
  Lines.Add('        Where-Object { $_.DirectoryName -eq $GenDir -and $_.Name -like $pattern })');
  Lines.Add('    foreach ($f in $files) {');
  Lines.Add('        $checkOut = (& ruby -c $f.FullName 2>&1) -join "`n"');
  Lines.Add('        if ($LASTEXITCODE -ne 0) {');
  Lines.Add('            Write-Fail "Syntax error: $($f.Name)"');
  Lines.Add('            foreach ($line in ($checkOut -split "`n")) { Write-Host "        $line" }');
  Lines.Add('            $syntaxFailures += $f.Name');
  Lines.Add('        } else {');
  Lines.Add('            Write-Ok "Syntax OK: $($f.Name)"');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('if ($syntaxFailures.Count -gt 0) {');
  Lines.Add('    Write-Fail "One or more .rb files failed the syntax check."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitStaleCheck(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Scanning for stale Pascal type names ..."');
  Lines.Add('');
  Lines.Add('$staleNameList = ' + #39 + 'cardinal,smallint,uint64,longword,ansistring,unicodestring,tpascalstring,tupascalstring,int64,int32,uint32,uint16' + #39);
  Lines.Add('$staleNames = $staleNameList.Split(' + #39 + ',' + #39 + ')');
  Lines.Add('');
  Lines.Add('$staleHits = @()');
  Lines.Add('$rbFiles = @(Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue |');
  Lines.Add('    Where-Object { $_.DirectoryName -eq $GenDir -and $_.Name -like "*_abi_*.rb" })');
  Lines.Add('foreach ($f in $rbFiles) {');
  Lines.Add('    $text = Get-Content -LiteralPath $f.FullName -Raw');
  Lines.Add('    foreach ($n in $staleNames) {');
  Lines.Add('        $pattern = ' + #39 + '(?i)\b' + #39 + ' + [regex]::Escape($n) + ' + #39 + '\b' + #39);
  Lines.Add('        if ($text -match $pattern) {');
  Lines.Add('            $staleHits += ($f.Name + " :: " + $n)');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('if ($staleHits.Count -gt 0) {');
  Lines.Add('    Write-Fail "Stale Pascal type names detected in generated Ruby:"');
  Lines.Add('    foreach ($h in $staleHits) { Write-Host "        $h" }');
  Lines.Add('    Write-Fail "Re-run the generator to regenerate the .rb files."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "No stale Pascal type names in generated Ruby."');
  Lines.Add('');
end;

procedure EmitSmoke(Lines: TPascalStringList);
var
  Inner: TP_String;
begin
  Lines.Add('Write-Info "Smoke-loading generated Ruby modules ..."');
  Lines.Add('');
  Inner := 'begin; require ' + #39 + '$($UnitName)_abi_service' + #39 +
           '; require ' + #39 + '$($UnitName)_abi_call' + #39 +
           '; puts(' + #39 + 'SMOKE_OK' + #39 + ')' +
           '; rescue Exception => e; abort(' + #39 + 'Smoke load failed: ' + #39 +
           ' + e.class.to_s + ' + #39 + ': ' + #39 + ' + e.message); end';
  Lines.Add('$smoke = "' + Inner + '"');
  Lines.Add('$smokeOut = (& ruby -I $RubyLibDir -I $GenDir -e $smoke 2>&1) -join "`n"');
  Lines.Add('if ($LASTEXITCODE -ne 0) {');
  Lines.Add('    Write-Fail "Smoke load failed:"');
  Lines.Add('    foreach ($line in ($smokeOut -split "`n")) { Write-Host "        $line" }');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('foreach ($line in ($smokeOut -split "`n")) {');
  Lines.Add('    if ($line.Trim()) { Write-Info $line }');
  Lines.Add('}');
  Lines.Add('Write-Ok "Smoke load passed."');
  Lines.Add('');
end;

procedure EmitNextSteps(Lines: TPascalStringList);
begin
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Environment is ready." -ForegroundColor Green');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Terminal 1 (service):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      cd `"$GenDir`""');
  Lines.Add('Write-Host "      ruby -I `"$RubyLibDir`" -I `"$GenDir`" $($UnitName)_abi_service_test.rb"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Terminal 2 (call):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      cd `"$GenDir`""');
  Lines.Add('Write-Host "      ruby -I `"$RubyLibDir`" -I `"$GenDir`" $($UnitName)_abi_call_test.rb"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  The call test prints [PASS] / [FAIL] / [SKIP] lines and exits"');
  Lines.Add('Write-Host "  with code 0 on success or 2 on failure."');
  Lines.Add('Write-Host ""');
  Lines.Add('exit 0');
end;

function GenerateRubyTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
begin
  Result := nil;
  if Model = nil then
  begin
    Log('Model is nil');
    Exit;
  end;

  Lines := TPascalStringList.Create;
  try
    EmitHeader(Lines);
    EmitHelp(Lines);
    EmitValidation(Lines);
    EmitToolCheck(Lines);
    EmitLoadCheck(Lines);
    EmitUnitNameDetect(Lines);
    EmitLayout(Lines);
    EmitSyntaxCheck(Lines);
    EmitStaleCheck(Lines);
    EmitSmoke(Lines);
    EmitNextSteps(Lines);
    Result := Lines;
    Log('Generated setup_ruby_tests.ps1');
  finally
    if Result <> Lines then
      Lines.Free;
  end;
end;

initialization

  RegisterGenerator(
    'ruby',
    'setup_ruby_tests.ps1',
    gkPs1,
    'Ruby ABI test environment setup script',
    @GenerateRubyTestSetupScript);

end.
