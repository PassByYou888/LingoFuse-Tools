unit zig_abi_test_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core,
  Z.PascalStrings, Z.UPascalStrings, Z.Parsing,
  Z.Status, Z.UnicodeMixedLib, Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_abi_registry;

function GenerateZigTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

const
  CH_SQ: string = #39;

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[zig_abi_test_setup_generator] %s', [Msg.Text]);
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[zig_abi_test_setup_generator] %s', [PFormat(Fmt, Args)]);
end;

function MakeApiName(const FuncName: TP_String): TP_String;
begin
  Result := FuncName.ReplaceChar(#32#9'./\@', '_');
end;

procedure EmitHeader(Lines: TPascalStringList);
begin
  Lines.Add('#Requires -Version 5.1');
  Lines.Add('# ============================================================================');
  Lines.Add('# setup_zig_tests.ps1');
  Lines.Add('# AUTO-GENERATED by zig_abi_test_setup_generator_tool.pas.');
  Lines.Add('# Do not edit by hand: the generator re-emits this file from scratch.');
  Lines.Add('#');
  Lines.Add('# One-shot Zig test environment bootstrap.');
  Lines.Add('#');
  Lines.Add('# What this script DOES:');
  Lines.Add('#   1. Validates the lingofuse Zig package and the generated sources.');
  Lines.Add('#   2. Copies the generated .zig files into src/ (original names preserved).');
  Lines.Add('#   3. Creates build.zig and build.zig.zon if missing.');
  Lines.Add('#   4. Points build.zig.zon at the lingofuse package (relative path).');
  Lines.Add('#   5. Runs "zig build" (auto-fixes the package fingerprint if needed).');
  Lines.Add('#');
  Lines.Add('# What this script does NOT do:');
  Lines.Add('#   - It does NOT start the service or the call test.');
  Lines.Add('#   - The caller launches them manually (see "Next steps" at the end).');
  Lines.Add('#');
  Lines.Add('# Required:');
  Lines.Add('#   -LingofuseDir  path to the lingofuse Zig package source directory');
  Lines.Add('#                  (must contain build.zig, build.zig.zon, src/lingofuse.zig)');
  Lines.Add('#                  (must be on the same drive as GenDir)');
  Lines.Add('#');
  Lines.Add('# Optional:');
  Lines.Add('#   -GenDir        directory containing the generated Zig project');
  Lines.Add('#                  (default: this script directory)');
  Lines.Add('#   -UnitName      source unit name (default: auto-detect)');
  Lines.Add('#   -Force         force-copy generated files even if older,');
  Lines.Add('#                  and overwrite an existing build.zig / build.zig.zon');
  Lines.Add('#   -RunSmoke      after build, verify each executable can be invoked with --help');
  Lines.Add('#   -Help          show this help and exit');
  Lines.Add('#');
  Lines.Add('# Usage:');
  Lines.Add('#   .\setup_zig_tests.ps1 -LingofuseDir D:\CoreLibrary\LingoFuse\zig');
  Lines.Add('#   .\setup_zig_tests.ps1 -LingofuseDir D:\CoreLibrary\LingoFuse\zig -RunSmoke');
  Lines.Add('# ============================================================================');
  Lines.Add('');
  Lines.Add('[CmdletBinding()]');
  Lines.Add('param(');
  Lines.Add('    [string]$LingofuseDir = "",');
  Lines.Add('    [string]$GenDir = "",');
  Lines.Add('    [string]$UnitName = "",');
  Lines.Add('    [switch]$Force,');
  Lines.Add('    [switch]$RunSmoke,');
  Lines.Add('    [switch]$Help');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$ErrorActionPreference = "Stop"');
  Lines.Add('');
  Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
  Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
  Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
  Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
  Lines.Add('');
  Lines.Add('function Write-TextFileNoBom {');
  Lines.Add('    param([string]$Path, [string]$Content)');
  Lines.Add('    $utf8NoBom = New-Object System.Text.UTF8Encoding $false');
  Lines.Add('    [IO.File]::WriteAllText($Path, $Content, $utf8NoBom)');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('function Get-RelativeDirPath {');
  Lines.Add('    param([string]$From, [string]$To)');
  Lines.Add('    $fromFull = [System.IO.Path]::GetFullPath($From).Replace([string][char]92, [string][char]47).TrimEnd(''/'')');
  Lines.Add('    $toFull   = [System.IO.Path]::GetFullPath($To).Replace([string][char]92, [string][char]47).TrimEnd(''/'')');
  Lines.Add('    $fromParts = $fromFull -split ''/''');
  Lines.Add('    $toParts   = $toFull -split ''/''');
  Lines.Add('    if ($fromParts.Length -eq 0 -or $toParts.Length -eq 0) { return $To }');
  Lines.Add('    if ($fromParts[0] -ne $toParts[0]) { return $To }');
  Lines.Add('    $common = 0');
  Lines.Add('    $minLen = [Math]::Min($fromParts.Length, $toParts.Length)');
  Lines.Add('    for ($i = 0; $i -lt $minLen; $i++) {');
  Lines.Add('        if ($fromParts[$i] -eq $toParts[$i]) { $common++ } else { break }');
  Lines.Add('    }');
  Lines.Add('    $upCount = $fromParts.Length - $common');
  Lines.Add('    $result = @()');
  Lines.Add('    for ($i = 0; $i -lt $upCount; $i++) { $result += ''..'' }');
  Lines.Add('    if ($common -lt $toParts.Length) {');
  Lines.Add('        for ($i = $common; $i -lt $toParts.Length; $i++) { $result += $toParts[$i] }');
  Lines.Add('    }');
  Lines.Add('    if ($result.Length -eq 0) { return ''.'' }');
  Lines.Add('    return ($result -join ''/'')');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitHelp(Lines: TPascalStringList);
begin
  Lines.Add('if ($Help) {');
  Lines.Add('    Write-Host "Usage: setup_zig_tests.ps1 -LingofuseDir <path> [options]"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "One-shot Zig test environment bootstrap."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Required:"');
  Lines.Add('    Write-Host "  -LingofuseDir <path>"');
  Lines.Add('    Write-Host "        Path to the lingofuse Zig package source directory."');
  Lines.Add('    Write-Host "        Must contain build.zig, build.zig.zon, src/lingofuse.zig."');
  Lines.Add('    Write-Host "        Must be on the same drive as GenDir."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Optional:"');
  Lines.Add('    Write-Host "  -GenDir <path>     Directory containing the generated Zig project."');
  Lines.Add('    Write-Host "                     Default: this script directory."');
  Lines.Add('    Write-Host "  -UnitName <name>   Source unit name (default: auto-detect)."');
  Lines.Add('    Write-Host "  -Force             Force-copy generated files even if older."');
  Lines.Add('    Write-Host "  -RunSmoke          After build, run each executable with --help."');
  Lines.Add('    Write-Host "  -Help              Show this help."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "This script does NOT start the service or the call test."');
  Lines.Add('    Write-Host "It only prepares the environment and builds the executables."');
  Lines.Add('    Write-Host "See the printed Next Steps for the manual startup commands."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Exit codes:"');
  Lines.Add('    Write-Host "  0   success (or -Help was requested)"');
  Lines.Add('    Write-Host "  1   validation failed, missing tool, stale .zig, or build failed"');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitValidation(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $LingofuseDir) {');
  Lines.Add('    Write-Fail "-LingofuseDir is required."');
  Lines.Add('    Write-Host "        Run setup_zig_tests.ps1 -Help for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $LingofuseDir)) {');
  Lines.Add('    Write-Fail "LingofuseDir not found: $LingofuseDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$LingofuseDir = (Resolve-Path -LiteralPath $LingofuseDir).Path');
  Lines.Add('');
  Lines.Add('$lfBuildZig = Join-Path $LingofuseDir "build.zig"');
  Lines.Add('if (-not (Test-Path -LiteralPath $lfBuildZig)) {');
  Lines.Add('    Write-Fail "Missing build.zig in LingofuseDir:"');
  Lines.Add('    Write-Fail "            $lfBuildZig"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$lfBuildZon = Join-Path $LingofuseDir "build.zig.zon"');
  Lines.Add('if (-not (Test-Path -LiteralPath $lfBuildZon)) {');
  Lines.Add('    Write-Fail "Missing build.zig.zon in LingofuseDir:"');
  Lines.Add('    Write-Fail "            $lfBuildZon"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$lfLibZig = Join-Path $LingofuseDir "src/lingofuse.zig"');
  Lines.Add('if (-not (Test-Path -LiteralPath $lfLibZig)) {');
  Lines.Add('    Write-Fail "Missing src/lingofuse.zig in LingofuseDir:"');
  Lines.Add('    Write-Fail "            $lfLibZig"');
  Lines.Add('    Write-Fail "            -LingofuseDir does not look like the lingofuse package source."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not $GenDir) { $GenDir = $PSScriptRoot }');
  Lines.Add('$GenDir = (Resolve-Path -LiteralPath $GenDir).Path');
  Lines.Add('');
  Lines.Add('$relativeLingofuse = Get-RelativeDirPath -From $GenDir -To $LingofuseDir');
  Lines.Add('');
  Lines.Add('if ($relativeLingofuse -match ''^[A-Za-z]:'') {');
  Lines.Add('    Write-Fail "LingofuseDir and GenDir are on different drives."');
  Lines.Add('    Write-Fail "  GenDir       : $GenDir"');
  Lines.Add('    Write-Fail "  LingofuseDir : $LingofuseDir"');
  Lines.Add('    Write-Fail "Zig build.zig.zon requires a relative path; cross-drive paths are not supported."');
  Lines.Add('    Write-Fail "Please move the generated project or the lingofuse package to the same drive."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('Write-Info "LingofuseDir : $LingofuseDir"');
  Lines.Add('Write-Info "GenDir       : $GenDir"');
  Lines.Add('Write-Info "Relative dep : $relativeLingofuse"');
  Lines.Add('');
end;

procedure EmitToolCheck(Lines: TPascalStringList);
begin
  Lines.Add('$zigCmd = Get-Command zig -ErrorAction SilentlyContinue');
  Lines.Add('if ($null -eq $zigCmd) {');
  Lines.Add('    Write-Fail "zig is not on PATH."');
  Lines.Add('    Write-Fail "            Install Zig 0.17.0 from https://ziglang.org/download/"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$zigVer = (& zig version 2>&1) -join ""');
  Lines.Add('Write-Ok "zig $zigVer"');
  Lines.Add('');
  Lines.Add('if ($zigVer -notmatch "^0\.(1[5-9]|[2-9][0-9])\.") {');
  Lines.Add('    Write-Warn "Unexpected zig version: $zigVer (expected 0.17.x or newer)"');
  Lines.Add('    Write-Warn "The generated build.zig.zon declares minimum_zig_version 0.17.0."');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitUnitNameDetect(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $UnitName) {');
  Lines.Add('    $cand = Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue |');
  Lines.Add('        Where-Object { $_.DirectoryName -eq $GenDir -and $_.Name -like "*_abi_service.zig" } |');
  Lines.Add('        Select-Object -First 1');
  Lines.Add('    if ($null -ne $cand) {');
  Lines.Add('        $UnitName = $cand.Name -replace "_abi_service\.zig$", ""');
  Lines.Add('    }');
  Lines.Add('    if (-not $UnitName) {');
  Lines.Add('        Write-Fail "Cannot auto-detect UnitName (no *_abi_service.zig found)."');
  Lines.Add('        Write-Fail "            Pass -UnitName explicitly."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('Write-Info "UnitName     : $UnitName"');
  Lines.Add('');
end;

procedure EmitLayout(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Copying generated .zig files into src/ (original names preserved) ..."');
  Lines.Add('');
  Lines.Add('$srcDir = Join-Path $GenDir "src"');
  Lines.Add('if (-not (Test-Path -LiteralPath $srcDir)) {');
  Lines.Add('    New-Item -ItemType Directory -Path $srcDir | Out-Null');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$patterns = @(');
  Lines.Add('    "*_abi_service_test.zig",');
  Lines.Add('    "*_abi_call_test.zig",');
  Lines.Add('    "*_abi_service.zig",');
  Lines.Add('    "*_abi_call.zig"');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('foreach ($pattern in $patterns) {');
  Lines.Add('    $candidates = @(Get-ChildItem -LiteralPath $GenDir -File -ErrorAction SilentlyContinue |');
  Lines.Add('        Where-Object { $_.DirectoryName -eq $GenDir -and $_.Name -like $pattern })');
  Lines.Add('    if ($candidates.Count -eq 0) {');
  Lines.Add('        Write-Info ("  no source candidate for pattern " + $pattern)');
  Lines.Add('        continue');
  Lines.Add('    }');
  Lines.Add('    $srcItem = $candidates[0]');
  Lines.Add('    $dst = Join-Path $srcDir $srcItem.Name');
  Lines.Add('    $doCopy = $true');
  Lines.Add('    if (Test-Path -LiteralPath $dst) {');
  Lines.Add('        $srcMtime = $srcItem.LastWriteTime');
  Lines.Add('        $dstMtime = (Get-Item -LiteralPath $dst).LastWriteTime');
  Lines.Add('        if ($srcMtime -le $dstMtime -and -not $Force) {');
  Lines.Add('            Write-Info ("  src/" + $srcItem.Name + " is up-to-date (skip)")');
  Lines.Add('            $doCopy = $false');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('    if ($doCopy) {');
  Lines.Add('        Copy-Item -LiteralPath $srcItem.FullName -Destination $dst -Force');
  Lines.Add('        Write-Info ("  " + $srcItem.Name + " -> src/" + $srcItem.Name)');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitScaffold(Lines: TPascalStringList);
begin
  Lines.Add('$buildZigPath = Join-Path $GenDir "build.zig"');
  Lines.Add('$buildZonPath = Join-Path $GenDir "build.zig.zon"');
  Lines.Add('');
  Lines.Add('$needBuildZig = (-not (Test-Path -LiteralPath $buildZigPath)) -or $Force');
  Lines.Add('if ($needBuildZig) {');
  Lines.Add('    $buildZigContent = @"');
  Lines.Add('const std = @import("std");');
  Lines.Add('');
  Lines.Add('pub fn build(b: *std.Build) void {');
  Lines.Add('    const target = b.standardTargetOptions(.{});');
  Lines.Add('    const optimize = b.standardOptimizeOption(.{});');
  Lines.Add('');
  Lines.Add('    const lf_dep = b.dependency("lingofuse", .{');
  Lines.Add('        .target = target,');
  Lines.Add('        .optimize = optimize,');
  Lines.Add('    });');
  Lines.Add('    const lf_mod = lf_dep.module("lingofuse");');
  Lines.Add('');
  Lines.Add('    const service_lib_mod = b.createModule(.{');
  Lines.Add('        .root_source_file = b.path("src/${UnitName}_abi_service.zig"),');
  Lines.Add('        .target = target,');
  Lines.Add('        .optimize = optimize,');
  Lines.Add('    });');
  Lines.Add('    service_lib_mod.addImport("lingofuse", lf_mod);');
  Lines.Add('');
  Lines.Add('    const call_lib_mod = b.createModule(.{');
  Lines.Add('        .root_source_file = b.path("src/${UnitName}_abi_call.zig"),');
  Lines.Add('        .target = target,');
  Lines.Add('        .optimize = optimize,');
  Lines.Add('    });');
  Lines.Add('    call_lib_mod.addImport("lingofuse", lf_mod);');
  Lines.Add('');
  Lines.Add('    const service_test_mod = b.createModule(.{');
  Lines.Add('        .root_source_file = b.path("src/${UnitName}_abi_service_test.zig"),');
  Lines.Add('        .target = target,');
  Lines.Add('        .optimize = optimize,');
  Lines.Add('    });');
  Lines.Add('    service_test_mod.addImport("lingofuse", lf_mod);');
  Lines.Add('    service_test_mod.addImport("${UnitName}_abi_service", service_lib_mod);');
  Lines.Add('');
  Lines.Add('    const service_test_exe = b.addExecutable(.{');
  Lines.Add('        .name = "${UnitName}_abi_service_test",');
  Lines.Add('        .root_module = service_test_mod,');
  Lines.Add('    });');
  Lines.Add('    b.installArtifact(service_test_exe);');
  Lines.Add('');
  Lines.Add('    const call_test_mod = b.createModule(.{');
  Lines.Add('        .root_source_file = b.path("src/${UnitName}_abi_call_test.zig"),');
  Lines.Add('        .target = target,');
  Lines.Add('        .optimize = optimize,');
  Lines.Add('    });');
  Lines.Add('    call_test_mod.addImport("lingofuse", lf_mod);');
  Lines.Add('    call_test_mod.addImport("${UnitName}_abi_call", call_lib_mod);');
  Lines.Add('');
  Lines.Add('    const call_test_exe = b.addExecutable(.{');
  Lines.Add('        .name = "${UnitName}_abi_call_test",');
  Lines.Add('        .root_module = call_test_mod,');
  Lines.Add('    });');
  Lines.Add('    b.installArtifact(call_test_exe);');
  Lines.Add('}');
  Lines.Add('"@');
  Lines.Add('    Write-TextFileNoBom -Path $buildZigPath -Content $buildZigContent');
  Lines.Add('    Write-Info "  Created build.zig"');
  Lines.Add('} else {');
  Lines.Add('    Write-Info "  build.zig already exists (skip; use -Force to overwrite)"');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$needBuildZon = (-not (Test-Path -LiteralPath $buildZonPath)) -or $Force');
  Lines.Add('if ($needBuildZon) {');
  Lines.Add('    $unitSnake = ($UnitName -creplace ''([a-z0-9])([A-Z])'', ''$1_$2'').ToLower()');
  Lines.Add('    $buildZonContent = @"');
  Lines.Add('.{');
  Lines.Add('    .name = .${unitSnake}_abi,');
  Lines.Add('    .version = "0.1.0",');
  Lines.Add('    .fingerprint = 0x0,');
  Lines.Add('    .minimum_zig_version = "0.17.0",');
  Lines.Add('    .dependencies = .{');
  Lines.Add('        .lingofuse = .{ .path = "${relativeLingofuse}" },');
  Lines.Add('    },');
  Lines.Add('    .paths = .{ "build.zig", "build.zig.zon", "src" },');
  Lines.Add('}');
  Lines.Add('"@');
  Lines.Add('    Write-TextFileNoBom -Path $buildZonPath -Content $buildZonContent');
  Lines.Add('    Write-Info "  Created build.zig.zon"');
  Lines.Add('} else {');
  Lines.Add('    Write-Info "  build.zig.zon already exists (skip; use -Force to overwrite)"');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitPatchZon(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Patching build.zig.zon to point at the lingofuse package (relative path) ..."');
  Lines.Add('');
  Lines.Add('$buildZonPath = Join-Path $GenDir "build.zig.zon"');
  Lines.Add('$zonContent = Get-Content -LiteralPath $buildZonPath -Raw');
  Lines.Add('$oldContent = $zonContent');
  Lines.Add('$replacement = ''.lingofuse = .{ .path = "'' + $relativeLingofuse + ''" },''');
  Lines.Add('$safeReplacement = $replacement.Replace(''$'', ''$$'')');
  Lines.Add('');
  Lines.Add('if ($zonContent -match ''\.lingofuse\s*=\s*\.\{[^}]*\.path\s*='') {');
  Lines.Add('    $zonContent = $zonContent -replace ''\.lingofuse\s*=\s*\.\{[^}]*\.path\s*=\s*"[^"]*"\s*\},'', $safeReplacement');
  Lines.Add('    if ($zonContent -ne $oldContent) {');
  Lines.Add('        Write-TextFileNoBom -Path $buildZonPath -Content $zonContent');
  Lines.Add('        Write-Ok ("  Patched: lingofuse -> " + $relativeLingofuse)');
  Lines.Add('    } else {');
  Lines.Add('        Write-Ok ("  Already up-to-date: lingofuse -> " + $relativeLingofuse)');
  Lines.Add('    }');
  Lines.Add('} else {');
  Lines.Add('    if ($zonContent -notmatch ''(?s)\.dependencies\s*=\s*\.\{'') {');
  Lines.Add('        $zonContent = $zonContent.TrimEnd() + [Environment]::NewLine + ''    .dependencies = .{},'' + [Environment]::NewLine');
  Lines.Add('    }');
  Lines.Add('    $zonContent = $zonContent -replace ''\.dependencies\s*=\s*\.\{,'' , ".dependencies = .{" + [Environment]::NewLine + "        " + $replacement');
  Lines.Add('    Write-TextFileNoBom -Path $buildZonPath -Content $zonContent');
  Lines.Add('    Write-Ok ("  Appended: lingofuse -> " + $relativeLingofuse)');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitStaleCleanup(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Cleaning stale build artifacts ..."');
  Lines.Add('');
  Lines.Add('$staleDirs = @(".zig-cache", "zig-out")');
  Lines.Add('foreach ($d in $staleDirs) {');
  Lines.Add('    $p = Join-Path $GenDir $d');
  Lines.Add('    if (Test-Path -LiteralPath $p) {');
  Lines.Add('        Write-Info ("  Removing " + $d)');
  Lines.Add('        Remove-Item -LiteralPath $p -Recurse -Force');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitSanityCheck(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Sanity-checking generated .zig files for stale Pascal type names ..."');
  Lines.Add('');
  Lines.Add('$zigFiles = @(');
  Lines.Add('    "src/${UnitName}_abi_service.zig",');
  Lines.Add('    "src/${UnitName}_abi_call.zig",');
  Lines.Add('    "src/${UnitName}_abi_service_test.zig",');
  Lines.Add('    "src/${UnitName}_abi_call_test.zig"');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$stalePattern = ' + CH_SQ + '(?m)^\s*(const|var)\s+\w+\s*:\s*(integer|double|single|extended|real|smallint|shortint|cardinal|uint64|word|byte|longint|ansistring|unicodestring|pchar|pansichar|pwidechar)\s*=' + CH_SQ);
  Lines.Add('');
  Lines.Add('$staleFiles = @()');
  Lines.Add('foreach ($rel in $zigFiles) {');
  Lines.Add('    $p = Join-Path $GenDir $rel');
  Lines.Add('    if (-not (Test-Path -LiteralPath $p)) { continue }');
  Lines.Add('    $c = Get-Content -LiteralPath $p -Raw');
  Lines.Add('    if ($c -match $stalePattern) {');
  Lines.Add('        $staleFiles += $rel');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if ($staleFiles.Count -gt 0) {');
  Lines.Add('    Write-Fail "Stale Zig files detected (Pascal type names in bindings):"');
  Lines.Add('    foreach ($s in $staleFiles) { Write-Host "        $s" }');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Fail "These .zig files were produced by an OLD Zig generator."');
  Lines.Add('    Write-Fail "setup_zig_tests.ps1 only copies/patches files; it never re-generates."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Fail "You must run these steps IN ORDER:"');
  Lines.Add('    Write-Fail "  1. rebuild code_decl_to_abi"');
  Lines.Add('    Write-Fail "  2. run code_decl_to_abi again to re-emit the .zig files"');
  Lines.Add('    Write-Fail "  3. run setup_zig_tests.ps1 again"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "Sanity check passed: no Pascal type names in Zig bindings."');
  Lines.Add('');
end;

procedure EmitFileCheck(Lines: TPascalStringList);
begin
  Lines.Add('$requiredFiles = @(');
  Lines.Add('    "build.zig",');
  Lines.Add('    "build.zig.zon",');
  Lines.Add('    "src/${UnitName}_abi_service.zig",');
  Lines.Add('    "src/${UnitName}_abi_call.zig",');
  Lines.Add('    "src/${UnitName}_abi_service_test.zig",');
  Lines.Add('    "src/${UnitName}_abi_call_test.zig"');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$missing = @()');
  Lines.Add('foreach ($rel in $requiredFiles) {');
  Lines.Add('    $p = Join-Path $GenDir $rel');
  Lines.Add('    if (-not (Test-Path -LiteralPath $p)) { $missing += $p }');
  Lines.Add('}');
  Lines.Add('if ($missing.Count -gt 0) {');
  Lines.Add('    Write-Fail "Missing required files after layout normalization:"');
  Lines.Add('    foreach ($m in $missing) { Write-Host "        $m" }');
  Lines.Add('    Write-Fail "The Zig generator likely failed. Check the generator output first."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "All required files present."');
  Lines.Add('');
end;

procedure EmitBuild(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "Running zig build ..."');
  Lines.Add('Push-Location $GenDir');
  Lines.Add('$rc = 1');
  Lines.Add('$attempt = 0');
  Lines.Add('$maxAttempts = 3');
  Lines.Add('$lastBuildOutput = ""');
  Lines.Add('try {');
  Lines.Add('    while ($attempt -lt $maxAttempts) {');
  Lines.Add('        $lastBuildOutput = (& zig build 2>&1) -join "`n"');
  Lines.Add('        $rc = $LASTEXITCODE');
  Lines.Add('        if ($rc -eq 0) { break }');
  Lines.Add('');
  Lines.Add('        $m = [regex]::Match($lastBuildOutput, ''use this value:\s*(0x[0-9a-fA-F]+)'');');
  Lines.Add('        if (-not $m.Success) { break }');
  Lines.Add('');
  Lines.Add('        $fp = $m.Groups[1].Value');
  Lines.Add('        Write-Info "Detected invalid fingerprint; patching build.zig.zon with $fp ..."');
  Lines.Add('        $zonPath = Join-Path $GenDir "build.zig.zon"');
  Lines.Add('        $c = Get-Content -LiteralPath $zonPath -Raw');
  Lines.Add('        $c = $c -replace ''\.fingerprint\s*=\s*0x[0-9a-fA-F]+,'', ".fingerprint = $fp,"');
  Lines.Add('        Write-TextFileNoBom -Path $zonPath -Content $c');
  Lines.Add('        $attempt += 1');
  Lines.Add('    }');
  Lines.Add('} finally {');
  Lines.Add('    Pop-Location');
  Lines.Add('}');
  Lines.Add('if ($rc -ne 0) {');
  Lines.Add('    if ($lastBuildOutput -match ''module not found: lingofuse'' -or $lastBuildOutput -match ''no module named'') {');
  Lines.Add('        Write-Fail "The lingofuse package does not export a module named ''lingofuse''."');
  Lines.Add('        Write-Fail "Open the lingofuse build.zig and check the addModule() name."');
  Lines.Add('    }');
  Lines.Add('    if ($lastBuildOutput -match ''invalid fingerprint'') {');
  Lines.Add('        Write-Fail "Zig kept rejecting the fingerprint after $maxAttempts attempts."');
  Lines.Add('        Write-Fail "Inspect build.zig.zon and check .name / .version fields."');
  Lines.Add('    }');
  Lines.Add('    if ($lastBuildOutput -match ''expected path relative to build root'') {');
  Lines.Add('        Write-Fail "build.zig.zon .path is still absolute; the patch step failed."');
  Lines.Add('        Write-Fail "Inspect build.zig.zon and check the .lingofuse entry."');
  Lines.Add('    }');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Full build output:"');
  Lines.Add('    Write-Host $lastBuildOutput');
  Lines.Add('    Write-Fail "zig build failed (exit $rc)."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "zig build passed."');
  Lines.Add('');
end;

procedure EmitSmoke(Lines: TPascalStringList);
begin
  Lines.Add('$serviceExe = Join-Path $GenDir ("zig-out/bin/" + $UnitName + "_abi_service_test.exe")');
  Lines.Add('$callExe    = Join-Path $GenDir ("zig-out/bin/" + $UnitName + "_abi_call_test.exe")');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $serviceExe)) {');
  Lines.Add('    $serviceExe = Join-Path $GenDir ("zig-out/bin/" + $UnitName + "_abi_service_test")');
  Lines.Add('}');
  Lines.Add('if (-not (Test-Path -LiteralPath $callExe)) {');
  Lines.Add('    $callExe = Join-Path $GenDir ("zig-out/bin/" + $UnitName + "_abi_call_test")');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $serviceExe)) {');
  Lines.Add('    Write-Fail "Service executable not found under zig-out/bin/."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('if (-not (Test-Path -LiteralPath $callExe)) {');
  Lines.Add('    Write-Fail "Call executable not found under zig-out/bin/."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok ("  " + (Split-Path $serviceExe -Leaf))');
  Lines.Add('Write-Ok ("  " + (Split-Path $callExe -Leaf))');
  Lines.Add('');
  Lines.Add('if ($RunSmoke) {');
  Lines.Add('    Write-Info "Running smoke checks (--help on each executable) ..."');
  Lines.Add('    & $serviceExe --help');
  Lines.Add('    if ($LASTEXITCODE -ne 0) {');
  Lines.Add('        Write-Fail "service_test --help failed (exit $LASTEXITCODE)."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    & $callExe --help');
  Lines.Add('    if ($LASTEXITCODE -ne 0) {');
  Lines.Add('        Write-Fail "call_test --help failed (exit $LASTEXITCODE)."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    Write-Ok "Smoke checks passed."');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitNextSteps(Lines: TPascalStringList);
begin
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host "  Environment is ready." -ForegroundColor Green');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  The test programs are NOT started by this script." -ForegroundColor Yellow');
  Lines.Add('Write-Host "  Open TWO terminals and start them manually, in this order." -ForegroundColor Yellow');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Terminal 1 (service):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      cd `"$GenDir`""');
  Lines.Add('Write-Host "      .\zig-out\bin\${UnitName}_abi_service_test.exe"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "      Expected output:" -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          [OK] Service ready on ipc:${UnitName}_abi_service_test" -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          [OK] App: ${UnitName}_abi" -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          [OK] P2P: ${UnitName}_service_test_p2p" -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          [OK] Auto-exit after 120 seconds (Ctrl+C to exit sooner)" -ForegroundColor DarkGray');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Terminal 2 (call):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      cd `"$GenDir`""');
  Lines.Add('Write-Host "      .\zig-out\bin\${UnitName}_abi_call_test.exe"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "      Expected output:" -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          [PASS] <api>(app call) = ..." -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          [PASS] <api>(uid call) = ..." -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          [PASS] <api>(p2pname call) = ..." -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          [PASS] <api>(app async) = ..." -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          ... (every API x every variant)" -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          === Summary ===" -ForegroundColor DarkGray');
  Lines.Add('Write-Host "          Pass: N, Fail: 0, Skip: 0" -ForegroundColor DarkGray');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Notes:" -ForegroundColor Yellow');
  Lines.Add('Write-Host "    - Start service_test FIRST, then call_test." -ForegroundColor Yellow');
  Lines.Add('Write-Host "    - call_test exits with code 0 on success, 2 on failure." -ForegroundColor Yellow');
  Lines.Add('Write-Host "    - service_test auto-exits after 120 seconds; Ctrl+C exits sooner." -ForegroundColor Yellow');
  Lines.Add('Write-Host "    - On Linux/macOS, replace .\zig-out\bin\ with zig-out/bin/ and drop .exe." -ForegroundColor Yellow');
  Lines.Add('Write-Host ""');
  Lines.Add('exit 0');
end;

function GenerateZigTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
  UnitName, NormalizedUnit: TP_String;
begin
  Result := nil;
  if Model = nil then
  begin
    Log('Model is nil');
    Exit;
  end;

  UnitName := Model.UnitName;
  if UnitName.Len = 0 then
  begin
    Log('UnitName is empty');
    Exit;
  end;

  NormalizedUnit := MakeApiName(UnitName);

  Lines := TPascalStringList.Create;
  try
    EmitHeader(Lines);
    EmitHelp(Lines);
    EmitValidation(Lines);
    EmitToolCheck(Lines);
    EmitUnitNameDetect(Lines);
    EmitLayout(Lines);
    EmitScaffold(Lines);
    EmitPatchZon(Lines);
    EmitStaleCleanup(Lines);
    EmitSanityCheck(Lines);
    EmitFileCheck(Lines);
    EmitBuild(Lines);
    EmitSmoke(Lines);
    EmitNextSteps(Lines);
    Result := Lines;
    Log(PFormat('Generated setup_zig_tests.ps1 (%d lines)', [Lines.Count]));
  finally
    if Result <> Lines then
      Lines.Free;
  end;
end;

initialization

  RegisterGenerator(
    'zig',
    'setup_zig_tests.ps1',
    gkPs1,
    'Zig ABI test environment setup script',
    @GenerateZigTestSetupScript);

end.
