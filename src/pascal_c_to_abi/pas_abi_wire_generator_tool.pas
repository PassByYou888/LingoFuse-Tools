unit pas_abi_wire_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core,
  Z.PascalStrings, Z.UPascalStrings,
  Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_abi_registry;

function GenerateABIWirePascalCode(Model: TPascal_Func_Model): TPascalStringList;

implementation

function GenerateABIWirePascalCode(Model: TPascal_Func_Model): TPascalStringList;
begin
  Result := TPascalStringList.Create;

  Result.Add('unit abi_wire_unit;');
  Result.Add('');
  Result.Add('{$ifdef FPC}');
  Result.Add('  {$mode delphi}{$H+}');
  Result.Add('  {$MODESWITCH NestedProcVars}');
  Result.Add('{$endif}');
  Result.Add('{$R-}{$I-}{$Q-}{$B-}');
  Result.Add('');
  Result.Add('interface');
  Result.Add('');
  Result.Add('uses');
  Result.Add('  SysUtils, Classes,');
  Result.Add('  lingofuse_import;');
  Result.Add('');
  Result.Add('type');
  Result.Add('  TLF_Binary_Data = packed record');
  Result.Add('    size: Integer;');
  Result.Add('    data: Pointer;');
  Result.Add('  end;');
  Result.Add('  PLF_Binary_Data = ^TLF_Binary_Data;');
  Result.Add('');
  Result.Add('function MakeLF_Binary_Data(const size_: Integer; const fill_byte: Byte): PLF_Binary_Data;');
  Result.Add('function CloneLF_Binary_Data(const src: PLF_Binary_Data): PLF_Binary_Data;');
  Result.Add('function LF_Binary_Data_Equals(const a, b: PLF_Binary_Data): Boolean;');
  Result.Add('function LF_Binary_Data_ToStr(const p: PLF_Binary_Data): string;');
  Result.Add('procedure FreeLF_Binary_Data(p: PLF_Binary_Data);');
  Result.Add('function LF_Write_LF_Binary_Data(hnd: TDataHnd___; const Value: PLF_Binary_Data): Boolean;');
  Result.Add('function LF_Read_LF_Binary_Data(hnd: TDataHnd___; var Value: PLF_Binary_Data): Boolean;');
  Result.Add('');
  Result.Add('function Self_Test_LF_Binary_Data: Boolean;');
  Result.Add('');
  Result.Add('implementation');
  Result.Add('');
  Result.Add('function MakeLF_Binary_Data(const size_: Integer; const fill_byte: Byte): PLF_Binary_Data;');
  Result.Add('var');
  Result.Add('  p: PByte;');
  Result.Add('  i: Integer;');
  Result.Add('begin');
  Result.Add('  if size_ < 0 then Exit(nil);');
  Result.Add('  New(Result);');
  Result.Add('  Result^.size := size_;');
  Result.Add('  Result^.data := nil;');
  Result.Add('  if size_ > 0 then');
  Result.Add('  begin');
  Result.Add('    GetMem(Result^.data, size_);');
  Result.Add('    p := Result^.data;');
  Result.Add('    for i := 0 to size_ - 1 do');
  Result.Add('      p[i] := Byte((Int64(fill_byte) + Int64(i) * 7) and $FF);');
  Result.Add('  end;');
  Result.Add('end;');
  Result.Add('');
  Result.Add('function CloneLF_Binary_Data(const src: PLF_Binary_Data): PLF_Binary_Data;');
  Result.Add('begin');
  Result.Add('  if src = nil then Exit(nil);');
  Result.Add('  New(Result);');
  Result.Add('  Result^.size := src^.size;');
  Result.Add('  Result^.data := nil;');
  Result.Add('  if src^.size > 0 then');
  Result.Add('  begin');
  Result.Add('    GetMem(Result^.data, src^.size);');
  Result.Add('    if src^.data <> nil then');
  Result.Add('      Move(src^.data^, Result^.data^, src^.size);');
  Result.Add('  end;');
  Result.Add('end;');
  Result.Add('');
  Result.Add('function LF_Binary_Data_Equals(const a, b: PLF_Binary_Data): Boolean;');
  Result.Add('begin');
  Result.Add('  if (a = nil) and (b = nil) then Exit(True);');
  Result.Add('  if (a = nil) or (b = nil) then Exit(False);');
  Result.Add('  if a^.size <> b^.size then Exit(False);');
  Result.Add('  if a^.size = 0 then Exit(True);');
  Result.Add('  if (a^.data = nil) or (b^.data = nil) then Exit(False);');
  Result.Add('  Result := CompareMem(a^.data, b^.data, a^.size);');
  Result.Add('end;');
  Result.Add('');
  Result.Add('function LF_Binary_Data_ToStr(const p: PLF_Binary_Data): string;');
  Result.Add('begin');
  Result.Add('  if p = nil then');
  Result.Add('    Result := ' + #39 + 'nil' + #39);
  Result.Add('  else');
  Result.Add('    Result := ' + #39 + 'LF_Binary_Data(size=' + #39 + ' + IntToStr(p^.size) + ' + #39 + ')' + #39 + ';');
  Result.Add('end;');
  Result.Add('');
  Result.Add('procedure FreeLF_Binary_Data(p: PLF_Binary_Data);');
  Result.Add('begin');
  Result.Add('  if p = nil then Exit;');
  Result.Add('  if p^.data <> nil then FreeMem(p^.data);');
  Result.Add('  p^.data := nil;');
  Result.Add('  p^.size := 0;');
  Result.Add('  Dispose(p);');
  Result.Add('end;');
  Result.Add('');
  Result.Add('function LF_Write_LF_Binary_Data(hnd: TDataHnd___; const Value: PLF_Binary_Data): Boolean;');
  Result.Add('var');
  Result.Add('  saved_pos: Int64;');
  Result.Add('begin');
  Result.Add('  Result := False;');
  Result.Add('  if hnd = nil then Exit;');
  Result.Add('  saved_pos := LF_GetPos(hnd);');
  Result.Add('  if Value = nil then');
  Result.Add('  begin');
  Result.Add('    Result := LF_WriteInt32(hnd, 0);');
  Result.Add('    if not Result then');
  Result.Add('      LF_SetPos(hnd, saved_pos);');
  Result.Add('    Exit;');
  Result.Add('  end;');
  Result.Add('  if Value^.size < 0 then Exit;');
  Result.Add('  if (Value^.size > 0) and (Value^.data = nil) then Exit;');
  Result.Add('  if not LF_WriteInt32(hnd, Value^.size) then');
  Result.Add('  begin');
  Result.Add('    LF_SetPos(hnd, saved_pos);');
  Result.Add('    Exit;');
  Result.Add('  end;');
  Result.Add('  if Value^.size > 0 then');
  Result.Add('    if LF_WriteBuffer(hnd, Value^.data, Value^.size) <> Value^.size then');
  Result.Add('    begin');
  Result.Add('      LF_SetPos(hnd, saved_pos);');
  Result.Add('      Exit;');
  Result.Add('    end;');
  Result.Add('  Result := True;');
  Result.Add('end;');
  Result.Add('');
  Result.Add('function LF_Read_LF_Binary_Data(hnd: TDataHnd___; var Value: PLF_Binary_Data): Boolean;');
  Result.Add('var');
  Result.Add('  N: Integer;');
  Result.Add('  ptr: Pointer;');
  Result.Add('  saved_pos: Int64;');
  Result.Add('begin');
  Result.Add('  if Value <> nil then FreeLF_Binary_Data(Value);');
  Result.Add('  Value := nil;');
  Result.Add('  if hnd = nil then Exit(False);');
  Result.Add('  saved_pos := LF_GetPos(hnd);');
  Result.Add('  if not LF_ReadInt32(hnd, N) then');
  Result.Add('  begin');
  Result.Add('    LF_SetPos(hnd, saved_pos);');
  Result.Add('    Exit(False);');
  Result.Add('  end;');
  Result.Add('  if N < 0 then');
  Result.Add('  begin');
  Result.Add('    LF_SetPos(hnd, saved_pos);');
  Result.Add('    Exit(False);');
  Result.Add('  end;');
  Result.Add('  if N = 0 then Exit(True);');
  Result.Add('  New(Value);');
  Result.Add('  Value^.size := N;');
  Result.Add('  Value^.data := nil;');
  Result.Add('  GetMem(ptr, N);');
  Result.Add('  if LF_ReadBuffer(hnd, ptr, N) <> N then');
  Result.Add('  begin');
  Result.Add('    FreeMem(ptr);');
  Result.Add('    Dispose(Value);');
  Result.Add('    Value := nil;');
  Result.Add('    LF_SetPos(hnd, saved_pos);');
  Result.Add('    Exit(False);');
  Result.Add('  end;');
  Result.Add('  Value^.data := ptr;');
  Result.Add('  Result := True;');
  Result.Add('end;');
  Result.Add('');
  Result.Add('function Self_Test_LF_Binary_Data: Boolean;');
  Result.Add('var');
  Result.Add('  p1, p2, p3, read_p1, read_p2: PLF_Binary_Data;');
  Result.Add('  hnd: TDataHnd___;');
  Result.Add('  pos_before, pos_after: Int64;');
  Result.Add('  ok: Boolean;');
  Result.Add('  fail_count: Integer;');
  Result.Add('  small_buf: array[0..9] of Byte;');
  Result.Add('begin');
  Result.Add('  fail_count := 0;');
  Result.Add('  p1 := nil;');
  Result.Add('  p2 := nil;');
  Result.Add('  p3 := nil;');
  Result.Add('  FillChar(small_buf, SizeOf(small_buf), 0);');
  Result.Add('');
  Result.Add('  p1 := MakeLF_Binary_Data(16, $AA);');
  Result.Add('  ok := (p1 <> nil) and (p1^.size = 16) and (p1^.data <> nil);');
  Result.Add('  if ok then WriteLn(' + #39 + '[PASS] MakeLF_Binary_Data' + #39 + ')');
  Result.Add('  else begin WriteLn(' + #39 + '[FAIL] MakeLF_Binary_Data' + #39 + '); Inc(fail_count); end;');
  Result.Add('');
  Result.Add('  p2 := CloneLF_Binary_Data(p1);');
  Result.Add('  ok := (p2 <> nil) and LF_Binary_Data_Equals(p1, p2);');
  Result.Add('  if ok then WriteLn(' + #39 + '[PASS] CloneLF_Binary_Data' + #39 + ')');
  Result.Add('  else begin WriteLn(' + #39 + '[FAIL] CloneLF_Binary_Data' + #39 + '); Inc(fail_count); end;');
  Result.Add('');
  Result.Add('  ok := LF_Binary_Data_Equals(nil, nil);');
  Result.Add('  if ok then WriteLn(' + #39 + '[PASS] LF_Binary_Data_Equals(nil, nil)' + #39 + ')');
  Result.Add('  else begin WriteLn(' + #39 + '[FAIL] LF_Binary_Data_Equals(nil, nil)' + #39 + '); Inc(fail_count); end;');
  Result.Add('');
  Result.Add('  ok := not LF_Binary_Data_Equals(p1, nil);');
  Result.Add('  if ok then WriteLn(' + #39 + '[PASS] LF_Binary_Data_Equals(non-nil, nil)' + #39 + ')');
  Result.Add('  else begin WriteLn(' + #39 + '[FAIL] LF_Binary_Data_Equals(non-nil, nil)' + #39 + '); Inc(fail_count); end;');
  Result.Add('');
  Result.Add('  p3 := MakeLF_Binary_Data(16, $BB);');
  Result.Add('  ok := (p3 <> nil) and (not LF_Binary_Data_Equals(p1, p3));');
  Result.Add('  if ok then WriteLn(' + #39 + '[PASS] LF_Binary_Data_Equals(different)' + #39 + ')');
  Result.Add('  else begin WriteLn(' + #39 + '[FAIL] LF_Binary_Data_Equals(different)' + #39 + '); Inc(fail_count); end;');
  Result.Add('');
  Result.Add('  if LF_Binary_Data_ToStr(nil) = ' + #39 + 'nil' + #39 + ' then');
  Result.Add('    WriteLn(' + #39 + '[PASS] LF_Binary_Data_ToStr(nil)' + #39 + ')');
  Result.Add('  else begin WriteLn(' + #39 + '[FAIL] LF_Binary_Data_ToStr(nil)' + #39 + '); Inc(fail_count); end;');
  Result.Add('');
  Result.Add('  hnd := LF_CreateData(' + #39 + 'LF_SELF_TEST_WIRE_1' + #39 + ');');
  Result.Add('  if hnd = nil then');
  Result.Add('  begin');
  Result.Add('    WriteLn(' + #39 + '[FAIL] LF_CreateData returned nil (LF_LoadLibrary not called?)' + #39 + ');');
  Result.Add('    if p1 <> nil then FreeLF_Binary_Data(p1);');
  Result.Add('    if p2 <> nil then FreeLF_Binary_Data(p2);');
  Result.Add('    if p3 <> nil then FreeLF_Binary_Data(p3);');
  Result.Add('    Exit(False);');
  Result.Add('  end;');
  Result.Add('');
  Result.Add('  if LF_Write_LF_Binary_Data(hnd, p1) then');
  Result.Add('  begin');
  Result.Add('    LF_SetPos(hnd, 0);');
  Result.Add('    read_p1 := nil;');
  Result.Add('    ok := LF_Read_LF_Binary_Data(hnd, read_p1) and LF_Binary_Data_Equals(read_p1, p1);');
  Result.Add('    if ok then WriteLn(' + #39 + '[PASS] LF_Read_LF_Binary_Data (single)' + #39 + ')');
  Result.Add('    else begin WriteLn(' + #39 + '[FAIL] LF_Read_LF_Binary_Data (single)' + #39 + '); Inc(fail_count); end;');
  Result.Add('    if read_p1 <> nil then FreeLF_Binary_Data(read_p1);');
  Result.Add('  end');
  Result.Add('  else begin WriteLn(' + #39 + '[FAIL] LF_Write_LF_Binary_Data' + #39 + '); Inc(fail_count); end;');
  Result.Add('  LF_FreeData(hnd);');
  Result.Add('');
  Result.Add('  hnd := LF_CreateData(' + #39 + 'LF_SELF_TEST_WIRE_2' + #39 + ');');
  Result.Add('  if hnd <> nil then');
  Result.Add('  begin');
  Result.Add('    LF_Write_LF_Binary_Data(hnd, p1);');
  Result.Add('    LF_Write_LF_Binary_Data(hnd, p3);');
  Result.Add('    LF_SetPos(hnd, 0);');
  Result.Add('    read_p1 := nil;');
  Result.Add('    read_p2 := nil;');
  Result.Add('    ok := LF_Read_LF_Binary_Data(hnd, read_p1)');
  Result.Add('      and LF_Read_LF_Binary_Data(hnd, read_p2)');
  Result.Add('      and LF_Binary_Data_Equals(read_p1, p1)');
  Result.Add('      and LF_Binary_Data_Equals(read_p2, p3);');
  Result.Add('    if ok then WriteLn(' + #39 + '[PASS] LF_Read_LF_Binary_Data (two items, cursor advanced)' + #39 + ')');
  Result.Add('    else begin WriteLn(' + #39 + '[FAIL] LF_Read_LF_Binary_Data (two items, cursor advanced)' + #39 + '); Inc(fail_count); end;');
  Result.Add('    if read_p1 <> nil then FreeLF_Binary_Data(read_p1);');
  Result.Add('    if read_p2 <> nil then FreeLF_Binary_Data(read_p2);');
  Result.Add('    LF_FreeData(hnd);');
  Result.Add('  end;');
  Result.Add('');
  Result.Add('  hnd := LF_CreateData(' + #39 + 'LF_SELF_TEST_WIRE_3' + #39 + ');');
  Result.Add('  if hnd <> nil then');
  Result.Add('  begin');
  Result.Add('    LF_WriteInt32(hnd, 100);');
  Result.Add('    LF_WriteBuffer(hnd, @small_buf, 10);');
  Result.Add('    LF_SetPos(hnd, 0);');
  Result.Add('    pos_before := LF_GetPos(hnd);');
  Result.Add('    read_p1 := nil;');
  Result.Add('    ok := LF_Read_LF_Binary_Data(hnd, read_p1);');
  Result.Add('    pos_after := LF_GetPos(hnd);');
  Result.Add('    if (not ok) and (read_p1 = nil) and (pos_after = pos_before) then');
  Result.Add('      WriteLn(' + #39 + '[PASS] LF_Read_LF_Binary_Data (truncated, pos restored)' + #39 + ')');
  Result.Add('    else begin WriteLn(' + #39 + '[FAIL] LF_Read_LF_Binary_Data (truncated, pos restored)' + #39 + '); Inc(fail_count); end;');
  Result.Add('    LF_FreeData(hnd);');
  Result.Add('  end;');
  Result.Add('');
  Result.Add('  if p1 <> nil then FreeLF_Binary_Data(p1);');
  Result.Add('  if p2 <> nil then FreeLF_Binary_Data(p2);');
  Result.Add('  if p3 <> nil then FreeLF_Binary_Data(p3);');
  Result.Add('');
  Result.Add('  Result := (fail_count = 0);');
  Result.Add('  if Result then');
  Result.Add('    WriteLn(' + #39 + '[PASS] Self_Test_LF_Binary_Data (all passed)' + #39 + ')');
  Result.Add('  else');
  Result.Add('    WriteLn(' + #39 + '[FAIL] Self_Test_LF_Binary_Data (' + #39 + ' + IntToStr(fail_count) + ' + #39 + ' failures)' + #39 + ');');
  Result.Add('end;');
  Result.Add('');
  Result.Add('end.');
end;

initialization

  RegisterGenerator('pascal', 'abi_wire_unit.pas', gkProject,
    'Shared ABI wire helper unit', @GenerateABIWirePascalCode);

end.
