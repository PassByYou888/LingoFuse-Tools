unit http_R_abi_test_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core, Z.PascalStrings, Z.UPascalStrings,
  Z.Status, Z.UnicodeMixedLib, Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_json_abi_registry;

// GenerateRTestSetupScript - produce setup_r_tests.ps1.
// The returned list is owned by the caller and must be released with
// DisposeObject.
function GenerateRTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

const
  // [FIX] These MUST be String, not Char. FPC 3.2.2 rejects
  //        Char + Char (e.g. "CH_SQ + CH_SQ"), so declaring them as
  //        Char makes the generator fail to compile.
  CH_SQ: string = #39;   // single quote
  CH_BT: string = #96;   // backtick

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[http_R_abi_test_setup_generator] %s', [Msg.Text]);
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[http_R_abi_test_setup_generator] %s', [PFormat(Fmt, Args)]);
end;

// ============================================================================
// Section 1: header + param()
// ============================================================================

procedure EmitSetupHeader(Lines: TPascalStringList);
begin
  Lines.Add('#Requires -Version 5.1');
  Lines.Add('# ============================================================================');
  Lines.Add('# setup_r_tests.ps1');
  Lines.Add('# AUTO-GENERATED by http_R_abi_test_setup_generator_tool.pas.');
  Lines.Add('# Do not edit by hand: the generator re-emits this file from scratch.');
  Lines.Add('#');
  Lines.Add('# This script ONLY prepares the R test environment:');
  Lines.Add('#   1. Verifies that R and Rscript are on PATH.');
  Lines.Add('#   2. Verifies that the LingoFuse runtime is present.');
  Lines.Add('#   3. Verifies that the five generated .R files are present.');
  Lines.Add('#   4. Checks the four R packages (lingofuse / jsonlite / httr / future).');
  Lines.Add('#   5. Optionally installs any missing package.');
  Lines.Add('#   6. Optionally runs a syntax-only smoke test.');
  Lines.Add('#');
  Lines.Add('# It does NOT start the mesh, does NOT run any test, and does NOT');
  Lines.Add('# need bridge.py.');
  Lines.Add('#');
  Lines.Add('# Required:');
  Lines.Add('#   -RLibDir   path to the lingofuse R package source directory');
  Lines.Add('#              (the one containing DESCRIPTION, R\, src\, inst\).');
  Lines.Add('#');
  Lines.Add('# Run with -Help for the full usage text.');
  Lines.Add('# ============================================================================');
  Lines.Add('');
  Lines.Add('[CmdletBinding()]');
  Lines.Add('param(');
  Lines.Add('    [string]$RLibDir = "",');
  Lines.Add('    [string]$RuntimeDir = "",');
  Lines.Add('    [string]$GenDir = "",');
  Lines.Add('    [string]$UnitName = "",');
  Lines.Add('    [switch]$InstallMissing,');
  Lines.Add('    [switch]$Force,');
  Lines.Add('    [switch]$RunSmoke,');
  Lines.Add('    [switch]$Help');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$ErrorActionPreference = "Stop"');
  Lines.Add('');
  Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
  Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
  Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
  Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
  Lines.Add('');
end;

// ============================================================================
// Section 2: -Help
// ============================================================================

procedure EmitSetupHelp(Lines: TPascalStringList);
begin
  Lines.Add('# --- 1. -Help ----------------------------------------------------------');
  Lines.Add('if ($Help) {');
  Lines.Add('    $help = @' + CH_SQ);
  Lines.Add('Usage: setup_r_tests.ps1 -RLibDir <path> [options]');
  Lines.Add('');
  Lines.Add('Prepares the R test environment for the generated HTTP/JSON binding.');
  Lines.Add('It checks R, the LingoFuse runtime, the generated files, and the four');
  Lines.Add('R packages the generated code depends on. It does NOT run any test');
  Lines.Add('and does NOT need bridge.py.');
  Lines.Add('');
  Lines.Add('Required:');
  Lines.Add('  -RLibDir <path>');
  Lines.Add('        Path to the lingofuse R package source directory.');
  Lines.Add('        Must contain DESCRIPTION, R\, src\, inst\.');
  Lines.Add('        Example: D:\CoreLibrary\LingoFuse\r\lingofuse');
  Lines.Add('');
  Lines.Add('Optional:');
  Lines.Add('  -RuntimeDir <path>');
  Lines.Add('        Directory containing LingoFuse64.dll (or liblingofuse.so).');
  Lines.Add('        Default: auto-detect from GenDir using relative probes.');
  Lines.Add('');
  Lines.Add('  -GenDir <path>');
  Lines.Add('        Directory containing the generated .R files.');
  Lines.Add('        Default: the directory containing this script.');
  Lines.Add('');
  Lines.Add('  -UnitName <name>');
  Lines.Add('        Source unit name, without extension.');
  Lines.Add('        Default: auto-detected from <name>_http_json_service.R.');
  Lines.Add('');
  Lines.Add('  -InstallMissing');
  Lines.Add('        Install missing R packages automatically.');
  Lines.Add('        - lingofuse: R CMD INSTALL $RLibDir');
  Lines.Add('        - jsonlite / httr / future: install.packages() from CRAN');
  Lines.Add('');
  Lines.Add('  -Force');
  Lines.Add('        Force reinstall of R packages, even if already installed.');
  Lines.Add('');
  Lines.Add('  -RunSmoke');
  Lines.Add('        After preparing, run a syntax-only smoke test that parses');
  Lines.Add('        the generated service.R. No network, no bridge required.');
  Lines.Add('');
  Lines.Add('  -Help');
  Lines.Add('        Show this help text and exit.');
  Lines.Add('');
  Lines.Add('Example:');
  Lines.Add('  .\setup_r_tests.ps1 ' + CH_BT);
  Lines.Add('      -RLibDir D:\CoreLibrary\LingoFuse\r\lingofuse ' + CH_BT);
  Lines.Add('      -RuntimeDir D:\CoreLibrary\LingoFuse\tools\pascal_c_to_json_abi\ComplexTestUnit ' + CH_BT);
  Lines.Add('      -InstallMissing -RunSmoke');
  Lines.Add('');
  Lines.Add('Exit codes:');
  Lines.Add('  0   success (or -Help was requested)');
  Lines.Add('  1   argument validation failed, missing file, or install failed');
  Lines.Add(CH_SQ + '@');
  Lines.Add('    Write-Host $help');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 3: required parameter
// ============================================================================

procedure EmitSetupRequired(Lines: TPascalStringList);
begin
  Lines.Add('# --- 2. Required parameters --------------------------------------------');
  Lines.Add('if (-not $RLibDir) {');
  Lines.Add('    Write-Fail "-RLibDir is required."');
  Lines.Add('    Write-Host "        Run ' + CH_SQ + 'setup_r_tests.ps1 -Help' + CH_SQ + ' for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 4: path resolution + UnitName detection + runtime detection
// ============================================================================

procedure EmitSetupPaths(Lines: TPascalStringList);
begin
  Lines.Add('# --- 3. Resolve paths --------------------------------------------------');
  Lines.Add('if (-not (Test-Path -LiteralPath $RLibDir)) {');
  Lines.Add('    Write-Fail "RLibDir not found: $RLibDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$RLibDir = (Resolve-Path -LiteralPath $RLibDir).Path');
  Lines.Add('');
  Lines.Add('$rDesc = Join-Path $RLibDir "DESCRIPTION"');
  Lines.Add('if (-not (Test-Path -LiteralPath $rDesc)) {');
  Lines.Add('    Write-Fail "Missing DESCRIPTION: $rDesc"');
  Lines.Add('    Write-Fail "            -RLibDir must point at the lingofuse package source."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not $GenDir) { $GenDir = $PSScriptRoot }');
  Lines.Add('$GenDir = (Resolve-Path -LiteralPath $GenDir).Path');
  Lines.Add('');
  Lines.Add('Write-Info "RLibDir          : $RLibDir"');
  Lines.Add('Write-Info "GenDir           : $GenDir"');
  Lines.Add('');
  Lines.Add('# --- 4. Detect UnitName if not supplied --------------------------------');
  Lines.Add('if (-not $UnitName) {');
  Lines.Add('    $candidate = Get-ChildItem -LiteralPath $GenDir -Filter "*_http_json_service.R" -File | Select-Object -First 1');
  Lines.Add('    if ($null -eq $candidate) {');
  Lines.Add('        Write-Fail "Cannot detect UnitName (no *_http_json_service.R in $GenDir)."');
  Lines.Add('        Write-Fail "            Pass -UnitName explicitly."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    $UnitName = $candidate.Name -replace ' + CH_SQ + '_http_json_service\.R$' + CH_SQ + ', ' + CH_SQ + CH_SQ);
  Lines.Add('}');
  Lines.Add('Write-Info "UnitName         : $UnitName"');
  Lines.Add('');
  Lines.Add('# --- 5. Resolve runtime directory --------------------------------------');
  Lines.Add('if (-not $RuntimeDir) {');
  Lines.Add('    $relatives = @("", "Binary", "runtime", "runtime/Binary", "lib", "..", "../Binary", "../../Binary", "../../../Binary", "libs", "libs/x64")');
  Lines.Add('    $dllNames = @("LingoFuse64.dll", "LingoFuse32.dll", "liblingofuse.so", "liblingofuse.dylib")');
  Lines.Add('    foreach ($rel in $relatives) {');
  Lines.Add('        $p = if ($rel) { Join-Path $GenDir $rel } else { $GenDir }');
  Lines.Add('        if (-not (Test-Path -LiteralPath $p)) { continue }');
  Lines.Add('        $p = (Resolve-Path -LiteralPath $p).Path');
  Lines.Add('        foreach ($dll in $dllNames) {');
  Lines.Add('            if (Test-Path -LiteralPath (Join-Path $p $dll)) {');
  Lines.Add('                $RuntimeDir = $p');
  Lines.Add('                break');
  Lines.Add('            }');
  Lines.Add('        }');
  Lines.Add('        if ($RuntimeDir) { break }');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('if (-not $RuntimeDir) {');
  Lines.Add('    Write-Fail "Cannot locate the LingoFuse runtime."');
  Lines.Add('    Write-Fail "            Pass -RuntimeDir explicitly."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('if (-not (Test-Path -LiteralPath $RuntimeDir)) {');
  Lines.Add('    Write-Fail "RuntimeDir not found: $RuntimeDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$RuntimeDir = (Resolve-Path -LiteralPath $RuntimeDir).Path');
  Lines.Add('Write-Info "RuntimeDir       : $RuntimeDir"');
  Lines.Add('');
end;

// ============================================================================
// Section 5: R check + generated file check
// ============================================================================

procedure EmitSetupCheckR(Lines: TPascalStringList);
begin
  Lines.Add('# --- 6. Verify R is on PATH --------------------------------------------');
  Lines.Add('$rex = Get-Command R.exe -ErrorAction SilentlyContinue');
  Lines.Add('$rexscript = Get-Command Rscript.exe -ErrorAction SilentlyContinue');
  Lines.Add('if (-not $rex) {');
  Lines.Add('    Write-Fail "R.exe is not on PATH."');
  Lines.Add('    Write-Fail "            Install R and add its bin directory to PATH."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('if (-not $rexscript) {');
  Lines.Add('    Write-Fail "Rscript.exe is not on PATH."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$rVer = (& $rexscript "-e" "cat(R.version.string)" 2>&1) -join ""');
  Lines.Add('Write-Ok "R: $rVer"');
  Lines.Add('');
  Lines.Add('# --- 7. Verify the generated files -------------------------------------');
  Lines.Add('$serviceR    = Join-Path $GenDir ("$UnitName" + "_http_json_service.R")');
  Lines.Add('$implR       = Join-Path $GenDir ("$UnitName" + "_http_json_service_impl.R")');
  Lines.Add('$callR       = Join-Path $GenDir ("$UnitName" + "_http_json_call.R")');
  Lines.Add('$serviceTest = Join-Path $GenDir ("$UnitName" + "_http_json_service_main_test___.R")');
  Lines.Add('$callTest    = Join-Path $GenDir ("$UnitName" + "_http_json_call_main_test___.R")');
  Lines.Add('');
  Lines.Add('$missing = @()');
  Lines.Add('foreach ($p in @($serviceR, $implR, $callR, $serviceTest, $callTest)) {');
  Lines.Add('    if (-not (Test-Path -LiteralPath $p)) { $missing += $p }');
  Lines.Add('}');
  Lines.Add('if ($missing.Count -gt 0) {');
  Lines.Add('    Write-Fail "Missing generated files:"');
  Lines.Add('    foreach ($m in $missing) { Write-Host "        $m" }');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "All five generated R files present."');
  Lines.Add('');
end;

// ============================================================================
// Section 6: R package check + optional install
// ============================================================================

procedure EmitSetupPackages(Lines: TPascalStringList);
begin
  Lines.Add('# --- 8. Check R packages -----------------------------------------------');
  Lines.Add('function Test-RPackage {');
  Lines.Add('    param([string]$pkg)');
  Lines.Add('    $code = "cat(if (requireNamespace(' + CH_SQ + '$pkg' + CH_SQ + ', quietly=TRUE)) ' + CH_SQ + 'yes' + CH_SQ + ' else ' + CH_SQ + 'no' + CH_SQ + ')"');
  Lines.Add('    $out = (& $rexscript "-e" $code 2>$null) -join ""');
  Lines.Add('    return ($out -eq ' + CH_SQ + 'yes' + CH_SQ + ')');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$needed = @("lingofuse", "jsonlite", "httr", "future")');
  Lines.Add('$missingPkgs = @()');
  Lines.Add('foreach ($p in $needed) {');
  Lines.Add('    if ($Force) {');
  Lines.Add('        Write-Warn "R package ''$p'' forced reinstall."');
  Lines.Add('        $missingPkgs += $p');
  Lines.Add('        continue');
  Lines.Add('    }');
  Lines.Add('    if (Test-RPackage $p) {');
  Lines.Add('        Write-Ok "R package ''$p'' installed."');
  Lines.Add('    } else {');
  Lines.Add('        Write-Warn "R package ''$p'' not installed."');
  Lines.Add('        $missingPkgs += $p');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if ($missingPkgs.Count -gt 0) {');
  Lines.Add('    if ($InstallMissing) {');
  Lines.Add('        foreach ($p in $missingPkgs) {');
  Lines.Add('            if ($p -eq ' + CH_SQ + 'lingofuse' + CH_SQ + ') {');
  Lines.Add('                Write-Info "Installing lingofuse from $RLibDir..."');
  Lines.Add('                & $rex CMD INSTALL --preclean $RLibDir');
  Lines.Add('                if ($LASTEXITCODE -ne 0) {');
  Lines.Add('                    Write-Fail "R CMD INSTALL failed (exit $LASTEXITCODE)."');
  Lines.Add('                    exit 1');
  Lines.Add('                }');
  Lines.Add('            } else {');
  Lines.Add('                Write-Info "Installing $p from CRAN..."');
  Lines.Add('                $code = "install.packages(' + CH_SQ + '$p' + CH_SQ + ', repos=' + CH_SQ + 'https://cloud.r-project.org' + CH_SQ + ')"');
  Lines.Add('                & $rexscript "-e" $code');
  Lines.Add('                if ($LASTEXITCODE -ne 0) {');
  Lines.Add('                    Write-Fail "install.packages failed for $p."');
  Lines.Add('                    exit 1');
  Lines.Add('                }');
  Lines.Add('            }');
  Lines.Add('        }');
  Lines.Add('    } else {');
  Lines.Add('        Write-Fail ("Missing R packages: " + ($missingPkgs -join ' + CH_SQ + ', ' + CH_SQ + '))');
  Lines.Add('        Write-Fail "            Re-run with -InstallMissing to install automatically."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('# --- 9. Verify lingofuse loads -----------------------------------------');
  Lines.Add('$env:LINGOFUSE_RUNTIME = $RuntimeDir');
  Lines.Add('$loadCode = "cat(if (requireNamespace(' + CH_SQ + 'lingofuse' + CH_SQ + ', quietly=TRUE)) ' + CH_SQ + 'ok' + CH_SQ + ' else ' + CH_SQ + 'fail' + CH_SQ + ')"');
  Lines.Add('$loadCheck = (& $rexscript "-e" $loadCode) -join ""');
  Lines.Add('if ($loadCheck -ne ' + CH_SQ + 'ok' + CH_SQ + ') {');
  Lines.Add('    Write-Fail "Cannot load the lingofuse package."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "lingofuse package loads."');
  Lines.Add('');
end;

// ============================================================================
// Section 7: optional -RunSmoke (syntax-only, no network)
// ============================================================================

procedure EmitSetupRunSmoke(Lines: TPascalStringList);
begin
  Lines.Add('# --- 10. Optional: run syntax-only smoke test --------------------------');
  Lines.Add('if ($RunSmoke) {');
  Lines.Add('    Write-Info "Running syntax-only smoke test (parse service.R)..."');
  Lines.Add('    $serviceRUnix = $serviceR -replace ' + CH_SQ + '\\' + CH_SQ + ', ' + CH_SQ + '/' + CH_SQ);
  Lines.Add('    $smokeR = @"');
  Lines.Add('tryCatch({');
  Lines.Add('    parse(' + CH_SQ + '$serviceRUnix' + CH_SQ + ')');
  Lines.Add('    cat(' + CH_SQ + 'parse OK' + CH_SQ + ', ' + CH_SQ + '\n' + CH_SQ + ', sep = ' + CH_SQ + CH_SQ + ')');
  Lines.Add('    quit(status = 0)');
  Lines.Add('}, error = function(e) {');
  Lines.Add('    cat(' + CH_SQ + 'parse FAILED: ' + CH_SQ + ', conditionMessage(e), ' + CH_SQ + '\n' + CH_SQ + ', sep = ' + CH_SQ + CH_SQ + ')');
  Lines.Add('    quit(status = 1)');
  Lines.Add('})');
  Lines.Add('"@');
  Lines.Add('    $tmp = [System.IO.Path]::GetTempFileName() + ".R"');
  Lines.Add('    Set-Content -Path $tmp -Value $smokeR -Encoding UTF8');
  Lines.Add('    try {');
  Lines.Add('        & $rexscript $tmp');
  Lines.Add('        $smokeRc = $LASTEXITCODE');
  Lines.Add('    } finally {');
  Lines.Add('        Remove-Item $tmp -Force -ErrorAction SilentlyContinue');
  Lines.Add('    }');
  Lines.Add('    if ($smokeRc -ne 0) {');
  Lines.Add('        Write-Fail "smoke test failed (exit $smokeRc)."');
  Lines.Add('        exit $smokeRc');
  Lines.Add('    }');
  Lines.Add('    Write-Ok "smoke test passed."');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 8: summary
// ============================================================================

procedure EmitSetupSummary(Lines: TPascalStringList);
begin
  Lines.Add('# --- 11. Summary -------------------------------------------------------');
  Lines.Add('$endpoint = "ipc:" + $UnitName + "_http_json"');
  Lines.Add('');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host "  Environment ready." -ForegroundColor Green');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Runtime dir : $RuntimeDir"');
  Lines.Add('Write-Host "  Gen dir     : $GenDir"');
  Lines.Add('Write-Host "  Unit name   : $UnitName"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  In each of the three terminals, run:" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      $env:LINGOFUSE_RUNTIME = ' + CH_SQ + '$RuntimeDir' + CH_SQ + '"');
  Lines.Add('Write-Host "      cd `"$GenDir`""');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  [T1] Start the service:" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      Rscript .\$UnitName' + '_http_json_service.R"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  [T2] Start bridge.py:" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      python bridge.py --endpoint $endpoint --port 8081 --no-precheck"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  [T3] Run the call test:" -ForegroundColor Cyan');
  Lines.Add('Write-Host "      Rscript .\$UnitName' + '_http_json_call_main_test___.R"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  The service exits gracefully on Ctrl+C." -ForegroundColor Gray');
  Lines.Add('Write-Host ""');
  Lines.Add('');
  Lines.Add('exit 0');
end;

// ============================================================================
// Entry point
// ============================================================================

function GenerateRTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
  UnitName: TP_String;
begin
  Result := nil;
  if Model = nil then
  begin
    Log('GenerateRTestSetupScript: Model is nil');
    Exit;
  end;

  UnitName := Model.UnitName;
  if UnitName.Len = 0 then
  begin
    Log('GenerateRTestSetupScript: UnitName is empty');
    Exit;
  end;

  Lines := TPascalStringList.Create;
  try
    EmitSetupHeader(Lines);
    EmitSetupHelp(Lines);
    EmitSetupRequired(Lines);
    EmitSetupPaths(Lines);
    EmitSetupCheckR(Lines);
    EmitSetupPackages(Lines);
    EmitSetupRunSmoke(Lines);
    EmitSetupSummary(Lines);

    Result := Lines;
    Log(PFormat('Generated setup_r_tests.ps1: %d lines (unit=%s).',
      [Lines.Count, UnitName.Text]));
  finally
    if Result <> Lines then
      Lines.Free;
  end;
end;

initialization
  RegisterCodeGenEntry(
    'r', 'R test setup script',
    asBoth, akBuildScript,
    'setup_r_tests.ps1', True,
    @GenerateRTestSetupScript);

end.
