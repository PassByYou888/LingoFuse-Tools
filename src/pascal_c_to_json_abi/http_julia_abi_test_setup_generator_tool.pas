unit http_julia_abi_test_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core, Z.PascalStrings, Z.UPascalStrings,
  Z.Status, Z.UnicodeMixedLib, Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_json_abi_registry;

// GenerateJuliaTestSetupScript - produce setup_julia_tests.ps1.
// The returned list is owned by the caller and must be released with
// DisposeObject.
function GenerateJuliaTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

const
  CH_SQ = #39;                                    // single quote
  LF_DEFAULT_UUID = '3f2504e0-4f89-11d3-9a0c-0305e82c3301';
  JSON3_UUID      = '0f8b85d8-7281-11e9-16c2-39a750bddbf1';

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[http_julia_abi_test_setup_generator] %s', [Msg.Text]);
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[http_julia_abi_test_setup_generator] %s', [PFormat(Fmt, Args)]);
end;

// ============================================================================
// Section 1: header + param()
// ============================================================================

procedure EmitSetupHeader(Lines: TPascalStringList);
begin
  Lines.Add('#Requires -Version 5.1');
  Lines.Add('# ============================================================================');
  Lines.Add('# setup_julia_tests.ps1');
  Lines.Add('# AUTO-GENERATED by http_julia_abi_test_setup_generator_tool.pas.');
  Lines.Add('# Do not edit by hand: the generator re-emits this file from scratch.');
  Lines.Add('#');
  Lines.Add('# This script ONLY prepares the Julia test environment:');
  Lines.Add('#   1. Verifies the LingoFuse Julia binding source directory.');
  Lines.Add('#   2. Creates <LingoFuse>\julia\Project.toml if missing.');
  Lines.Add('#   3. Creates <GenDir>\Project.toml and adds LingoFuse + JSON3.');
  Lines.Add('#   4. Instantiates and precompiles the environment.');
  Lines.Add('#');
  Lines.Add('# It does NOT start the mesh, does NOT run any end-to-end test,');
  Lines.Add('# and does NOT need bridge.py.');
  Lines.Add('#');
  Lines.Add('# Required:');
  Lines.Add('#   -JuliaBindingDir   path to the LingoFuse Julia binding directory');
  Lines.Add('#                      (the one containing src\LingoFuse.jl).');
  Lines.Add('#');
  Lines.Add('# Run with -Help for the full usage text.');
  Lines.Add('# ============================================================================');
  Lines.Add('');
  Lines.Add('[CmdletBinding()]');
  Lines.Add('param(');
  Lines.Add('    [string]$JuliaBindingDir = "",');
  Lines.Add('    [string]$GenDir = "",');
  Lines.Add('    [string]$UnitName = "",');
  Lines.Add('    [string]$JuliaExe = "",');
  Lines.Add('    [switch]$Force,');
  Lines.Add('    [switch]$RunSmoke,');
  Lines.Add('    [switch]$Help');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$ErrorActionPreference = "Stop"');
  Lines.Add('');
  Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
  Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
  Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
  Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
  Lines.Add('');
end;

// ============================================================================
// Section 2: -Help
// ============================================================================

procedure EmitSetupHelp(Lines: TPascalStringList);
begin
  Lines.Add('# --- 1. -Help ----------------------------------------------------------');
  Lines.Add('if ($Help) {');
  Lines.Add('    $help = @' + CH_SQ);
  Lines.Add('Usage: setup_julia_tests.ps1 -JuliaBindingDir <path> [options]');
  Lines.Add('');
  Lines.Add('Prepares the Julia test environment for the generated HTTP/JSON binding.');
  Lines.Add('It verifies the LingoFuse Julia binding, creates a Project.toml that');
  Lines.Add('declares the binding as a path dependency, and precompiles.');
  Lines.Add('');
  Lines.Add('Required:');
  Lines.Add('  -JuliaBindingDir <path>');
  Lines.Add('        Path to the LingoFuse Julia binding directory.');
  Lines.Add('        Must contain:');
  Lines.Add('            src\LingoFuse.jl');
  Lines.Add('        Example:');
  Lines.Add('            D:\CoreLibrary\LingoFuse\julia');
  Lines.Add('');
  Lines.Add('Optional:');
  Lines.Add('  -GenDir <path>');
  Lines.Add('        Directory containing the four generated files.');
  Lines.Add('        Default: the directory containing this script.');
  Lines.Add('');
  Lines.Add('  -UnitName <name>');
  Lines.Add('        Source unit name, without extension.');
  Lines.Add('        Default: auto-detected from <name>_http_json_service.jl.');
  Lines.Add('');
  Lines.Add('  -JuliaExe <path>');
  Lines.Add('        Path to julia.exe.');
  Lines.Add('        Default: whatever julia.exe is on PATH.');
  Lines.Add('');
  Lines.Add('  -Force');
  Lines.Add('        Rebuild <GenDir>\Project.toml and Manifest.toml from scratch.');
  Lines.Add('        The LingoFuse Julia binding own Project.toml is never modified.');
  Lines.Add('');
  Lines.Add('  -RunSmoke');
  Lines.Add('        After preparing, immediately run the smoke test:');
  Lines.Add('            julia --project=<GenDir> --threads=2 .\<Unit>_http_json_service_main_test___.jl --smoke');
  Lines.Add('');
  Lines.Add('  -Help');
  Lines.Add('        Show this help text and exit.');
  Lines.Add('');
  Lines.Add('Example:');
  Lines.Add('  .\setup_julia_tests.ps1 `');
  Lines.Add('      -JuliaBindingDir D:\CoreLibrary\LingoFuse\julia -RunSmoke');
  Lines.Add('');
  Lines.Add('Exit codes:');
  Lines.Add('  0   success (or -Help was requested)');
  Lines.Add('  1   argument validation failed, missing file, or compile failed');
  Lines.Add(CH_SQ + '@');
  Lines.Add('    Write-Host $help');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 3: required parameter
// ============================================================================

procedure EmitSetupRequired(Lines: TPascalStringList);
begin
  Lines.Add('# --- 2. Required parameters --------------------------------------------');
  Lines.Add('if (-not $JuliaBindingDir) {');
  Lines.Add('    Write-Fail "-JuliaBindingDir is required."');
  Lines.Add('    Write-Host "        Run ' + CH_SQ + 'setup_julia_tests.ps1 -Help' + CH_SQ + ' for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 4: path resolution, unit detection, 4-file verification, julia.exe
// ============================================================================

procedure EmitSetupPaths(Lines: TPascalStringList);
begin
  Lines.Add('# --- 3. Resolve paths --------------------------------------------------');
  Lines.Add('$JuliaBindingDir = (Resolve-Path -LiteralPath $JuliaBindingDir).Path');
  Lines.Add('');
  Lines.Add('$LfSrc     = Join-Path $JuliaBindingDir "src"');
  Lines.Add('$LfEntry   = Join-Path $LfSrc "LingoFuse.jl"');
  Lines.Add('$LfProject = Join-Path $JuliaBindingDir "Project.toml"');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $LfEntry)) {');
  Lines.Add('    Write-Fail "-JuliaBindingDir does not look like the LingoFuse Julia binding."');
  Lines.Add('    Write-Fail "            Missing: $LfEntry"');
  Lines.Add('    Write-Fail "            Expected layout: <JuliaBindingDir>\src\LingoFuse.jl"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not $GenDir) { $GenDir = $PSScriptRoot }');
  Lines.Add('$GenDir = (Resolve-Path -LiteralPath $GenDir).Path');
  Lines.Add('');
  Lines.Add('Write-Info "JuliaBindingDir : $JuliaBindingDir"');
  Lines.Add('Write-Info "GenDir          : $GenDir"');
  Lines.Add('');
  Lines.Add('# --- 4. Detect UnitName if not supplied --------------------------------');
  Lines.Add('if (-not $UnitName) {');
  Lines.Add('    $candidate = Get-ChildItem -LiteralPath $GenDir -Filter "*_http_json_service.jl" -File | Select-Object -First 1');
  Lines.Add('    if ($null -eq $candidate) {');
  Lines.Add('        Write-Fail "Cannot detect UnitName (no *_http_json_service.jl in $GenDir)."');
  Lines.Add('        Write-Fail "            Pass -UnitName explicitly."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    $UnitName = $candidate.Name -replace ' + CH_SQ + '_http_json_service\.jl$' + CH_SQ + ', ' + CH_SQ + CH_SQ);
  Lines.Add('}');
  Lines.Add('Write-Info "UnitName        : $UnitName"');
  Lines.Add('');
  Lines.Add('# --- 5. Verify the four generated files --------------------------------');
  Lines.Add('$serviceJl     = Join-Path $GenDir ("$UnitName" + "_http_json_service.jl")');
  Lines.Add('$callJl        = Join-Path $GenDir ("$UnitName" + "_http_json_call.jl")');
  Lines.Add('$serviceTestJl = Join-Path $GenDir ("$UnitName" + "_http_json_service_main_test___.jl")');
  Lines.Add('$callTestJl    = Join-Path $GenDir ("$UnitName" + "_http_json_call_main_test___.jl")');
  Lines.Add('');
  Lines.Add('$missing = @()');
  Lines.Add('foreach ($p in @($serviceJl, $callJl, $serviceTestJl, $callTestJl)) {');
  Lines.Add('    if (-not (Test-Path -LiteralPath $p)) { $missing += $p }');
  Lines.Add('}');
  Lines.Add('if ($missing.Count -gt 0) {');
  Lines.Add('    Write-Fail "Missing generated files:"');
  Lines.Add('    foreach ($m in $missing) { Write-Host "        $m" }');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "All four generated files present."');
  Lines.Add('');
  Lines.Add('# --- 6. Verify julia.exe -----------------------------------------------');
  Lines.Add('if (-not $JuliaExe) {');
  Lines.Add('    $juliaCmd = Get-Command julia -ErrorAction SilentlyContinue');
  Lines.Add('    if ($null -eq $juliaCmd) {');
  Lines.Add('        Write-Fail "julia.exe is not on PATH."');
  Lines.Add('        Write-Fail "            Install Julia 1.9+ and add its bin directory to PATH,"');
  Lines.Add('        Write-Fail "            or pass -JuliaExe <path-to-julia.exe>."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    $JuliaExe = $juliaCmd.Source');
  Lines.Add('}');
  Lines.Add('if (-not (Test-Path -LiteralPath $JuliaExe)) {');
  Lines.Add('    Write-Fail "julia.exe not found at: $JuliaExe"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "julia.exe       : $JuliaExe"');
  Lines.Add('');
end;

// ============================================================================
// Section 5: ensure LingoFuse\julia\Project.toml
// ============================================================================

procedure EmitSetupLfProjectToml(Lines: TPascalStringList);
begin
  Lines.Add('# --- 7. Ensure LingoFuse\julia\Project.toml exists ---------------------');
  Lines.Add('#');
  Lines.Add('# The LingoFuse Julia binding ships as a plain "package directory"');
  Lines.Add('# (just src\LingoFuse.jl + .jl files). Pkg.develop requires a');
  Lines.Add('# Project.toml to declare its name/uuid/deps, so we create one if');
  Lines.Add('# missing. If the file already exists, it is NEVER modified here.');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $LfProject)) {');
  Lines.Add('    $lfToml = @' + CH_SQ);
  Lines.Add('name = "LingoFuse"');
  Lines.Add('uuid = "' + LF_DEFAULT_UUID + '"');
  Lines.Add('version = "0.2.0"');
  Lines.Add('');
  Lines.Add('[deps]');
  Lines.Add('JSON3 = "' + JSON3_UUID + '"');
  Lines.Add(CH_SQ + '@');
  Lines.Add('    Set-Content -LiteralPath $LfProject -Value $lfToml -Encoding UTF8');
  Lines.Add('    Write-Ok "Created $LfProject"');
  Lines.Add('} else {');
  Lines.Add('    Write-Ok "$LfProject already exists (left untouched)"');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 6: configure <GenDir>\Project.toml + instantiate + precompile
// ============================================================================

procedure EmitSetupGenProjectToml(Lines: TPascalStringList);
begin
  Lines.Add('# --- 8. Configure <GenDir>\Project.toml --------------------------------');
  Lines.Add('$GenProject  = Join-Path $GenDir "Project.toml"');
  Lines.Add('$GenManifest = Join-Path $GenDir "Manifest.toml"');
  Lines.Add('');
  Lines.Add('if ($Force) {');
  Lines.Add('    if (Test-Path -LiteralPath $GenProject)  { Remove-Item -LiteralPath $GenProject  -Force }');
  Lines.Add('    if (Test-Path -LiteralPath $GenManifest) { Remove-Item -LiteralPath $GenManifest -Force }');
  Lines.Add('    Write-Info "Removed existing Project.toml / Manifest.toml"');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('# Hide any stale JULIA_LOAD_PATH that would break --project.');
  Lines.Add('# Pkg.develop path=... uses the LingoFuse\julia\Project.toml we');
  Lines.Add('# just ensured above.');
  Lines.Add('$savedLoadPath = $env:JULIA_LOAD_PATH');
  Lines.Add('$env:JULIA_LOAD_PATH = "@;@v#.#;@stdlib"');
  Lines.Add('');
  Lines.Add('Write-Info "Configuring Julia project at $GenDir ..."');
  Lines.Add('');
  Lines.Add('$juliaSetupScript = @' + CH_SQ);
  Lines.Add('using Pkg');
  Lines.Add('Pkg.activate(ARGS[1])');
  Lines.Add('Pkg.add("JSON3")');
  Lines.Add('Pkg.develop(path=ARGS[2])');
  Lines.Add('Pkg.instantiate()');
  Lines.Add('Pkg.precompile()');
  Lines.Add(CH_SQ + '@');
  Lines.Add('');
  Lines.Add('Push-Location $GenDir');
  Lines.Add('try {');
  Lines.Add('    & $JuliaExe --project=$GenDir -e $juliaSetupScript -- $GenDir $JuliaBindingDir');
  Lines.Add('    if ($LASTEXITCODE -ne 0) {');
  Lines.Add('        Write-Fail "Pkg setup failed (exit $LASTEXITCODE)"');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('} finally {');
  Lines.Add('    Pop-Location');
  Lines.Add('    $env:JULIA_LOAD_PATH = $savedLoadPath');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $GenProject)) {');
  Lines.Add('    Write-Fail "Expected $GenProject, but it was not created."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "Configured $GenProject"');
  Lines.Add('');
end;

// ============================================================================
// Section 7: summary + next steps
// ============================================================================

procedure EmitSetupSummary(Lines: TPascalStringList);
begin
  Lines.Add('# --- 9. Summary --------------------------------------------------------');
  Lines.Add('$endpoint = "ipc:" + $UnitName + "_http_json"');
  Lines.Add('');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host "  Environment ready." -ForegroundColor Green');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Project : $GenProject"');
  Lines.Add('Write-Host "  Binding : $JuliaBindingDir"');
  Lines.Add('Write-Host "  Julia   : $JuliaExe"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  1) Smoke test (in-process; no bridge, no network):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "       julia --project=$GenDir --threads=2 .\$UnitName`_http_json_service_main_test___.jl --smoke"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  2) End-to-end (three terminals):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "       [T1] julia --project=$GenDir --threads=2 .\$UnitName`_http_json_service_main_test___.jl"');
  Lines.Add('Write-Host "       [T2] python bridge.py --endpoint $endpoint --port 8081 --no-precheck"');
  Lines.Add('Write-Host "       [T3] julia --project=$GenDir --threads=2 .\$UnitName`_http_json_call_main_test___.jl"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Exit code 0 means success." -ForegroundColor Gray');
  Lines.Add('Write-Host ""');
  Lines.Add('');
end;

// ============================================================================
// Section 8: optional -RunSmoke
// ============================================================================

procedure EmitSetupRunSmoke(Lines: TPascalStringList);
begin
  Lines.Add('# --- 10. Optional: run smoke immediately -------------------------------');
  Lines.Add('if ($RunSmoke) {');
  Lines.Add('    Write-Info "Running smoke test..."');
  Lines.Add('    Push-Location $GenDir');
  Lines.Add('    try {');
  Lines.Add('        & $JuliaExe --project=$GenDir --threads=2 ("$UnitName" + "_http_json_service_main_test___.jl") --smoke');
  Lines.Add('        $smokeCode = $LASTEXITCODE');
  Lines.Add('    } finally {');
  Lines.Add('        Pop-Location');
  Lines.Add('    }');
  Lines.Add('    if ($smokeCode -ne 0) {');
  Lines.Add('        Write-Fail "smoke test failed (exit $smokeCode)"');
  Lines.Add('        exit $smokeCode');
  Lines.Add('    }');
  Lines.Add('    Write-Ok "smoke test passed."');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('exit 0');
end;

// ============================================================================
// Entry point
// ============================================================================

function GenerateJuliaTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
  UnitName: TP_String;
begin
  Result := nil;
  if Model = nil then
  begin
    Log('GenerateJuliaTestSetupScript: Model is nil');
    Exit;
  end;

  UnitName := Model.UnitName;
  if UnitName.Len = 0 then
  begin
    Log('GenerateJuliaTestSetupScript: UnitName is empty');
    Exit;
  end;

  Lines := TPascalStringList.Create;
  try
    EmitSetupHeader(Lines);
    EmitSetupHelp(Lines);
    EmitSetupRequired(Lines);
    EmitSetupPaths(Lines);
    EmitSetupLfProjectToml(Lines);
    EmitSetupGenProjectToml(Lines);
    EmitSetupSummary(Lines);
    EmitSetupRunSmoke(Lines);

    Result := Lines;
    Log(PFormat('Generated setup_julia_tests.ps1: %d lines (unit=%s).',
      [Lines.Count, UnitName.Text]));
  finally
    if Result <> Lines then
      Lines.Free;
  end;
end;

initialization
  RegisterCodeGenEntry(
    'julia', 'Julia test setup script',
    asBoth, akBuildScript,
    'setup_julia_tests.ps1', True,
    @GenerateJuliaTestSetupScript);
end.
