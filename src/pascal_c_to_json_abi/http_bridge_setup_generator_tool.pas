unit http_bridge_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core, Z.PascalStrings, Z.UPascalStrings,
  Z.Status, Z.UnicodeMixedLib, Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_json_abi_registry;

function GenerateBridgeSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

const
  CH_SQ: string = #39;

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[http_bridge_setup_generator] %s', [Msg.Text]);
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[http_bridge_setup_generator] %s', [PFormat(Fmt, Args)]);
end;

procedure EmitHeader(Lines: TPascalStringList);
begin
  Lines.Add('#Requires -Version 5.1');
  Lines.Add('# ============================================================================');
  Lines.Add('# launch_bridge.ps1');
  Lines.Add('# AUTO-GENERATED by http_bridge_setup_generator_tool.pas.');
  Lines.Add('# Do not edit by hand: the generator re-emits this file from scratch.');
  Lines.Add('#');
  Lines.Add('# Idiot-proof launcher for the LingoFuse HTTP bridge (bridge.py).');
  Lines.Add('#');
  Lines.Add('# Required:');
  Lines.Add('#   -PyDir   path to the directory containing bridge.py');
  Lines.Add('#            (e.g. D:\...\LingoFuse\python\lingofuse)');
  Lines.Add('#');
  Lines.Add('# Optional:');
  Lines.Add('#   -UnitName  source unit name (used to derive the endpoint)');
  Lines.Add('#              default: auto-detect from GenDir');
  Lines.Add('#   -Endpoint  explicit LingoFuse endpoint');
  Lines.Add('#              (overrides -UnitName derived value)');
  Lines.Add('#   -Port      HTTP port bridge.py listens on (default: 8081)');
  Lines.Add('#   -PyExe     path to python.exe (default: python.exe on PATH)');
  Lines.Add('#   -NoPrecheck pass --no-precheck to bridge.py');
  Lines.Add('#   -DryRun    print the resolved command line and exit');
  Lines.Add('#   -Help      show this help and exit');
  Lines.Add('#');
  Lines.Add('# The resolved command line is:');
  Lines.Add('#   <PyExe> <PyDir>\bridge.py --endpoint <Endpoint> --port <Port>');
  Lines.Add('#');
  Lines.Add('# Usage:');
  Lines.Add('#   .\launch_bridge.ps1 -PyDir D:\...\LingoFuse\python\lingofuse');
  Lines.Add('#   .\launch_bridge.ps1 -PyDir .\lingofuse -UnitName ComplexTestUnit');
  Lines.Add('#   .\launch_bridge.ps1 -PyDir .\lingofuse -Endpoint ipc:my_app_http_json');
  Lines.Add('# ============================================================================');
  Lines.Add('');
  Lines.Add('[CmdletBinding()]');
  Lines.Add('param(');
  Lines.Add('    [string]$PyDir = "",');
  Lines.Add('    [string]$UnitName = "",');
  Lines.Add('    [string]$Endpoint = "",');
  Lines.Add('    [int]$Port = 8081,');
  Lines.Add('    [string]$PyExe = "",');
  Lines.Add('    [switch]$NoPrecheck,');
  Lines.Add('    [switch]$DryRun,');
  Lines.Add('    [switch]$Help');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$ErrorActionPreference = "Stop"');
  Lines.Add('');
  Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
  Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
  Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
  Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
  Lines.Add('');
end;

procedure EmitHelp(Lines: TPascalStringList);
begin
  Lines.Add('if ($Help) {');
  Lines.Add('    Write-Host "Usage: launch_bridge.ps1 -PyDir <path> [options]"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Idiot-proof launcher for the LingoFuse HTTP bridge (bridge.py)."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Required:"');
  Lines.Add('    Write-Host "  -PyDir <path>"');
  Lines.Add('    Write-Host "        Directory that contains bridge.py."');
  Lines.Add('    Write-Host "        Example: D:\CoreLibrary\LingoFuse\python\lingofuse"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Optional:"');
  Lines.Add('    Write-Host "  -UnitName <name>   Source unit name (endpoint auto-derived)."');
  Lines.Add('    Write-Host "  -Endpoint <ep>     Explicit endpoint (overrides -UnitName)."');
  Lines.Add('    Write-Host "  -Port <n>          HTTP port (default: 8081)."');
  Lines.Add('    Write-Host "  -PyExe <path>      Python interpreter (default: python.exe)."');
  Lines.Add('    Write-Host "  -NoPrecheck        Pass --no-precheck to bridge.py."');
  Lines.Add('    Write-Host "  -DryRun            Print the resolved command and exit."');
  Lines.Add('    Write-Host "  -Help              Show this help."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Exit codes:"');
  Lines.Add('    Write-Host "  0   bridge.py exited cleanly"');
  Lines.Add('    Write-Host "  1   validation failed or bridge.py returned non-zero"');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
end;

procedure EmitValidation(Lines: TPascalStringList);
begin
  Lines.Add('if (-not $PyDir) {');
  Lines.Add('    Write-Fail "-PyDir is required."');
  Lines.Add('    Write-Host "        Run ''launch_bridge.ps1 -Help'' for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath $PyDir)) {');
  Lines.Add('    Write-Fail "PyDir not found: $PyDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$PyDir = (Resolve-Path -LiteralPath $PyDir).Path');
  Lines.Add('');
  Lines.Add('$bridgePy = Join-Path $PyDir "bridge.py"');
  Lines.Add('if (-not (Test-Path -LiteralPath $bridgePy)) {');
  Lines.Add('    Write-Fail "bridge.py not found under PyDir:"');
  Lines.Add('    Write-Fail "            $bridgePy"');
  Lines.Add('    Write-Fail "            -PyDir must contain bridge.py."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not $PyExe) { $PyExe = "python.exe" }');
  Lines.Add('');
  Lines.Add('if (-not $Endpoint) {');
  Lines.Add('    if (-not $UnitName) {');
  Lines.Add('        $candidate = $null');
  Lines.Add('        $candidate = Get-ChildItem -LiteralPath $PSScriptRoot -Filter "*_http_json_service*" -File -ErrorAction SilentlyContinue | Select-Object -First 1');
  Lines.Add('        if ($null -eq $candidate) {');
  Lines.Add('            $candidate = Get-ChildItem -LiteralPath (Get-Location).Path -Filter "*_http_json_service*" -File -ErrorAction SilentlyContinue | Select-Object -First 1');
  Lines.Add('        }');
  Lines.Add('        if ($null -ne $candidate) {');
  Lines.Add('            $n = $candidate.Name');
  Lines.Add('            $UnitName = $n -replace ' + CH_SQ + '_http_json_service.*$' + CH_SQ + ', ' + CH_SQ + CH_SQ);
  Lines.Add('            $UnitName = $UnitName -replace ' + CH_SQ + '^' + CH_SQ + ', ' + CH_SQ + CH_SQ);
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('    if (-not $UnitName) {');
  Lines.Add('        Write-Fail "Cannot derive Endpoint: -UnitName and -Endpoint are both empty."');
  Lines.Add('        Write-Fail "            Pass -Endpoint ipc:<UnitName>_http_json explicitly."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    $Endpoint = "ipc:${UnitName}_http_json"');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$argv = @(');
  Lines.Add('    $bridgePy,');
  Lines.Add('    "--endpoint", $Endpoint,');
  Lines.Add('    "--port", "$Port"');
  Lines.Add(')');
  Lines.Add('if ($NoPrecheck) { $argv += "--no-precheck" }');
  Lines.Add('');
end;

procedure EmitRun(Lines: TPascalStringList);
begin
  Lines.Add('Write-Info "PyExe    : $PyExe"');
  Lines.Add('Write-Info "PyDir    : $PyDir"');
  Lines.Add('Write-Info "Endpoint : $Endpoint"');
  Lines.Add('Write-Info "Port     : $Port"');
  Lines.Add('Write-Info "Precheck : $([bool](-not $NoPrecheck))"');
  Lines.Add('');
  Lines.Add('$quoted = foreach ($a in $argv) {');
  Lines.Add('    if ($a -match ''\s'') { ''"'' + $a + ''"'' } else { $a }');
  Lines.Add('}');
  Lines.Add('Write-Info ("Command  : " + $PyExe + " " + ($quoted -join " "))');
  Lines.Add('');
  Lines.Add('if ($DryRun) {');
  Lines.Add('    Write-Ok "DryRun: not launching."');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host "  Launching bridge.py (Ctrl+C to stop)" -ForegroundColor Green');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host ""');
  Lines.Add('');
  Lines.Add('Push-Location $PyDir');
  Lines.Add('try {');
  Lines.Add('    & $PyExe @argv');
  Lines.Add('    $rc = $LASTEXITCODE');
  Lines.Add('} finally {');
  Lines.Add('    Pop-Location');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if ($rc -ne 0) {');
  Lines.Add('    Write-Fail "bridge.py exited with code $rc."');
  Lines.Add('    exit $rc');
  Lines.Add('}');
  Lines.Add('Write-Ok "bridge.py exited cleanly."');
  Lines.Add('exit 0');
end;

function GenerateBridgeSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
begin
  Result := nil;
  if Model = nil then
  begin
    Log('Model is nil');
    Exit;
  end;

  Lines := TPascalStringList.Create;
  try
    EmitHeader(Lines);
    EmitHelp(Lines);
    EmitValidation(Lines);
    EmitRun(Lines);
    Result := Lines;
    Log('Generated launch_bridge.ps1');
  finally
    if Result <> Lines then Lines.Free;
  end;
end;

initialization
  RegisterCodeGenEntry(
    'bridge', 'Bridge launcher script',
    asBoth, akBuildScript,
    'launch_bridge.ps1', True,
    @GenerateBridgeSetupScript);

end.
