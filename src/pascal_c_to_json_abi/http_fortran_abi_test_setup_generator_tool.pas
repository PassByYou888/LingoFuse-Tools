unit http_fortran_abi_test_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core, Z.PascalStrings, Z.UPascalStrings,
  Z.Status, Z.UnicodeMixedLib, Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_json_abi_registry;

// GenerateFortranTestSetupScript - produce setup_fortran_tests.ps1.
// The returned list is owned by the caller and must be released with
// DisposeObject.
function GenerateFortranTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

const
  CH_SQ = #39;   // single quote, ASCII 0x27

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
  begin
    DoStatus('[http_fortran_abi_test_setup_generator] %s', [Msg.Text]);
  end;
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
  begin
    DoStatus('[http_fortran_abi_test_setup_generator] %s', [PFormat(Fmt, Args)]);
  end;
end;

// ============================================================================
// Section 1: header + param()
// ============================================================================

procedure EmitSetupHeader(Lines: TPascalStringList);
begin
  Lines.Add('#Requires -Version 5.1');
  Lines.Add('# ============================================================================');
  Lines.Add('# setup_fortran_tests.ps1');
  Lines.Add('# AUTO-GENERATED by http_fortran_abi_test_setup_generator_tool.pas.');
  Lines.Add('# Do not edit by hand: the generator re-emits this file from scratch.');
  Lines.Add('#');
  Lines.Add('# This script ONLY prepares the Fortran test environment:');
  Lines.Add('#   1. Verifies the LingoFuse Fortran binding sources.');
  Lines.Add('#   2. Compiles the binding + generated modules + test programs.');
  Lines.Add('#   3. Links service_test.exe and call_test.exe.');
  Lines.Add('#   4. Copies runtime DLLs if -RuntimeDir is provided.');
  Lines.Add('#');
  Lines.Add('# It does NOT start the mesh, does NOT run any test, and does NOT need');
  Lines.Add('# bridge.py.');
  Lines.Add('#');
  Lines.Add('# Required:');
  Lines.Add('#   -FortranLibDir   path to the LingoFuse Fortran binding directory.');
  Lines.Add('#                    Must contain lf_fortran_mod.f90, lf_fortran.cpp,');
  Lines.Add('#                    LingoFuse.c, LingoFuse.h, lf_fortran.h.');
  Lines.Add('#');
  Lines.Add('# Run with -Help for the full usage text.');
  Lines.Add('# ============================================================================');
  Lines.Add('');
  Lines.Add('[CmdletBinding()]');
  Lines.Add('param(');
  Lines.Add('    [string]$FortranLibDir = "",');
  Lines.Add('    [string]$GenDir = "",');
  Lines.Add('    [string]$UnitName = "",');
  Lines.Add('    [string]$RuntimeDir = "",');
  Lines.Add('    [switch]$Force,');
  Lines.Add('    [switch]$RunSmoke,');
  Lines.Add('    [switch]$Help');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$ErrorActionPreference = "Stop"');
  Lines.Add('');
  Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
  Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
  Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
  Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
  Lines.Add('');
end;

// ============================================================================
// Section 2: -Help (plain Write-Host lines; no here-string, so no single
// quotes need escaping)
// ============================================================================

procedure EmitSetupHelp(Lines: TPascalStringList);
begin
  Lines.Add('# --- 1. -Help ----------------------------------------------------------');
  Lines.Add('if ($Help) {');
  Lines.Add('    Write-Host "Usage: setup_fortran_tests.ps1 -FortranLibDir <path> [options]"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Prepares the Fortran test environment for the generated HTTP/JSON binding."');
  Lines.Add('    Write-Host "It compiles the binding + generated modules, links the two test"');
  Lines.Add('    Write-Host "executables, and optionally copies runtime DLLs."');
  Lines.Add('    Write-Host "It does NOT run any test and does NOT need bridge.py."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Required:"');
  Lines.Add('    Write-Host "  -FortranLibDir <path>"');
  Lines.Add('    Write-Host "        Path to the LingoFuse Fortran binding directory. Must contain:"');
  Lines.Add('    Write-Host "            lf_fortran_mod.f90"');
  Lines.Add('    Write-Host "            lf_fortran.cpp"');
  Lines.Add('    Write-Host "            LingoFuse.c"');
  Lines.Add('    Write-Host "            LingoFuse.h"');
  Lines.Add('    Write-Host "            lf_fortran.h"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Optional:"');
  Lines.Add('    Write-Host "  -GenDir <path>       Generated .f90 directory (default: script dir)."');
  Lines.Add('    Write-Host "  -UnitName <name>     Source unit name (default: auto-detect)."');
  Lines.Add('    Write-Host "  -RuntimeDir <path>   Directory with LingoFuse64.dll (default: auto-detect)."');
  Lines.Add('    Write-Host "  -Force               Overwrite existing _build_fortran directory."');
  Lines.Add('    Write-Host "  -RunSmoke            Run service_test.exe --smoke after build."');
  Lines.Add('    Write-Host "  -Help                Show this help text and exit."');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Example:"');
  Lines.Add('    Write-Host "  .\setup_fortran_tests.ps1 -FortranLibDir D:\CoreLibrary\LingoFuse\fortran\c_ext -RunSmoke"');
  Lines.Add('    Write-Host ""');
  Lines.Add('    Write-Host "Exit codes:"');
  Lines.Add('    Write-Host "  0   success (or -Help was requested)"');
  Lines.Add('    Write-Host "  1   argument validation failed, missing file, or build failed"');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 3: required parameter
// ============================================================================

procedure EmitSetupRequired(Lines: TPascalStringList);
begin
  Lines.Add('# --- 2. Required parameters --------------------------------------------');
  Lines.Add('if (-not $FortranLibDir) {');
  Lines.Add('    Write-Fail "-FortranLibDir is required."');
  Lines.Add('    Write-Host "        Run ' + CH_SQ + 'setup_fortran_tests.ps1 -Help' + CH_SQ + ' for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 4: path resolution, unit detection, source verification, compiler
// check
// ============================================================================

procedure EmitSetupPaths(Lines: TPascalStringList);
begin
  Lines.Add('# --- 3. Resolve FortranLibDir ------------------------------------------');
  Lines.Add('if (-not (Test-Path -LiteralPath $FortranLibDir)) {');
  Lines.Add('    Write-Fail "FortranLibDir not found: $FortranLibDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$FortranLibDir = (Resolve-Path -LiteralPath $FortranLibDir).Path');
  Lines.Add('');
  Lines.Add('$required = @("lf_fortran_mod.f90", "lf_fortran.cpp", "LingoFuse.c", "LingoFuse.h", "lf_fortran.h")');
  Lines.Add('foreach ($f in $required) {');
  Lines.Add('    $p = Join-Path $FortranLibDir $f');
  Lines.Add('    if (-not (Test-Path -LiteralPath $p)) {');
  Lines.Add('        Write-Fail "Missing $f in $FortranLibDir"');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('# --- 4. Resolve GenDir -------------------------------------------------');
  Lines.Add('if (-not $GenDir) { $GenDir = $PSScriptRoot }');
  Lines.Add('if (-not (Test-Path -LiteralPath $GenDir)) {');
  Lines.Add('    Write-Fail "GenDir not found: $GenDir"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$GenDir = (Resolve-Path -LiteralPath $GenDir).Path');
  Lines.Add('');
  Lines.Add('# --- 5. Detect UnitName if not supplied --------------------------------');
  Lines.Add('if (-not $UnitName) {');
  Lines.Add('    $candidate = Get-ChildItem -LiteralPath $GenDir -Filter "*_http_json_service_mod.f90" -File | Select-Object -First 1');
  Lines.Add('    if ($null -eq $candidate) {');
  Lines.Add('        Write-Fail "Cannot detect UnitName (no *_http_json_service_mod.f90 in $GenDir)."');
  Lines.Add('        Write-Fail "            Pass -UnitName explicitly."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    $UnitName = $candidate.Name -replace ' + CH_SQ + '_http_json_service_mod\.f90$' + CH_SQ + ', ' + CH_SQ + CH_SQ);
  Lines.Add('}');
  Lines.Add('Write-Info "UnitName: $UnitName"');
  Lines.Add('');
  Lines.Add('# --- 6. Verify the four generated files --------------------------------');
  Lines.Add('$svcMod   = Join-Path $GenDir ("$UnitName" + "_http_json_service_mod.f90")');
  Lines.Add('$callMod  = Join-Path $GenDir ("$UnitName" + "_http_json_call_mod.f90")');
  Lines.Add('$svcTest  = Join-Path $GenDir ("$UnitName" + "_http_json_service_main_test___.f90")');
  Lines.Add('$callTest = Join-Path $GenDir ("$UnitName" + "_http_json_call_main_test___.f90")');
  Lines.Add('');
  Lines.Add('$missing = @()');
  Lines.Add('foreach ($p in @($svcMod, $callMod, $svcTest, $callTest)) {');
  Lines.Add('    if (-not (Test-Path -LiteralPath $p)) { $missing += $p }');
  Lines.Add('}');
  Lines.Add('if ($missing.Count -gt 0) {');
  Lines.Add('    Write-Fail "Missing generated files:"');
  Lines.Add('    foreach ($m in $missing) { Write-Host "        $m" }');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "All four generated files present."');
  Lines.Add('');
  Lines.Add('# --- 7. Auto-detect RuntimeDir (optional) ------------------------------');
  Lines.Add('if (-not $RuntimeDir) {');
  Lines.Add('    $probe = $FortranLibDir');
  Lines.Add('    for ($i = 0; $i -lt 6; $i++) {');
  Lines.Add('        $cand = Join-Path $probe "Binary"');
  Lines.Add('        $dll = Join-Path $cand "LingoFuse64.dll"');
  Lines.Add('        if (Test-Path -LiteralPath $dll) { $RuntimeDir = $cand; break }');
  Lines.Add('        $parent = Split-Path -Parent $probe');
  Lines.Add('        if (-not $parent -or $parent -eq $probe) { break }');
  Lines.Add('        $probe = $parent');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('if ($RuntimeDir) {');
  Lines.Add('    Write-Info "RuntimeDir: $RuntimeDir"');
  Lines.Add('} else {');
  Lines.Add('    Write-Warn "RuntimeDir not set; make sure LingoFuse64.dll is on PATH."');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('# --- 8. Verify compilers are on PATH -----------------------------------');
  Lines.Add('foreach ($t in @("gfortran", "g++", "gcc")) {');
  Lines.Add('    if (-not (Get-Command $t -ErrorAction SilentlyContinue)) {');
  Lines.Add('        Write-Fail "$t not found on PATH."');
  Lines.Add('        Write-Fail "            Install MinGW-w64 and add its bin directory to PATH."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 5: build
// ============================================================================

procedure EmitSetupBuild(Lines: TPascalStringList);
begin
  Lines.Add('# --- 9. Prepare build directory ----------------------------------------');
  Lines.Add('$buildDir = Join-Path $GenDir "_build_fortran"');
  Lines.Add('if ($Force -and (Test-Path -LiteralPath $buildDir)) {');
  Lines.Add('    Remove-Item -LiteralPath $buildDir -Recurse -Force');
  Lines.Add('}');
  Lines.Add('New-Item -ItemType Directory -Path $buildDir -Force | Out-Null');
  Lines.Add('');
  Lines.Add('Write-Info "FortranLibDir: $FortranLibDir"');
  Lines.Add('Write-Info "GenDir       : $GenDir"');
  Lines.Add('Write-Info "BuildDir     : $buildDir"');
  Lines.Add('');
  Lines.Add('# --- 10. Compile ------------------------------------------------------');
  Lines.Add('Push-Location $buildDir');
  Lines.Add('$buildOk = $false');
  Lines.Add('try {');
  Lines.Add('    $inc = @("-I$FortranLibDir", "-I$GenDir", "-I.")');
  Lines.Add('    $mod = @("-J.", "-I.")');
  Lines.Add('');
  Lines.Add('    Write-Host "[1/8] gfortran -c lf_fortran_mod.f90" -ForegroundColor Yellow');
  Lines.Add('    & gfortran -c (Join-Path $FortranLibDir "lf_fortran_mod.f90") -o lf_fortran_mod.o @mod');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { throw "step 1: compile lf_fortran_mod.f90 failed" }');
  Lines.Add('');
  Lines.Add('    Write-Host "[2/8] g++ -c lf_fortran.cpp" -ForegroundColor Yellow');
  Lines.Add('    & g++ -std=c++17 -O2 -c (Join-Path $FortranLibDir "lf_fortran.cpp") -o lf_fortran.o @inc');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { throw "step 2: compile lf_fortran.cpp failed" }');
  Lines.Add('');
  Lines.Add('    Write-Host "[3/8] gcc -c LingoFuse.c" -ForegroundColor Yellow');
  Lines.Add('    & gcc -std=c11 -O2 -c (Join-Path $FortranLibDir "LingoFuse.c") -o LingoFuse.o @inc');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { throw "step 3: compile LingoFuse.c failed" }');
  Lines.Add('');
  Lines.Add('    Write-Host "[4/8] gfortran -c service_mod.f90" -ForegroundColor Yellow');
  Lines.Add('    & gfortran -c $svcMod -o svc_mod.o @mod');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { throw "step 4: compile service_mod.f90 failed" }');
  Lines.Add('');
  Lines.Add('    Write-Host "[5/8] gfortran -c call_mod.f90" -ForegroundColor Yellow');
  Lines.Add('    & gfortran -c $callMod -o call_mod.o @mod');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { throw "step 5: compile call_mod.f90 failed" }');
  Lines.Add('');
  Lines.Add('    Write-Host "[6/8] gfortran -c service_main_test___.f90" -ForegroundColor Yellow');
  Lines.Add('    & gfortran -c $svcTest -o svc_test.o @mod');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { throw "step 6: compile service_main_test___.f90 failed" }');
  Lines.Add('');
  Lines.Add('    Write-Host "[7/8] gfortran -c call_main_test___.f90" -ForegroundColor Yellow');
  Lines.Add('    & gfortran -c $callTest -o call_test.o @mod');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { throw "step 7: compile call_main_test___.f90 failed" }');
  Lines.Add('');
  Lines.Add('    Write-Host "[8/8] Linking service_test.exe and call_test.exe" -ForegroundColor Yellow');
  Lines.Add('    & g++ svc_test.o svc_mod.o lf_fortran_mod.o lf_fortran.o LingoFuse.o -lgfortran -lstdc++ -o service_test.exe');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { throw "link service_test.exe failed" }');
  Lines.Add('');
  Lines.Add('    & g++ call_test.o call_mod.o lf_fortran_mod.o lf_fortran.o LingoFuse.o -lgfortran -lstdc++ -o call_test.exe');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { throw "link call_test.exe failed" }');
  Lines.Add('');
  Lines.Add('    $buildOk = $true');
  Lines.Add('} catch {');
  Lines.Add('    Write-Fail $_.Exception.Message');
  Lines.Add('} finally {');
  Lines.Add('    Pop-Location');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not $buildOk) {');
  Lines.Add('    Write-Fail "Build failed; see messages above."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "Build completed."');
  Lines.Add('');
end;

// ============================================================================
// Section 6: copy runtime DLLs
// ============================================================================

procedure EmitSetupCopyDlls(Lines: TPascalStringList);
begin
  Lines.Add('# --- 11. Copy runtime DLLs --------------------------------------------');
  Lines.Add('if ($RuntimeDir) {');
  Lines.Add('    foreach ($dll in @("LingoFuse64.dll", "z_ipc_64.dll", "mimalloc64.dll")) {');
  Lines.Add('        $src = Join-Path $RuntimeDir $dll');
  Lines.Add('        if (Test-Path -LiteralPath $src) {');
  Lines.Add('            Copy-Item -LiteralPath $src -Destination $buildDir -Force');
  Lines.Add('            Write-Ok "Copied $dll"');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('} else {');
  Lines.Add('    Write-Warn "Skipped DLL copy; make sure LingoFuse64.dll is on PATH."');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 7: summary and next steps
// ============================================================================

procedure EmitSetupSummary(Lines: TPascalStringList);
begin
  Lines.Add('# --- 12. Summary -------------------------------------------------------');
  Lines.Add('$endpoint = "ipc:" + $UnitName + "_http_json"');
  Lines.Add('');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host "  Environment ready." -ForegroundColor Green');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  BuildDir : $buildDir"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  1) Smoke test (in-process; no bridge, no network):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "       cd $buildDir"');
  Lines.Add('Write-Host "       .\service_test.exe --smoke"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  2) End-to-end (three terminals):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "       [T1] cd $buildDir ; .\service_test.exe"');
  Lines.Add('Write-Host "       [T2] python bridge.py --endpoint $endpoint --port 8081 --no-precheck"');
  Lines.Add('Write-Host "       [T3] cd $buildDir ; .\call_test.exe"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  Exit code 0 means success." -ForegroundColor Gray');
  Lines.Add('Write-Host ""');
  Lines.Add('');
end;

// ============================================================================
// Section 8: optional -RunSmoke
// ============================================================================

procedure EmitSetupRunSmoke(Lines: TPascalStringList);
begin
  Lines.Add('# --- 13. Optional: run smoke immediately -------------------------------');
  Lines.Add('if ($RunSmoke) {');
  Lines.Add('    Write-Info "Running smoke test..."');
  Lines.Add('    Push-Location $buildDir');
  Lines.Add('    try {');
  Lines.Add('        & .\service_test.exe --smoke');
  Lines.Add('        $smokeCode = $LASTEXITCODE');
  Lines.Add('    } finally {');
  Lines.Add('        Pop-Location');
  Lines.Add('    }');
  Lines.Add('    if ($smokeCode -ne 0) {');
  Lines.Add('        Write-Fail "smoke test failed (exit $smokeCode)"');
  Lines.Add('        exit $smokeCode');
  Lines.Add('    }');
  Lines.Add('    Write-Ok "smoke test passed."');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('exit 0');
end;

// ============================================================================
// Entry point
// ============================================================================

function GenerateFortranTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
  UnitName: TP_String;
begin
  Result := nil;
  if Model = nil then
  begin
    Log('GenerateFortranTestSetupScript: Model is nil');
    Exit;
  end;

  UnitName := Model.UnitName;
  if UnitName.Len = 0 then
  begin
    Log('GenerateFortranTestSetupScript: UnitName is empty');
    Exit;
  end;

  Lines := TPascalStringList.Create;
  try
    EmitSetupHeader(Lines);
    EmitSetupHelp(Lines);
    EmitSetupRequired(Lines);
    EmitSetupPaths(Lines);
    EmitSetupBuild(Lines);
    EmitSetupCopyDlls(Lines);
    EmitSetupSummary(Lines);
    EmitSetupRunSmoke(Lines);

    Result := Lines;
    Log(PFormat('Generated setup_fortran_tests.ps1: %d lines (unit=%s).',
      [Lines.Count, UnitName.Text]));
  finally
    if Result <> Lines then
    begin
      Lines.Free;
    end;
  end;
end;

initialization
  RegisterCodeGenEntry(
    'fortran', 'Fortran test setup script',
    asBoth, akBuildScript,
    'setup_fortran_tests.ps1', True,
    @GenerateFortranTestSetupScript);

end.
