unit http_zig_abi_test_setup_generator_tool;

{$DEFINE FPC_DELPHI_MODE}
{$I ..\..\zCore\src\Z.Define.inc}

interface

uses
  Z.Core, Z.PascalStrings, Z.UPascalStrings,
  Z.Status, Z.UnicodeMixedLib, Z.ListEngine,
  Z.Pascal_Func_Model,
  code_decl_to_json_abi_registry;

function GenerateZigTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;

const
  GenerateCode_LogEnabled: boolean = False;

implementation

const
  CH_SQ = #39;   // '
  CH_BS = #92;   // \

procedure Log(const Msg: TP_String); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[http_zig_abi_test_setup_generator] %s', [Msg.Text]);
end;

procedure Log(const Fmt: TP_String; const Args: array of const); overload;
begin
  if GenerateCode_LogEnabled then
    DoStatus('[http_zig_abi_test_setup_generator] %s', [PFormat(Fmt, Args)]);
end;

function MakeApiName(const FuncName: TP_String): TP_String;
begin
  Result := FuncName.ReplaceChar(#32#9'./\@:#?&=+-', '_');
end;

// ============================================================================
// Section 1: Header + param() + logger
// ============================================================================

procedure EmitPs1Header(Lines: TPascalStringList);
begin
  Lines.Add('# ============================================================================');
  Lines.Add('# setup_zig_tests.ps1');
  Lines.Add('# AUTO-GENERATED by http_zig_abi_test_setup_generator_tool.pas (v8).');
  Lines.Add('# Do not edit by hand: the generator re-emits this file from scratch.');
  Lines.Add('#');
  Lines.Add('# This script ONLY prepares the Zig test project directories.');
  Lines.Add('# It does NOT build, run, or test anything.');
  Lines.Add('#');
  Lines.Add('# Required:');
  Lines.Add('#   -ZigLibDir   path to the lingofuse Zig binding (must contain');
  Lines.Add('#                src\lingofuse.zig). No auto-search.');
  Lines.Add('#   -BinaryDir   path to the LingoFuse binary directory (must contain');
  Lines.Add('#                LingoFuse64.dll). No auto-search.');
  Lines.Add('#');
  Lines.Add('# Run with -Help for the full usage text.');
  Lines.Add('# ============================================================================');
  Lines.Add('');
  Lines.Add('[CmdletBinding()]');
  Lines.Add('param(');
  Lines.Add('    [string]$ZigLibDir = "",');
  Lines.Add('    [string]$BinaryDir = "",');
  Lines.Add('    [string]$GenDir = "",');
  Lines.Add('    [string]$UnitName = "",');
  Lines.Add('    [string]$ServiceProjectName = "zig_service_test",');
  Lines.Add('    [string]$CallProjectName = "zig_call_test",');
  Lines.Add('    [switch]$Force,');
  Lines.Add('    [switch]$Help');
  Lines.Add(')');
  Lines.Add('');
  Lines.Add('$ErrorActionPreference = "Stop"');
  Lines.Add('');
  Lines.Add('function Write-Info { param([string]$m) Write-Host "[info] $m" -ForegroundColor Cyan }');
  Lines.Add('function Write-Ok   { param([string]$m) Write-Host "[ ok ] $m" -ForegroundColor Green }');
  Lines.Add('function Write-Warn { param([string]$m) Write-Host "[warn] $m" -ForegroundColor Yellow }');
  Lines.Add('function Write-Fail { param([string]$m) Write-Host "[fail] $m" -ForegroundColor Red }');
  Lines.Add('');
end;

// ============================================================================
// Section 2: -Help, argument validation, source-file discovery
// ============================================================================

procedure EmitPs1ArgValidation(Lines: TPascalStringList);
begin
  Lines.Add('# --- 1. -Help ----------------------------------------------------------');
  Lines.Add('if ($Help) {');
  Lines.Add('    $help = @''');
  Lines.Add('Usage: setup_zig_tests.ps1 -ZigLibDir <path> -BinaryDir <path> [options]');
  Lines.Add('');
  Lines.Add('Prepares two Zig project directories for the generated HTTP/JSON test suite.');
  Lines.Add('It creates the directories, writes build.zig + build.zig.zon, copies the');
  Lines.Add('generated .zig sources, and copies the two required DLLs into lib/.');
  Lines.Add('It does NOT run zig build and does NOT execute any test.');
  Lines.Add('');
  Lines.Add('Required:');
  Lines.Add('  -ZigLibDir <path>');
  Lines.Add('        Path to the lingofuse Zig binding.');
  Lines.Add('        Must contain src\lingofuse.zig.');
  Lines.Add('        No auto-search: if you do not pass this, the script exits.');
  Lines.Add('');
  Lines.Add('  -BinaryDir <path>');
  Lines.Add('        Path to the LingoFuse binary directory.');
  Lines.Add('        Must contain LingoFuse64.dll (and z_ipc_64.dll).');
  Lines.Add('        No auto-search: if you do not pass this, the script exits.');
  Lines.Add('');
  Lines.Add('Optional:');
  Lines.Add('  -GenDir <path>');
  Lines.Add('        Directory that contains the four generated .zig files.');
  Lines.Add('        Default: the directory containing this script.');
  Lines.Add('');
  Lines.Add('  -UnitName <name>');
  Lines.Add('        Source unit name, without extension.');
  Lines.Add('        Default: auto-detected from <name>_http_json_service_zig.zig.');
  Lines.Add('');
  Lines.Add('  -ServiceProjectName <name>');
  Lines.Add('        Name of the service project directory. Default: zig_service_test.');
  Lines.Add('');
  Lines.Add('  -CallProjectName <name>');
  Lines.Add('        Name of the call project directory. Default: zig_call_test.');
  Lines.Add('');
  Lines.Add('  -Force');
  Lines.Add('        Overwrite existing project directories without prompting.');
  Lines.Add('        Without -Force, the script lists conflicting directories, asks');
  Lines.Add('        for confirmation, and aborts cleanly if you answer no.');
  Lines.Add('');
  Lines.Add('  -Help');
  Lines.Add('        Show this help text and exit.');
  Lines.Add('');
  Lines.Add('Example:');
  Lines.Add('  .\setup_zig_tests.ps1 `');
  Lines.Add('      -ZigLibDir D:\CoreLibrary\LingoFuse\zig `');
  Lines.Add('      -BinaryDir D:\CoreLibrary\LingoFuse\Binary');
  Lines.Add('');
  Lines.Add('Exit codes:');
  Lines.Add('  0   success (or -Help was requested)');
  Lines.Add('  1   argument validation failed, missing file, or user aborted');
  Lines.Add('''@');
  Lines.Add('    Write-Host $help');
  Lines.Add('    exit 0');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('# --- 2. Required parameters --------------------------------------------');
  Lines.Add('if (-not $ZigLibDir) {');
  Lines.Add('    Write-Fail "-ZigLibDir is required."');
  Lines.Add('    Write-Host "        Run ''setup_zig_tests.ps1 -Help'' for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('if (-not $BinaryDir) {');
  Lines.Add('    Write-Fail "-BinaryDir is required."');
  Lines.Add('    Write-Host "        Run ''setup_zig_tests.ps1 -Help'' for usage."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('# --- 3. Resolve paths --------------------------------------------------');
  Lines.Add('$ZigLibDir = (Resolve-Path -LiteralPath $ZigLibDir).Path');
  Lines.Add('$BinaryDir = (Resolve-Path -LiteralPath $BinaryDir).Path');
  Lines.Add('');
  Lines.Add('if (-not (Test-Path -LiteralPath (Join-Path $ZigLibDir "src\lingofuse.zig"))) {');
  Lines.Add('    Write-Fail "-ZigLibDir does not look like the lingofuse Zig binding."');
  Lines.Add('    Write-Fail "            Missing: $ZigLibDir\src\lingofuse.zig"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('if (-not (Test-Path -LiteralPath (Join-Path $BinaryDir "LingoFuse64.dll"))) {');
  Lines.Add('    Write-Fail "-BinaryDir does not contain LingoFuse64.dll."');
  Lines.Add('    Write-Fail "            Missing: $BinaryDir\LingoFuse64.dll"');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('if (-not $GenDir) { $GenDir = $PSScriptRoot }');
  Lines.Add('$GenDir = (Resolve-Path -LiteralPath $GenDir).Path');
  Lines.Add('');
  Lines.Add('Write-Info "ZigLibDir : $ZigLibDir"');
  Lines.Add('Write-Info "BinaryDir : $BinaryDir"');
  Lines.Add('Write-Info "GenDir    : $GenDir"');
  Lines.Add('');
  Lines.Add('# --- 4. Detect UnitName if not supplied --------------------------------');
  Lines.Add('if (-not $UnitName) {');
  Lines.Add('    $candidate = Get-ChildItem -LiteralPath $GenDir -Filter "*_http_json_service_zig.zig" -File | Select-Object -First 1');
  Lines.Add('    if ($null -eq $candidate) {');
  Lines.Add('        Write-Fail "Cannot detect UnitName (no *_http_json_service_zig.zig in $GenDir)."');
  Lines.Add('        Write-Host "        Pass -UnitName explicitly."');
  Lines.Add('        exit 1');
  Lines.Add('    }');
  Lines.Add('    $UnitName = $candidate.Name -replace ''_http_json_service_zig\.zig$'', ''''');
  Lines.Add('}');
  Lines.Add('Write-Info "UnitName  : $UnitName"');
  Lines.Add('');
  Lines.Add('# --- 5. Verify the four generated sources ------------------------------');
  Lines.Add('$serviceSrc     = Join-Path $GenDir ("$UnitName" + "_http_json_service_zig.zig")');
  Lines.Add('$serviceTestSrc = Join-Path $GenDir ("$UnitName" + "_http_json_service_main_test___.zig")');
  Lines.Add('$callSrc        = Join-Path $GenDir ("$UnitName" + "_http_json_call_zig.zig")');
  Lines.Add('$callTestSrc    = Join-Path $GenDir ("$UnitName" + "_http_json_call_main_test___.zig")');
  Lines.Add('$missing = @()');
  Lines.Add('foreach ($src in @($serviceSrc, $serviceTestSrc, $callSrc, $callTestSrc)) {');
  Lines.Add('    if (-not (Test-Path -LiteralPath $src)) { $missing += $src }');
  Lines.Add('}');
  Lines.Add('if ($missing.Count -gt 0) {');
  Lines.Add('    Write-Fail "Missing generated source files:"');
  Lines.Add('    foreach ($m in $missing) { Write-Host "        $m" }');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "All four generated sources present."');
  Lines.Add('');
  Lines.Add('# --- 6. Verify zig is on PATH ------------------------------------------');
  Lines.Add('$zigCmd = Get-Command zig -ErrorAction SilentlyContinue');
  Lines.Add('if ($null -eq $zigCmd) {');
  Lines.Add('    Write-Fail "zig is not on PATH."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('$zigVersion = (& zig version) 2>&1');
  Lines.Add('Write-Info "zig version: $zigVersion"');
  Lines.Add('');
end;

// ============================================================================
// Section 3: Helper functions (path, file writing, build.zig, build.zig.zon)
// ============================================================================

procedure EmitPs1Helpers(Lines: TPascalStringList);
begin
  Lines.Add('# --- 7. Helpers --------------------------------------------------------');
  Lines.Add('');
  Lines.Add('function Get-RelativePath {');
  Lines.Add('    param([string]$FromDir, [string]$ToPath)');
  Lines.Add('    $fromUri = New-Object System.Uri(($FromDir.TrimEnd(' + CH_SQ + CH_BS + CH_SQ + ') + ' + CH_SQ + CH_BS + CH_SQ + '))');
  Lines.Add('    $toUri   = New-Object System.Uri($ToPath)');
  Lines.Add('    $rel = $fromUri.MakeRelativeUri($toUri).ToString()');
  Lines.Add('    return [System.Uri]::UnescapeDataString($rel).Replace(' + CH_SQ + '/' + CH_SQ + ', ' + CH_SQ + CH_BS + CH_SQ + ')');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('function Write-TextFileLF {');
  Lines.Add('    param([string]$Path, [string]$Text)');
  Lines.Add('    $n = $Text -replace "`r`n", "`n"');
  Lines.Add('    $n = $n -replace "`r", "`n"');
  Lines.Add('    $enc = New-Object System.Text.UTF8Encoding($false)');
  Lines.Add('    [System.IO.File]::WriteAllText($Path, $n, $enc)');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('function Normalize-ZigFile {');
  Lines.Add('    param([string]$Path)');
  Lines.Add('    if (-not (Test-Path -LiteralPath $Path)) { return }');
  Lines.Add('    $enc = New-Object System.Text.UTF8Encoding($false)');
  Lines.Add('    $c = [System.IO.File]::ReadAllText($Path, [System.Text.Encoding]::UTF8)');
  Lines.Add('    $c = $c -replace "`r`n", "`n"');
  Lines.Add('    $c = $c -replace "`r", "`n"');
  Lines.Add('    [System.IO.File]::WriteAllText($Path, $c, $enc)');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('function Normalize-ZigFileInDir {');
  Lines.Add('    param([string]$Dir)');
  Lines.Add('    Get-ChildItem -LiteralPath $Dir -Filter "*.zig" -File -Recurse | ForEach-Object { Normalize-ZigFile -Path $_.FullName }');
  Lines.Add('}');
  Lines.Add('');

  // ---- Write-BuildZig ----------------------------------------------------
  Lines.Add('function Write-BuildZig {');
  Lines.Add('    param([string]$ProjectDir, [string]$ExeName)');
  Lines.Add('');
  Lines.Add('    $lines = @()');
  Lines.Add('    $lines += ' + CH_SQ + 'const std = @import("std");' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + 'pub fn build(b: *std.Build) void {' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    const target = b.standardTargetOptions(.{});' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    const optimize = b.standardOptimizeOption(.{});' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    const lf_dep = b.dependency("lingofuse", .{ .target = target, .optimize = optimize });' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    const exe_mod = b.createModule(.{ .root_source_file = b.path("src/main.zig"), .target = target, .optimize = optimize });' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    exe_mod.addImport("lingofuse", lf_dep.module("lingofuse"));' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    exe_mod.link_libc = true;' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    const exe = b.addExecutable(.{ .name = "' + CH_SQ + ' + $ExeName + ' + CH_SQ + '", .root_module = exe_mod });' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    b.installArtifact(exe);' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    b.getInstallStep().dependOn(&b.addInstallBinFile(b.path("lib/LingoFuse64.dll"), "LingoFuse64.dll").step);' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    b.getInstallStep().dependOn(&b.addInstallBinFile(b.path("lib/z_ipc_64.dll"), "z_ipc_64.dll").step);' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    const run = b.addRunArtifact(exe);' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    run.stdio = .inherit;' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    run.step.dependOn(b.getInstallStep());' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    const run_step = b.step("run", "Run the program");' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '    run_step.dependOn(&run.step);' + CH_SQ);
  Lines.Add('    $lines += ' + CH_SQ + '}' + CH_SQ);
  Lines.Add('');
  Lines.Add('    $text = ($lines -join "`n") + "`n"');
  Lines.Add('    Write-TextFileLF -Path (Join-Path $ProjectDir "build.zig") -Text $text');
  Lines.Add('}');
  Lines.Add('');

  // ---- Patch-BuildZon ----------------------------------------------------
  Lines.Add('function Patch-BuildZon {');
  Lines.Add('    param([string]$ProjectDir, [string]$RelCratePath)');
  Lines.Add('    $zon = Join-Path $ProjectDir "build.zig.zon"');
  Lines.Add('    $c = Get-Content -LiteralPath $zon -Raw');
  Lines.Add('    $escaped = $RelCratePath.Replace(' + CH_SQ + CH_BS + CH_SQ + ', ' + CH_SQ + CH_BS + CH_BS + CH_SQ + ').Replace(' + CH_SQ + #34 + CH_SQ + ', ' + CH_SQ + CH_BS + #34 + CH_SQ + ')');
  Lines.Add('    $dep = ".lingofuse = .{ .path = """ + $escaped + """ },"');
  Lines.Add('    if ($c -match ' + CH_SQ + '\.dependencies\s*=\s*\.\{\s*\}' + CH_SQ + ') {');
  Lines.Add('        $c = $c -replace ' + CH_SQ + '\.dependencies\s*=\s*\.\{\s*\}' + CH_SQ + ', (".dependencies = .{ " + $dep + " }")');
  Lines.Add('    } elseif ($c -match ' + CH_SQ + '\.dependencies\s*=\s*\.\{' + CH_SQ + ') {');
  Lines.Add('        $replacement = ' + CH_SQ + '$1 ' + CH_SQ + ' + $dep + ' + CH_SQ + ' ' + CH_SQ);
  Lines.Add('        $c = $c -replace ' + CH_SQ + '(\.dependencies\s*=\s*\.\{)' + CH_SQ + ', $replacement');
  Lines.Add('    } else {');
  Lines.Add('        $idx = $c.LastIndexOf(' + CH_SQ + '}' + CH_SQ + ')');
  Lines.Add('        if ($idx -lt 0) { throw "Patch-BuildZon: no closing brace in $zon" }');
  Lines.Add('        $ins = ".dependencies = .{ " + $dep + " }," + [Environment]::NewLine + "    "');
  Lines.Add('        $c = $c.Substring(0, $idx) + $ins + $c.Substring($idx)');
  Lines.Add('    }');
  Lines.Add('    Write-TextFileLF -Path $zon -Text $c');
  Lines.Add('}');
  Lines.Add('');

  // ---- New-TestProject ---------------------------------------------------
  Lines.Add('function New-TestProject {');
  Lines.Add('    param(');
  Lines.Add('        [string]$ProjectDir,');
  Lines.Add('        [string]$ExeName,');
  Lines.Add('        [string]$SrcMain,');
  Lines.Add('        [string]$SupportSrc,');
  Lines.Add('        [switch]$Force');
  Lines.Add('    )');
  Lines.Add('');
  Lines.Add('    Write-Info "Creating $ExeName in $ProjectDir"');
  Lines.Add('');
  Lines.Add('    if (Test-Path -LiteralPath $ProjectDir) {');
  Lines.Add('        if (-not $Force) {');
  Lines.Add('            Write-Warn "  Existing directory: $ProjectDir"');
  Lines.Add('            Write-Warn "  Re-run with -Force to overwrite."');
  Lines.Add('            return $false');
  Lines.Add('        }');
  Lines.Add('        Remove-Item -LiteralPath $ProjectDir -Recurse -Force');
  Lines.Add('    }');
  Lines.Add('');
  Lines.Add('    New-Item -ItemType Directory -Force -Path $ProjectDir | Out-Null');
  Lines.Add('    New-Item -ItemType Directory -Force -Path (Join-Path $ProjectDir "lib") | Out-Null');
  Lines.Add('');
  Lines.Add('    Push-Location $ProjectDir');
  Lines.Add('    try {');
  Lines.Add('        & zig init 2>&1 | Out-Null');
  Lines.Add('        if ($LASTEXITCODE -ne 0) {');
  Lines.Add('            Write-Fail "  zig init failed in $ProjectDir"');
  Lines.Add('            return $false');
  Lines.Add('        }');
  Lines.Add('    } finally { Pop-Location }');
  Lines.Add('');
  Lines.Add('    $rel = Get-RelativePath -FromDir $ProjectDir -ToPath $ZigLibDir');
  Lines.Add('    Write-Info "  lingofuse path: $rel"');
  Lines.Add('    Patch-BuildZon -ProjectDir $ProjectDir -RelCratePath $rel');
  Lines.Add('');
  Lines.Add('    Write-BuildZig -ProjectDir $ProjectDir -ExeName $ExeName');
  Lines.Add('');
  Lines.Add('    Copy-Item -LiteralPath $SrcMain -Destination (Join-Path $ProjectDir "src/main.zig") -Force');
  Lines.Add('    if ($SupportSrc) {');
  Lines.Add('        Copy-Item -LiteralPath $SupportSrc -Destination (Join-Path $ProjectDir "src/") -Force');
  Lines.Add('    }');
  Lines.Add('');
  Lines.Add('    $rootZig = Join-Path $ProjectDir "src/root.zig"');
  Lines.Add('    if (Test-Path -LiteralPath $rootZig) { Remove-Item -LiteralPath $rootZig -Force }');
  Lines.Add('');
  Lines.Add('    Normalize-ZigFileInDir -Dir (Join-Path $ProjectDir "src")');
  Lines.Add('');
  Lines.Add('    foreach ($dll in @("LingoFuse64.dll", "z_ipc_64.dll")) {');
  Lines.Add('        $s = Join-Path $BinaryDir $dll');
  Lines.Add('        if (Test-Path -LiteralPath $s) {');
  Lines.Add('            Copy-Item -LiteralPath $s -Destination (Join-Path $ProjectDir "lib/") -Force');
  Lines.Add('        } else {');
  Lines.Add('            Write-Warn "  Missing DLL: $s"');
  Lines.Add('        }');
  Lines.Add('    }');
  Lines.Add('');
  Lines.Add('    return $true');
  Lines.Add('}');
  Lines.Add('');
end;

// ============================================================================
// Section 4: Create the two projects
// ============================================================================

procedure EmitPs1CreateProjects(Lines: TPascalStringList);
begin
  Lines.Add('# --- 8. Create the two projects ----------------------------------------');
  Lines.Add('');
  Lines.Add('$stDir = Join-Path $GenDir $ServiceProjectName');
  Lines.Add('$ctDir = Join-Path $GenDir $CallProjectName');
  Lines.Add('');
  Lines.Add('$existing = @()');
  Lines.Add('if (Test-Path -LiteralPath $stDir) { $existing += $stDir }');
  Lines.Add('if (Test-Path -LiteralPath $ctDir) { $existing += $ctDir }');
  Lines.Add('if (($existing.Count -gt 0) -and (-not $Force)) {');
  Lines.Add('    Write-Warn "The following project directories already exist:"');
  Lines.Add('    foreach ($p in $existing) { Write-Host "        $p" }');
  Lines.Add('    $answer = Read-Host "Overwrite them? (y/N)"');
  Lines.Add('    if ($answer -ne ''y'' -and $answer -ne ''Y'') {');
  Lines.Add('        Write-Info "Aborted."');
  Lines.Add('        exit 0');
  Lines.Add('    }');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('$ok = $true');
  Lines.Add('$ok = (New-TestProject -ProjectDir $stDir -ExeName "service_test" -SrcMain $serviceTestSrc -SupportSrc $serviceSrc -Force:$Force) -and $ok');
  Lines.Add('$ok = (New-TestProject -ProjectDir $ctDir -ExeName "call_test" -SrcMain $callTestSrc -SupportSrc $callSrc -Force:$Force) -and $ok');
  Lines.Add('if (-not $ok) {');
  Lines.Add('    Write-Fail "Project creation failed."');
  Lines.Add('    exit 1');
  Lines.Add('}');
  Lines.Add('Write-Ok "Two projects created."');
  Lines.Add('');
end;

// ============================================================================
// Section 5: Next-steps output
// ============================================================================

procedure EmitPs1NextSteps(Lines: TPascalStringList;
  const UnitName, ServiceProjectName, CallProjectName: TP_String);
begin
  Lines.Add('# --- 9. Print instructions ---------------------------------------------');
  Lines.Add('$endpoint = "ipc:' + UnitName.Text + '_http_json"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host "  Environment ready. Nothing has been built or run." -ForegroundColor Green');
  Lines.Add('Write-Host "================================================================" -ForegroundColor Green');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Two projects prepared under ${GenDir}:"');
  Lines.Add('Write-Host "  ' + ServiceProjectName.Text + '  - starts the service and stays online"');
  Lines.Add('Write-Host "  ' + CallProjectName.Text + '     - drives every API (sync + async)"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Make sure bridge.py is already running on endpoint ${endpoint}." -ForegroundColor Yellow');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Then run three terminals:" -ForegroundColor Cyan');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  [T1] Service (keep running):" -ForegroundColor Cyan');
  Lines.Add('Write-Host "         cd $(Join-Path $GenDir ''' + ServiceProjectName.Text + ''')"');
  Lines.Add('Write-Host "         zig build run"');
  Lines.Add('Write-Host "         # Expect: [service] Online on endpoint ${endpoint}"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  [T2] Bridge:" -ForegroundColor Cyan');
  Lines.Add('Write-Host "         python bridge.py --endpoint ${endpoint} --port 8081"');
  Lines.Add('Write-Host "         # Expect: APP __lf_http_bridge__ ... Ready OK"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "  [T3] Call test:" -ForegroundColor Cyan');
  Lines.Add('Write-Host "         cd $(Join-Path $GenDir ''' + CallProjectName.Text + ''')"');
  Lines.Add('Write-Host "         zig build run"');
  Lines.Add('Write-Host "         # Expect: [diag] bridge reachable: __lf_http_bridge__.__lf_outbound_post__"');
  Lines.Add('Write-Host "         #         Results: N passed, 0 failed"');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "Shutdown: press Enter in T3, Ctrl+C in T2, Enter in T1."');
  Lines.Add('Write-Host ""');
  Lines.Add('Write-Host "First run: if zig build reports a fingerprint mismatch, replace"');
  Lines.Add('Write-Host "the .fingerprint value in build.zig.zon with the one zig printed,"');
  Lines.Add('Write-Host "and re-run zig build."');
  Lines.Add('Write-Host ""');
end;

// ============================================================================
// Entry point
// ============================================================================

function GenerateZigTestSetupScript(Model: TPascal_Func_Model): TPascalStringList;
var
  Lines: TPascalStringList;
  UnitName, NormalizedUnit: TP_String;
begin
  Result := nil;
  if Model = nil then begin Log('Model is nil'); Exit end;
  UnitName := Model.UnitName;
  if UnitName.Len = 0 then begin Log('UnitName is empty'); Exit end;
  NormalizedUnit := MakeApiName(UnitName);
  if (NormalizedUnit.Len > 0) and (NormalizedUnit[1] >= '0') and (NormalizedUnit[1] <= '9') then
    NormalizedUnit := '_' + NormalizedUnit;

  Lines := TPascalStringList.Create;
  try
    EmitPs1Header(Lines);
    EmitPs1ArgValidation(Lines);
    EmitPs1Helpers(Lines);
    EmitPs1CreateProjects(Lines);
    EmitPs1NextSteps(Lines, NormalizedUnit, 'zig_service_test', 'zig_call_test');

    Result := Lines;
    Log(PFormat('Generated %d lines for setup_zig_tests.ps1 (endpoint=ipc:%s_http_json).',
      [Lines.Count, NormalizedUnit.Text]));
  finally
    if Result <> Lines then Lines.Free;
  end;
end;

initialization
  RegisterCodeGenEntry(
    'zig', 'Zig test setup script',
    asBoth, akBuildScript,
    'setup_zig_tests.ps1', True,
    @GenerateZigTestSetupScript);

end.
