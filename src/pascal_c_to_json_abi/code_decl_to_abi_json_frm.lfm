      object WelcomeTextMemo: TMemo
        Left = 0
        Height = 345
        Top = 25
        Width = 992
        Align = alClient
        Lines.Strings = (
          '================================================================================'
          '  code_decl_to_json_abi — Cross-Language HTTP/JSON Interface Code Generator'
          '================================================================================'
          ''
          'WHAT THIS IS'
          ''
          '  Feed in one Pascal unit (.pas / .pp / .p) or one C header (.h / .hpp / .c /'
          '  .cpp / ...). The tool translates every top-level routine into a complete'
          '  HTTP POST + JSON interface suite: service side, call side, test drivers,'
          '  and build scripts. Languages without FFI support — webjs, PHP, nodejs, and'
          '  others — can then call Pascal / Python / C++ / C# / Rust / Go / Java / ...'
          '  backends directly over HTTP.'
          ''
          'THE 4-LAYER TRANSPARENT CONVERSION MODEL'
          ''
          '  Layer 0  Original source (Pascal / C)'
          '             \_ unified through the "code modifier" model into:'
          '  Layer 1  Pascal / C declaration body (standard syntax, plain text)'
          '             <-> bi-directional conversion'
          '  Layer 2  Low-level structure LV0  ── parsed by Z.Pascal_Func_Tool / Fill_C'
          '             \_ exportable as LV0 JSON; edit externally to fix parse errors'
          '             |'
          '  Layer 3  Intermediate structure LV1  ── built by TPascal_Func_Model'
          '             \_ normalized with tnf_ABI'
          '             \_ exportable as LV1 JSON; edit externally to adjust parameter'
          '                descriptions and type mappings'
          '             |'
          '  Layer 4  Multi-target HTTP/JSON generators (20+ independent units)'
          '             \_ "model once, emit many"'
          ''
          'WORKFLOW'
          ''
          '  1. Paste your declarations into the "Source Code" editor'
          '     (Pascal or C syntax).'
          '  2. Pick the source language in the top dropdown, or click the label to'
          '     auto-detect.'
          '  3. Click "Parse -> JSON" to produce the LV0 low-level structure.'
          '  4. Click "Next" to produce the LV1 intermediate structure.'
          '  5. Click "Generate source" to emit the full artifact set:'
          '        Pascal   service / call / test'
          '        Python   service / call / test'
          '        C++      service (.hpp + .cpp) / call (.hpp + .cpp)'
          '        C#       service / call / test'
          '        JS       browser call (.js + self-contained test .html)'
          '        Node.js / TypeScript / PHP / Rust / Go / Java / Delphi /'
          '        Dart / Swift / Ruby / Zig / Erlang / Fortran / Julia / R'
          '                 service / call / test (per language coverage)'
          '        CMakeLists.txt + test_main___.cpp   (C++ build)'
          '        launch_bridge.ps1                   (bridge launcher)'
          '        setup_*_tests.ps1                   (per-language test setup)'
          '  6. Every artifact is written to <exe dir>/<UnitName>/ and also listed in'
          '     the "Final Source" panel.'
          ''
          'SUPPORT MATRIX'
          ''
          '  Source languages   Pascal, C (only these two)'
          '  Target languages   Pascal, C++, C#, Python, JavaScript (browser), Node.js,'
          '                     TypeScript, PHP, Rust, Go, Java, Delphi, Dart, Swift,'
          '                     Ruby, Zig, Erlang, Fortran, Julia, R'
          '  Artifact count     Depends on the language set and the number of supported'
          '                     routines in the model; always trust the Generate response'
          '                     or the "Final Source" list.'
          ''
          'WHERE TO READ THE INTERFACE CONTRACT'
          ''
          '  The *_readme.md artifacts have been removed in this version. Read the'
          '  contract from these live sources instead:'
          ''
          '    API name            The registration table in the service code'
          '                        (LF_RegisterCallEx / registerCall)'
          '    Param / return      The internal_call_<Api> stub signature'
          '    Call example        The per-language *_main_test___.* test driver'
          '    Build command       CMakeLists.txt / setup_*_tests.ps1 / language docs'
          '    Base URL / timeout  The constant declarations at the top of the call code'
          '    Env / dependencies  The comment block at the top of each generated file'
          '    Wire protocol       { "args": [...] } request; { "code":0,"result":... }'
          '                        response'
          ''
          'WIRE PROTOCOL'
          ''
          '  HTTP request    POST http://<bridge-host>:<port>/<app>/<api>'
          '                  Content-Type: application/json; charset=utf-8'
          '  HTTP body       {"args": [v1, v2, ...]}          positional (recommended)'
          '                  {"a": v1, "b": v2, ...}          named (hand-written clients)'
          '  HTTP response   {"code":  0, "result": ...}      success'
          '                  {"code": -1, "error":  ...}      service exception / network'
          '                  {"code": -2, "error":  ...}      bad request shape (HTTP 400)'
          '                  {"code": -3, "error":  ...}      bridge precheck cache miss'
          ''
          'THE MOST IMPORTANT RUNTIME RULE'
          ''
          '  bridge.py / bridge.exe is a forwarder and must always be running.'
          ''
          '  Every generated call side (all 20+ languages) and every HTML test page'
          '  reaches its service through it:'
          ''
          '      call side  --HTTP or LF_Call-->  bridge.py  --LF_Call-->  service'
          ''
          '  Typical three-process layout:'
          ''
          '      Terminal 1 (service)   start the generated service'
          '      Terminal 2 (bridge)    python3 bridge.py --endpoint ipc:<Unit>_http_json \'
          '                                              --port 8081 --no-precheck'
          '      Terminal 3 (caller)    run your integration code or test driver'
          ''
          '  Note: the service side itself does NOT go through the bridge. It is the'
          '  upstream of the bridge, not the downstream.'
          ''
          'THE MOST IMPORTANT GENERATION RULE'
          ''
          '  Any type outside the three ABI families causes the whole routine to be'
          '  silently dropped.'
          ''
          '  String   string / AnsiString / PChar / TP_String / ...'
          '  Float    Double / Single / Extended / Real'
          '  Integer  Integer / Int64 / Cardinal / Word / Byte / ...'
          ''
          '  Boolean, Variant, arrays, records, classes, interfaces, enums, sets,'
          '  pointers, TDateTime, function pointers — none of these are supported.'
          '  Rewrite them as integers (0 / 1), JSON-encoded strings, or the matching'
          '  base type.'
          ''
          '  Also note: int64 / uint64 lose precision on the JavaScript client'
          '  (JS Number is an IEEE-754 double). Return strings if the value may'
          '  exceed 2^53.'
          ''
          'PROGRAMMATIC INTERFACE (EMBEDDING)'
          ''
          '  Generate*Code(Model: TPascal_Func_Model): TPascalStringList'
          ''
          '  Model must have Typ_Normalize_Func = tnf_ABI.'
          '  The returned list is owned by the caller and must be freed with'
          '  DisposeObject. It is nil for an empty model.'
          ''
          'THE THREE MCP TOOLS (FOR AI AGENTS)'
          ''
          '  CodeDeclToJsonAbi_Generate(Source, Language)   parse + generate everything'
          '  CodeDeclToJsonAbi_ListFiles()                  list produced file names'
          '  CodeDeclToJsonAbi_GetFile(FileName)            return one file''s full text'
          ''
          '  Language accepts ONLY "pascal" or "c" — those are SOURCE languages, not'
          '  target languages. One Generate call produces every target at once.'
          '  ListFiles and GetFile are pure readers.'
          ''
          'UI AT A GLANCE'
          ''
          '  "Source Code"         Left panel: paste Pascal / C source'
          '  "Language selector"   Top bar: pick manually or click to auto-detect'
          '  "Empty unit"          Insert a minimal skeleton'
          '  "Test unit"           Insert a complex sample covering many syntax forms'
          '  "Format"              Keep only top-level declarations, rebuild minimal code'
          '  "Parse -> JSON"       Produce the LV0 JSON'
          '  "JSON <-> Model"      Normalize to LV1 Model JSON'
          '  "Generate source"     Emit every artifact'
          '  "Final source"        Browse the files already written to disk'
          ''
          'QUICK START'
          ''
          '  1. Paste your declarations into "Source Code".'
          '  2. Click "Language selector" to auto-detect the language.'
          '  3. Click "Test unit" to peek at a syntax sample the parser accepts'
          '     (optional).'
          '  4. Click "Parse -> JSON" -> "Next" -> "Generate source".'
          '  5. Inspect the artifacts in "Final source", or go to'
          '     <exe dir>/<UnitName>/ and grab the files directly.'
          '  6. Build and run per the language integration guides.'
          ''
          'FUTURE EXTENSIONS'
          ''
          '  - Add a new source language by implementing one "code modifier" that'
          '    translates its declarations into a Pascal declaration body; every'
          '    downstream step is reused unchanged.'
          '  - Add a new target language by implementing the corresponding'
          '    service / call / test generators and registering them with'
          '    RegisterCodeGenEntry.'
          '  - The LV0 / LV1 JSON structures are stable and backward compatible,'
          '    so they work well as offline caches and for batch pipelines.'
          ''
          'WHEN YOU GET STUCK'
          ''
          '  - Build & deployment:  BUILD_GUIDE / User Guide chapter 14'
          '  - Running tests:       HOW_TO_RUN_TESTS'
          '  - Service integration: SERVICE_LIBRARY_INTEGRATION_GUIDE'
          '  - Call integration:    CALL_LIBRARY_INTEGRATION_GUIDE'
          '  - Source syntax:       pascal_code_json_abi_rule.md /'
          '                         C_code_json_abi_rule.md'
          '  - Deep architecture:   code_decl_to_json_abi_knowledge_base.md'
          ''
          'If anything is still unclear, consult the project documentation or contact'
          'the development team.'
          ''
          'Enjoy!'
        )
        ScrollBars = ssAutoVertical
        TabOrder = 1
        WordWrap = False
      end
    end
